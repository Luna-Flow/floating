///|
/// One row of `reverse_table_wbtest.mbt` (generated by `tools/interval_reverse_oracle.py`): the
/// operands of `pow_rev1` or `pow_rev2` at a point base and a point result, and the two ends the
/// oracle computed with Python `decimal`.
priv struct ReverseRow {
  kind : String
  precision : Int32
  first : @binary.Binary
  second : @binary.Binary
  lo : @binary.Binary
  hi : @binary.Binary
}

///|
fn reverse_rows() -> Array[(String, ReverseRow)] {
  let rows : Array[(String, ReverseRow)] = []
  for line in reverse_table().split("\n") {
    let line = line.to_owned()
    if line == "" {
      continue
    }
    let fields = line.split("\t").map(fn(f) { f.to_owned() }).collect()
    let mut precision = 0
    for c in fields[2] {
      precision = precision * 10 + (c.to_int() - '0'.to_int())
    }
    let read = fn(text : String) {
      @binary.Binary::from_hex(text, precision).unwrap()
    }
    rows.push(
      (
        fields[0],
        {
          kind: fields[1],
          precision,
          first: read(fields[3]),
          second: read(fields[4]),
          lo: read(fields[5]),
          hi: read(fields[6]),
        },
      ),
    )
  }
  rows
}

///|
/// The row of the table with this name.
fn reverse_row(name : String) -> ReverseRow {
  for entry in reverse_rows() {
    if entry.0 == name {
      return entry.1
    }
  }
  abort("no row named " + name)
}

///|
/// The result of the operation of the row on its operands (no prior).
fn ReverseRow::run(self : ReverseRow) -> Interval {
  let first = Interval::from_bounds(
    self.first,
    self.first,
    precision=self.precision,
  )
  let second = Interval::from_bounds(
    self.second,
    self.second,
    precision=self.precision,
  )
  if self.kind == "p1" {
    first.pow_rev1(second)
  } else {
    first.pow_rev2(second)
  }
}

///|
// oracle: A
// source: every row of reverse_table_wbtest.mbt, computed with the Python decimal module at 400 and 450 digits by tools/interval_reverse_oracle.py from the definitions of Table 10.1 (c^(1/beta) and ln c / ln a), rounded outward to p bits on the grid of the format; the rows cover the top binade, the subnormal range, a rational below the normal range, a base one unit from 1, bases 2^1e9 and 2^-1e9, the largest and the smallest stored values, and 501 bits
// shares: Binary::from_hex and Interval::from_bounds read the rows and build the operands; Binary::to_string (the printer) renders the ends for the comparison of the text
test "pow_rev1 and pow_rev2 at a point base and a point result equal the independent table, on every row" {
  let mut count = 0
  for entry in reverse_rows() {
    let (name, row) = entry
    let r = row.run()
    assert_true(!r.is_empty(), msg=name)
    assert_eq(r.lo_.to_string(), row.lo.to_string(), msg=name)
    assert_eq(r.hi_.to_string(), row.hi.to_string(), msg=name)
    count += 1
  }
  assert_eq(count, 22)
}
