// `Interval::exp` of a narrow interval at the overflow threshold of `exp` (#569).
// Oracle, level A: the endpoints are the two 300-bit floats around
// T = 2^30 ln 2 generated by Python's `decimal` (see
// `bin_float/exp_overflow_edge_wbtest.mbt`); exp of the lower end is
// 2^(e_max + 1) (1 - eta) and its rounding down at 300 bits is
// (2^300 - 783442263) 2^(e_max + 1 - 300) (the distance of the end from T is
// 0.7296... * 2^-270, so c = ceil(2^30 * 0.7296...) = 783442263); exp of the upper
// end is above 2^(e_max + 1), so the upper end of the result is +inf.

///|
test "exp of an interval across the overflow threshold keeps the lower end" {
  let below = @bin_float.BinFloat::make(
    @bin_float.BinCoeff::parse(
      "1411965743695424507508857192728570223734551239724995589061361292466257174357546532574725854",
    ).unwrap(),
    -270,
    300,
  )
  let above = @bin_float.BinFloat::make(
    @bin_float.BinCoeff::parse(
      "1411965743695424507508857192728570223734551239724995589061361292466257174357546532574725855",
    ).unwrap(),
    -270,
    300,
  )
  let interval = Interval::from_bounds(below, above, precision=300)
  // (2^300 - 783442263) = 2037035976334486086268445688409378161051468393665936250636140449354381299763336705399955113
  let expected_lower = @bin_float.BinFloat::make(
    @bin_float.BinCoeff::parse(
      "2037035976334486086268445688409378161051468393665936250636140449354381299763336705399955113",
    ).unwrap(),
    1073741824 - 300,
    300,
  )
  let result = interval.exp()
  assert_true(result.lower_bound().identical(expected_lower))
  assert_true(is_pos_inf(result.upper_bound()))
  match interval.try_exp() {
    Ok(checked) => {
      assert_true(checked.lower_bound().identical(expected_lower))
      assert_true(is_pos_inf(checked.upper_bound()))
    }
    Err(_) => assert_true(false)
  }
  // the point forms: the lower end finite and tight, the upper end past it
  let point_below = Interval::exact(below).exp()
  assert_true(point_below.lower_bound().identical(expected_lower))
  let point_above = Interval::exact(above).exp()
  assert_true(is_pos_inf(point_above.upper_bound()))
  assert_true(point_above.lower_bound().compare(expected_lower) >= 0)
}
