// The forward functions asin, acos, atan, atan2, tan and pow at 200 bits against MPFR
// (`forward_reference_table_wbtest.mbt`, generated by `tools/interval_forward_oracle.py`).
// These are the primitives that the reference tests of the reverse functions use at 200 bits.

///|
priv struct FwdRow {
  op : String
  x : @binary.Binary
  y : @binary.Binary?
  lo : @binary.Binary
  hi : @binary.Binary
}

///|
fn fwd_hex(text : String) -> @binary.Binary {
  @binary.Binary::from_hex(text, 2200).unwrap()
}

///|
fn fwd_rows() -> Array[FwdRow] {
  let rows : Array[FwdRow] = []
  for line in forward_reference_table().split("\n") {
    let line = line.to_owned()
    if line == "" {
      continue
    }
    let f = line.split(" ").map(fn(s) { s.to_owned() }).collect()
    rows.push({
      op: f[0],
      x: fwd_hex(f[1]),
      y: if f[2] == "-" {
        None
      } else {
        Some(fwd_hex(f[2]))
      },
      lo: fwd_hex(f[3]),
      hi: fwd_hex(f[4]),
    })
  }
  rows
}

///|
/// The row of the table for `op` at `x` (and `y`): its enclosure at 200 bits.
fn fwd_find(op : String, x : @binary.Binary, y? : @binary.Binary) -> FwdRow {
  for row in fwd_rows() {
    let same_y = match (row.y, y) {
      (None, None) => true
      (Some(a), Some(b)) => a.compare(b) == 0
      _ => false
    }
    if row.op == op && row.x.compare(x) == 0 && same_y {
      return row
    }
  }
  abort("no row of the forward table for " + op + " at " + x.to_string())
}

///|
// oracle: A
// source: the two directed roundings of the exact result to 200 bits computed by MPFR (tools/interval_forward_oracle.py); tightness: the interval of an exact operand must equal them
// shares: nothing (Binary::from_hex reads the table)
test "asin, acos, atan, atan2, tan and pow of an exact operand are the MPFR enclosure at 200 bits" {
  let mut count = 0
  for row in fwd_rows() {
    let x = Interval::exact(row.x, precision=200)
    let got = match row.op {
      "asin" => Some(x.asin())
      "acos" => Some(x.acos())
      "atan" => Some(x.atan())
      "tan" => Some(x.tan())
      "pow" => Some(x.pow(Interval::exact(row.y.unwrap(), precision=200)))
      "atan2" => Some(x.atan2(Interval::exact(row.y.unwrap(), precision=200)))
      _ => None
    }
    match got {
      Some(g) => {
        assert_true(
          g.lo_.compare(row.lo) == 0,
          msg=row.op + " lower " + row.x.to_string(),
        )
        assert_true(
          g.hi_.compare(row.hi) == 0,
          msg=row.op + " upper " + row.x.to_string(),
        )
        count += 1
      }
      None => ()
    }
  }
  assert_true(count > 300)
}
