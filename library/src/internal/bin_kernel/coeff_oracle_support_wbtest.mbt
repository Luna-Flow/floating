///|
/// Support for the tables generated by `tools/kernel_oracle.py` (the oracle of
/// the kernel tests: CPython integers, no library of this repository).
///
/// A table is a multi-line string, one row per line, fields separated by one
/// space. The operands of a row are regenerated from its seed with
/// `regression_value` (`coeff_regression_wbtest.mbt`), the generator that
/// `tools/kernel_oracle.py` writes out in Python.

///|
fn oracle_fields(line : String) -> Array[String] {
  let fields : Array[String] = []
  let mut start = 0
  let mut index = 0
  let length = line.length()
  while index < length {
    if line[index] == ' ' {
      fields.push(line[start:index].to_owned())
      start = index + 1
    }
    index += 1
  }
  fields.push(line[start:length].to_owned())
  fields
}

///|
fn oracle_u64(text : String) -> UInt64 {
  let mut result = 0UL
  for char in text {
    result = result * 10UL + (char.to_int() - 48).to_uint64()
  }
  result
}

///|
fn oracle_int(text : String) -> Int32 {
  oracle_u64(text).to_int()
}

///|
/// The rows of a table (the lines of the string), as arrays of fields.
fn oracle_rows(table : String) -> Array[Array[String]] {
  let rows : Array[Array[String]] = []
  let mut start = 0
  let length = table.length()
  let mut index = 0
  while index <= length {
    if index == length || table[index] == '\n' {
      if index > start {
        rows.push(oracle_fields(table[start:index].to_owned()))
      }
      start = index + 1
    }
    index += 1
  }
  rows
}

///|
/// `regression_value` operands of one row: `limbs` limbs of 64 bits, drawn
/// from the generator seeded with `seed`.
fn oracle_value(
  random : RegressionRandom,
  limbs : Int32,
  shape : Int32,
) -> Coeff {
  regression_value(random, 64 * limbs, shape)
}

///|
/// Digest of one integer, as `kernel_oracle.mix(FNV_BASIS, number)`.
fn oracle_digest(value : Coeff) -> UInt64 {
  regression_mix(0xcbf29ce484222325UL, value)
}

///|
/// Moduli of the residue form of a row (`tools/kernel_oracle.py`, `MODULI`):
/// 2^64 - 1, 2^61 - 1 and the primes 2147483587 and 2147483629.
fn oracle_residues(value : Coeff) -> Array[UInt64] {
  let count = bin_coeff_word_len(value)
  let modulus61 = 0x1fff_ffff_ffff_ffffUL
  let mut sum = 0UL
  let mut horner61 = 0UL
  let mut first = 0UL
  let mut second = 0UL
  for step in 0..<count {
    let limb = bin_coeff_word(value, count - 1 - step)
    // 2^64 - 1: the sum of the limbs with the carry folded back
    let next = sum + limb
    sum = if next < limb { next + 1UL } else { next }
    // 2^61 - 1: Horner in base 2^64 = 8
    let scaled = horner61 << 3
    let scaled = (scaled & modulus61) + (scaled >> 61)
    let folded = (limb & modulus61) + (limb >> 61)
    let total = scaled + folded
    horner61 = (total & modulus61) + (total >> 61)
    // the primes: Horner in 32-bit pieces (the accumulator stays below 2^31)
    let high = limb >> 32
    let low = limb & 0xffff_ffffUL
    first = ((first << 32) | high) % 2147483587UL
    first = ((first << 32) | low) % 2147483587UL
    second = ((second << 32) | high) % 2147483629UL
    second = ((second << 32) | low) % 2147483629UL
  }
  [
    if sum == 0xffff_ffff_ffff_ffffUL {
      0UL
    } else {
      sum
    },
    if horner61 >= modulus61 {
      horner61 - modulus61
    } else {
      horner61
    },
    first,
    second,
  ]
}

///|
/// A decimal integer with an optional leading minus sign.
fn oracle_signed(text : String) -> Int32 {
  if text.length() > 0 && text[0] == '-' {
    -oracle_int(text[1:].to_owned())
  } else {
    oracle_int(text)
  }
}
