///|
/// The enclosure of `op(value)` from `enclosure_rows()` (MPFR roundings toward negative and toward
/// positive infinity at `bits` bits). A request that is not in the table aborts with its text: add
/// the line `op argument bits` to tools/enclosure_requests.txt and regenerate the table.
fn mpfr_enclosure(
  op : String,
  value : Binary,
  bits : Int32,
) -> (Binary, Binary) {
  let argument = value.to_hex()
  for row in enclosure_rows() {
    let (row_op, row_argument, row_bits, low_text, gap) = row
    if row_op == op && row_bits == bits && row_argument == argument {
      let wide = BinaryContext::new(precision=bits + 64)
      let low = Binary::from_hex_ctx(low_text, wide).unwrap().0
      if gap == "" {
        return (low, low)
      }
      let step = Binary::from_hex_ctx("0x1p" + gap, wide).unwrap().0
      return (low, low.add_ctx(step, wide).0)
    }
  }
  abort("missing enclosure request: \{op} \{argument} \{bits}")
}

///|
// oracle: A
// source: enclosure_rows_wbtest.mbt, generated by tools/generate_enclosure_rows.py; GNU MPFR 4.2.2 exp, exp2, ln, log2, sin, cos, tan, acos, asin, atan, sinh, cosh and tanh rounded toward negative and toward positive infinity at the stated precision, library-ran: no (the requests, the arguments, come from the tests)
// shares: Binary::from_hex_ctx reads the rows exactly (level A through hex_ctx_rows and hex_agree_rows), Binary::add_ctx forms low + 2^gap exactly in a wider context (level A through arith_rows), Binary::to_hex writes the key
test "the enclosure table pairs are ordered and complete" {
  let mut checked = 0
  for row in enclosure_rows() {
    let (op, _, bits, low_text, gap) = row
    assert_true(
      [
        "exp", "exp2", "ln", "log2", "sin", "cos", "tan", "acos", "asin", "atan",
        "sinh", "cosh", "tanh",
      ].contains(op),
    )
    let wide = BinaryContext::new(precision=bits + 64)
    let low = Binary::from_hex_ctx(low_text, wide).unwrap().0
    if gap != "" {
      let step = Binary::from_hex_ctx("0x1p" + gap, wide).unwrap().0
      let high = low.add_ctx(step, wide).0
      assert_true(low.compare(high) < 0)
    }
    checked += 1
  }
  assert_eq(checked, 5229)
}

///|
fn trigonometric_operation_name(op : BinaryTrigonometricOperation) -> String {
  match op {
    BinaryTrigonometricOperation::Sin => "sin"
    BinaryTrigonometricOperation::Cos => "cos"
    BinaryTrigonometricOperation::Tan => "tan"
  }
}

///|
/// `op(value)` rounded in `context` from the MPFR enclosure at `bits` bits, with its flags, when
/// both ends round to the same value (the MPFR results themselves bound the true value).
fn mpfr_rounded(
  op : String,
  value : Binary,
  context : BinaryContext,
  bits : Int32,
) -> (Binary, BinaryFlags)? {
  let (low, high) = mpfr_enclosure(op, value, bits)
  let (result, unique, flags) = binary_certified_inexact_target_rounding(
    low, high, context,
  )
  if unique {
    Some((result, flags))
  } else {
    None
  }
}
