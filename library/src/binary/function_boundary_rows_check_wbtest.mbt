///|
fn fbr_read(text : String) -> Binary raise {
  // exact: the context has 4 bits per hex digit plus a margin, and the implementation range
  let wide = BinaryContext::new(precision=(text.length() * 4 + 64).to_int())
  let (value, flags) = Binary::from_hex_ctx(text, wide).unwrap()
  assert_true(!flags.inexact() && !flags.underflow() && !flags.overflow())
  value
}

///|
fn fbr_flag_letters(flags : BinaryFlags) -> String {
  let letters = (if flags.inexact() { "x" } else { "" }) +
    (if flags.overflow() { "o" } else { "" }) +
    (if flags.underflow() { "u" } else { "" }) +
    (if flags.invalid_operation() { "v" } else { "" }) +
    (if flags.division_by_zero() { "z" } else { "" })
  if letters == "" {
    "-"
  } else {
    letters
  }
}

///|
fn fbr_eval(
  op : String,
  a : Binary,
  b : Binary,
  n : Int32,
  context : BinaryContext,
) -> (Binary, BinaryFlags) {
  match op {
    "exp" => a.exp_ctx(context)
    "exp2" => a.exp2_ctx(context)
    "exp10" => a.exp10_ctx(context)
    "expm1" => a.expm1_ctx(context)
    "pow" => a.pow_ctx(b, context)
    "powr" => a.powr_ctx(b, context)
    "pown" => a.pown_ctx(n, context)
    "rootn" => a.rootn_ctx(n, context)
    "compound" => a.compound_ctx(n, context)
    "exp2m1" => a.exp2m1_ctx(context)
    "exp10m1" => a.exp10m1_ctx(context)
    "log2p1" => a.log2p1_ctx(context)
    "log10p1" => a.log10p1_ctx(context)
    "rsqrt" => a.rsqrt_ctx(context)
    "asinpi" => a.asinpi_ctx(context)
    "acospi" => a.acospi_ctx(context)
    "atanpi" => a.atanpi_ctx(context)
    "atan2pi" => a.atan2pi_ctx(b, context)
    "hypot" => a.hypot_ctx(b, context)
    _ => abort("unknown operation " + op)
  }
}

///|
/// Runs every row of `group` of `function_boundary_rows()` and returns how many there were; `kept`
/// and `dropped` are asserted exactly against the table and against `function_boundary_counts()`.
fn fbr_check_group(
  group : String,
  kept : Int32,
  dropped : Int32,
) -> Int32 raise {
  let mut count = 0
  for row in function_boundary_rows() {
    let (g, op, p, _, emax, mode, tininess, a_text, b_text, n, expected, flags) = row
    if g != group {
      continue
    }
    let context = if emax == 0 {
      BinaryContext::new(precision=p, rounding=hex_ctx_mode(mode))
    } else {
      BinaryContext::new(
        precision=p,
        e_max=emax,
        rounding=hex_ctx_mode(mode),
        tininess=if tininess == "before" {
          TininessDetection::BeforeRounding
        } else {
          TininessDetection::AfterRounding
        },
      )
    }
    let a = fbr_read(a_text)
    let b = if b_text == "" { Binary::zero() } else { fbr_read(b_text) }
    let (value, actual_flags) = fbr_eval(op, a, b, n, context)
    let label = "\{op} p=\{p} e_max=\{emax} \{mode} \{tininess} \{a_text} \{b_text} \{n}"
    assert_eq(
      "\{label} => \{value} \{fbr_flag_letters(actual_flags)}",
      "\{label} => \{fbr_read(expected)} \{flags}",
    )
    count += 1
  }
  assert_eq(count, kept)
  let mut listed = false
  for entry in function_boundary_counts() {
    let (name, listed_kept, listed_dropped) = entry
    if name == group {
      assert_eq((listed_kept, listed_dropped), (kept, dropped))
      listed = true
    }
  }
  assert_true(listed)
  count
}

///|
// oracle: A
// source: function_boundary_rows_wbtest.mbt, generated by tools/generate_function_boundary_rows.py; values and flags from GNU MPFR 4.2.2 (tools/generate_mpfr_random_oracle.c eval, mpfr_subnormalize, underflow from IEEE 754-2019 7.5), library-ran: no
// shares: Binary::from_hex_ctx reads operands and expected values exactly (level A through hex_ctx_rows and hex_agree_rows); Display and the flag accessors print the result
test "elementary functions on and next to the underflow and overflow thresholds: MPFR rows" {
  assert_true(fbr_check_group("sweep", 3066, 84) > 0)
}
