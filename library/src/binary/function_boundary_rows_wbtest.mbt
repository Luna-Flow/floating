///|
fn function_boundary_rows() -> Array[
  (
    String,
    String,
    Int32,
    Int32,
    Int32,
    String,
    String,
    String,
    String,
    Int32,
    String,
    String,
  ),
] {
  let rows = []
  rows.append(function_boundary_rows_part0())
  rows.append(function_boundary_rows_part1())
  rows.append(function_boundary_rows_part2())
  rows.append(function_boundary_rows_part3())
  rows.append(function_boundary_rows_part4())
  rows.append(function_boundary_rows_part5())
  rows
}

///|
/// (group, rows kept, rows dropped): the sampling and its losses, asserted by the check.
fn function_boundary_counts() -> Array[(String, Int32, Int32)] {
  [
    ("sweep", 3066, 84),
    ("underflow_exp", 954, 12),
    ("underflow_pow", 140, 0),
    ("underflow_pown_rootn", 1052, 0),
    ("pm1_underflow", 810, 0),
    ("pown_tininess", 20, 0),
    ("pown_directed", 25, 0),
    ("expm1_overflow", 45, 0),
    ("hypot_range", 210, 60),
    ("hypot_negligible", 288, 0),
    ("rsqrt", 520, 0),
