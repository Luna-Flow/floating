///|
fn burst_trig_test_corpus() -> Array[Binary] {
  let values : Array[Binary] = []
  let mut seed = 5000UL
  for bits in [60, 130, 256, 400, 700, 1100, 2000] {
    for top in [-60, -20, -8, -3, -1, 0, 1, 2, 3, 5, 8, 12, 20, 40, 100] {
      values.push(burst_test_value(bits, top, false, seed))
      seed += 1UL
      values.push(burst_test_value(bits, top, true, seed))
      seed += 1UL
    }
  }
  // Arguments next to multiples of pi / 2.
  let (pi_low, _) = binary_pi_bounds(2400).unwrap()
  for bits in [100, 300, 700, 1500] {
    let half_pi = pi_low.mul_ctx(
      Binary::make_coeff(Coeff::one(), -1, 1),
      BinaryContext::new(precision=2400),
    ).0.with_precision(bits, BinaryRoundingMode::RoundTowardNegative)
    for k in [1, 2, 3, 4, 5, 7, 100, 12345, 1000003] {
      let product = half_pi.mul_ctx(
          Binary::from_int(k, precision=32),
          BinaryContext::new(precision=bits + 40),
        ).0
      let context = BinaryContext::new(precision=bits + 40)
      values.push(product)
      values.push(product.neg())
      values.push(product.next_up_ctx(context).0)
      values.push(product.next_down_ctx(context).0)
    }
  }
  values
}

///|
/// The enclosure of the true value, from MPFR rows, at a precision that is 256 bits
/// beyond the burst working precision (and beyond what certifies the quadrant).
fn burst_trig_test_reference(
  value : Binary,
  cosine : Bool,
  work : Int32,
) -> (Binary, Binary)? {
  let top = Int32::max(0, binary_top_bound(value).to_int())
  let reference_work = Int32::max(work, value.precision() + top + 96) + 256
  Some(
    mpfr_enclosure(if cosine { "cos" } else { "sin" }, value, reference_work),
  )
}

///|
// oracle: A
// source: enclosure_rows_wbtest.mbt, generated by tools/generate_enclosure_rows.py; sin and cos rows at the reference precision of burst_trig_test_reference (GNU MPFR 4.2.2 rounded toward negative and toward positive infinity at the stated precision), library-ran: no; the arguments are inputs of the test and the reference is the pair of MPFR results
// shares: Binary::to_hex writes the key of the request, Binary::from_hex_ctx and Binary::add_ctx read the pair exactly (level A through hex_ctx_rows and arith_rows), Binary::compare in burst_test_contains; burst_trig_test_corpus builds the arguments, binary_top_bound only picks the precision of the request
test "bit-burst sin and cos contain the series enclosure at higher precision" {
  let mut checked = 0
  for value in burst_trig_test_corpus() {
    for cosine in [false, true] {
      let work = burst_test_work(value.precision())
      match binary_trig_bounds_burst(value, cosine, work) {
        Some(bounds) =>
          match burst_trig_test_reference(value, cosine, work) {
            Some(reference) => {
              assert_true(burst_test_contains(bounds, reference))
              checked += 1
            }
            None => ()
          }
        None => ()
      }
    }
  }
  assert_true(checked > 300)
}

///|
test "bit-burst sin and cos are no wider than the series enclosure" {
  for value in burst_trig_test_corpus() {
    for cosine in [false, true] {
      let work = burst_test_work(value.precision())
      let top = Int32::max(0, binary_top_bound(value).to_int())
      // The series path certifies the quadrant from this precision on.
      let series_work = Int32::max(work, value.precision() + top + 96)
      match binary_trig_bounds_burst(value, cosine, series_work) {
        Some((low, high)) =>
          match
            binary_trigonometric_bounds_series(
              value,
              if cosine {
                BinaryTrigonometricOperation::Cos
              } else {
                BinaryTrigonometricOperation::Sin
              },
              series_work,
            ) {
            Some((series_low, series_high)) =>
              assert_true(
                high.sub(low).compare(series_high.sub(series_low)) <= 0,
              )
            None => ()
          }
        None => ()
      }
    }
  }
}

///|
// oracle: A
// source: written out: the kernel's domain is the finite non-zero values with -64 <= top <= 4096 (stated in the guard at the head of binary_trig_bounds_burst and in the comment of this test); zero, 2^-200, an infinity, a NaN and 2^5000 lie outside
// shares: binary_trig_bounds_burst (the code under test), Binary::zero, Binary::make_coeff, Binary::inf, Binary::nan
test "bit-burst sin and cos decline outside their range" {
  let work = 512
  for cosine in [false, true] {
    assert_true(
      binary_trig_bounds_burst(Binary::zero(precision=64), cosine, work) is None,
    )
    assert_true(
      binary_trig_bounds_burst(
        Binary::make_coeff(Coeff::one(), -200, 1),
        cosine,
        work,
      )
      is None,
    )
    assert_true(binary_trig_bounds_burst(Binary::inf(), cosine, work) is None)
    assert_true(binary_trig_bounds_burst(Binary::nan(), cosine, work) is None)
    // 2^5000 is beyond the range of the kernel.
    assert_true(
      binary_trig_bounds_burst(
        Binary::make_coeff(Coeff::one(), 5000, 1),
        cosine,
        work,
      )
      is None,
    )
  }
}

///|
// oracle: A
// source: enclosure_rows_wbtest.mbt, generated by tools/generate_enclosure_rows.py; sin and cos rows at the reference precision (GNU MPFR 4.2.2 rounded toward negative and toward positive infinity at the stated precision), library-ran: no; the arguments are inputs of the test and the reference is the pair of MPFR results
// shares: Binary::to_hex writes the key of the request, Binary::from_hex_ctx and Binary::add_ctx read the pair exactly (level A through hex_ctx_rows and arith_rows), Binary::compare in burst_test_contains and burst_test_caught; burst_test_value builds the arguments; the mutations are record arguments of binary_trig_bounds_burst
test "mutated bit-burst sin and cos are caught by the containment test" {
  let value = burst_test_value(2000, 0, false, 8080UL)
  let work = 2064
  for cosine in [false, true] {
    let reference = burst_trig_test_reference(value, cosine, work).unwrap()
    assert_true(
      burst_test_contains(
        binary_trig_bounds_burst(value, cosine, work).unwrap(),
        reference,
      ),
    )
    let biased = {
      mid_bias_bits: 64,
      split_reduce_terms: 0,
      pi_drop_bits: 0,
      cos_swap_ends: false,
      cos_no_plus_one: false,
    }
    assert_true(
      burst_test_caught(
        binary_trig_bounds_burst(
          value,
          cosine,
          work,
          mutation=biased,
          first_chunk=binary_exp_burst_first_chunk,
          chunk_factor=binary_exp_burst_chunk_factor,
          split_min_terms=binary_exp_burst_split_min_terms,
        ),
        reference,
      ),
    )
    let shortened = {
      mid_bias_bits: 0,
      split_reduce_terms: 40,
      pi_drop_bits: 0,
      cos_swap_ends: false,
      cos_no_plus_one: false,
    }
    assert_true(
      burst_test_caught(
        binary_trig_bounds_burst(
          value,
          cosine,
          work,
          mutation=shortened,
          first_chunk=binary_exp_burst_first_chunk,
          chunk_factor=binary_exp_burst_chunk_factor,
          split_min_terms=binary_exp_burst_split_min_terms,
        ),
        reference,
      ),
    )
  }
  // A reduction with too few bits of pi for a large argument.
  let large = burst_test_value(2000, 40, false, 8081UL)
  let large_reference = burst_trig_test_reference(large, false, work).unwrap()
  assert_true(
    burst_test_contains(
      binary_trig_bounds_burst(large, false, work).unwrap(),
      large_reference,
    ),
  )
  let coarse = {
    mid_bias_bits: 0,
    split_reduce_terms: 0,
    pi_drop_bits: 200,
    cos_swap_ends: false,
    cos_no_plus_one: false,
  }
  assert_true(
    burst_test_caught(
      binary_trig_bounds_burst(
        large,
        false,
        work,
        mutation=coarse,
        first_chunk=binary_exp_burst_first_chunk,
        chunk_factor=binary_exp_burst_chunk_factor,
        split_min_terms=binary_exp_burst_split_min_terms,
      ),
      large_reference,
    ),
  )
}

///|
// oracle: A
// source: enclosure_rows_wbtest.mbt, generated by tools/generate_enclosure_rows.py; sin and cos at 2 bits + 200 bits through burst_trig_test_reference, rounded in each context by binary_certified_inexact_target_rounding when both ends round alike rows (GNU MPFR 4.2.2 rounded toward negative and toward positive infinity at the stated precision), library-ran: no; the arguments are inputs of the test and the reference is the pair of MPFR results
// shares: Binary::to_hex writes the key of the request, Binary::from_hex_ctx and Binary::add_ctx read the pair exactly (level A through hex_ctx_rows and arith_rows), Binary::compare in the containment check; burst_test_value builds the arguments; binary_certified_inexact_target_rounding rounds the pair (level A through round_rows_wbtest.mbt); the name keeps the old wording
test "sin and cos results equal the rounded series enclosure at high precision" {
  let modes = [
    RoundTiesToEven,
    RoundTowardZero,
    RoundTowardPositive,
    RoundTowardNegative,
  ]
  let mut seed = 9100UL
  let mut compared = 0
  for bits in [200, 300, 513, 640, 1000, 1024, 1536] {
    for top in [-20, -3, -1, 0, 1, 2, 5, 12, 40] {
      for negative in [false, true] {
        seed += 1UL
        let value = burst_test_value(bits, top, negative, seed)
        // The reference enclosure does not depend on the rounding mode: compute
        // it once per value and function (it was recomputed for each mode).
        for cosine in [false, true] {
          let reference_bounds = burst_trig_test_reference(
            value,
            cosine,
            2 * bits + 200,
          )
          match reference_bounds {
            Some((low, high)) =>
              for mode in modes {
                let context = BinaryContext::new(precision=bits, rounding=mode)
                let (expected, unique, expected_flags) = binary_certified_inexact_target_rounding(
                  low, high, context,
                )
                if unique {
                  let (result, flags) = if cosine {
                    value.cos_ctx(context)
                  } else {
                    value.sin_ctx(context)
                  }
                  assert_true(result.identical(expected))
                  assert_true(flags == expected_flags)
                  compared += 1
                }
              }
            None => ()
          }
        }
      }
    }
  }
  assert_true(compared > 400)
}
