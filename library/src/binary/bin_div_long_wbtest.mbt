///|
/// Division of wide operands: the divisor has at least 800 limbs, above the
/// threshold of the recursive division on every tier, so that
/// `bin_coeff_short_div_rem` takes the Burnikel-Ziegler route. The expected
/// results are constructed (`N = q d + r`, so the quotient, the round bit and
/// the sticky bit are known) or checked by the exact rounding interval.
struct DivLongRandom {
  mut div_long_state : UInt64
}

///|
fn DivLongRandom::next(self : DivLongRandom) -> UInt64 {
  self.div_long_state = self.div_long_state * 6364136223846793005UL +
    1442695040888963407UL
  (self.div_long_state >> 17) | (self.div_long_state << 47)
}

///|
/// A coefficient of exactly `bits` bits.
fn div_long_coeff(random : DivLongRandom, bits : Int32) -> Coeff {
  let mut value = Coeff::one()
  while value.bit_length() < bits {
    value = value.shift_left(32).add(Coeff::from_uint64(random.next() >> 32))
  }
  let trimmed = value.shift_right(value.bit_length() - bits)
  if trimmed.bit_length() < bits {
    Coeff::one().shift_left(bits - 1).add(trimmed)
  } else {
    trimmed
  }
}

///|
fn div_long_modes() -> Array[BinaryRoundingMode] {
  [
    BinaryRoundingMode::RoundTiesToEven,
    BinaryRoundingMode::RoundTiesToAway,
    BinaryRoundingMode::RoundTowardZero,
    BinaryRoundingMode::RoundTowardPositive,
    BinaryRoundingMode::RoundTowardNegative,
  ]
}

///|
/// `N mod (2^64 - 1)` (the sum of the words with the carry added back) and the sum of
/// `(i + 1) * w_i` mod 2^64, both as decimal strings: checks of a numerator built with `mul`
/// against the values Python computed (div_long_rows_wbtest.mbt), without a second product.
fn div_long_fold(n : Coeff) -> (String, String) {
  let count = (n.bit_length() + 63) / 64
  let mut sum = 0UL
  let mut weighted = 0UL
  for index in 0..<count {
    let word = n
      .shift_right(64 * index)
      .bit_and(Coeff::from_uint64(0xFFFFFFFFFFFFFFFFUL))
      .to_uint64()
      .unwrap()
    sum = sum + word
    if sum < word {
      sum = sum + 1UL
    }
    weighted = weighted + (index + 1).to_uint64() * word
  }
  if sum == 0xFFFFFFFFFFFFFFFFUL {
    sum = 0UL
  }
  ("\{sum}", "\{weighted}")
}

///|
/// `x / y` for `x = N` and `y = d` rounded to `precision` bits, with
/// `N = q d + r`, `q` of `precision + 1` bits, `0 <= r < d`: the quotient N / d lies in
/// [q, q + 1), so the result is q / 2 truncated, or one unit above it when the rounding
/// direction goes up (`up`, from the table: Python's rounding rule, 4.3), and is inexact
/// when the round bit or the sticky bit is set (`inexact`, from the table).
fn div_long_check_constructed(
  numerator : Coeff,
  q : Coeff,
  d : Coeff,
  precision : Int32,
  mode : BinaryRoundingMode,
  negative : Bool,
  up : Bool,
  inexact : Bool,
) -> Unit raise {
  let x = finite_from_parts(negative, numerator, 0, numerator.bit_length())
  let y = finite_from_parts(false, d, 0, d.bit_length())
  let context = BinaryContext::new(precision~, rounding=mode)
  let (actual, flags) = x.div_ctx(y, context)
  let retained = if up {
    q.shift_right(1).add(Coeff::one())
  } else {
    q.shift_right(1)
  }
  // value = retained * 2 (the quotient N / d lies in [q, q + 1))
  let expected = finite_from_parts(negative, retained, 1, precision)
  assert_identical(actual, expected)
  assert_eq(flags.inexact(), inexact)
  assert_eq(flags.overflow(), false)
  assert_eq(flags.underflow(), false)
}

///|
// oracle: A
// source: div_long_rows_wbtest.mbt, generated by tools/generate_div_long_rows.py: the operands are drawn again with the same generator in Python, the numerator N = q d + r is checked against Python's residues, and the rounding direction (up or down) and inexactness per mode and sign come from Python's rounding rule of 4.3; library-ran: no
// shares: Coeff::mul builds N (checked by the table residues), Coeff::shift_right and Coeff::add on the retained quotient; the division under test is not used by the expected value
test "div_ctx of wide operands: rounding bits all zero, all one, exactly half, in five directions" {
  let random = { div_long_state: 0x4D49_5353_494E_4721UL, }
  let rows = div_long_constructed_rows()
  let mut row_index = 0
  for divisor_bits in [51200, 51264, 53000, 60001] {
    let d = div_long_coeff(random, divisor_bits).add(Coeff::one())
    let d = if d.is_odd() { d } else { d.add(Coeff::one()) }
    for precision in [53, 700, 3000] {
      let q_odd = div_long_coeff(random, precision + 1)
      let q_odd = if q_odd.is_odd() { q_odd } else { q_odd.add(Coeff::one()) }
      let q_even = q_odd.add(Coeff::one())
      let d_minus_1 = d.sub_checked(Coeff::one()).unwrap()
      // the six cases of the table, in its order: round bit, then sticky bit
      let cases = [
        (q_even, Coeff::zero()),
        (q_odd, Coeff::zero()),
        (q_odd, d_minus_1),
        (q_even, d_minus_1),
        (q_odd, Coeff::one()),
        (q_even, d.shift_right(1)),
      ]
      for case_index in 0..<6 {
        let (q, r) = cases[case_index]
        let (
          bits,
          row_precision,
          row_case,
          n_bits,
          fold,
          weighted,
          outcomes,
          inexact,
        ) = rows[row_index]
        row_index += 1
        assert_eq(
          (bits, row_precision, row_case),
          (divisor_bits, precision, case_index),
        )
        let numerator = q.mul(d).add(r)
        // the numerator is the one Python built
        assert_eq(numerator.bit_length(), n_bits)
        let (numerator_fold, numerator_weighted) = div_long_fold(numerator)
        assert_eq((numerator_fold, numerator_weighted), (fold, weighted))
        let modes = div_long_modes()
        for mode_index in 0..<modes.length() {
          for sign_index in 0..<2 {
            div_long_check_constructed(
              numerator,
              q,
              d,
              precision,
              modes[mode_index],
              sign_index == 1,
              outcomes.get_char(2 * mode_index + sign_index) == Some('U'),
              inexact == "I",
            )
          }
        }
      }
    }
  }
  assert_eq(row_index, rows.length())
}

///|
// oracle: A
// source: div_long_rows_wbtest.mbt, generated by tools/generate_div_long_rows.py: the correctly rounded quotient (Python Fraction, ties to even) of operands drawn with the same generator in Python, and the residues of the numerator q * b of the exact-multiple case; library-ran: no
// shares: Coeff::mul builds the numerator of the exact-multiple case (checked by the table residues); Binary::to_hex prints the quotient
test "div and div_ctx of full-width operands above the recursive-division threshold are correctly rounded" {
  let random = { div_long_state: 0x1357_9BDF_0246_8ACEUL, }
  let rows = div_long_quotient_rows()
  let mut row_index = 0
  for bits in [51200, 52000, 64000] {
    let (row_bits, expected_hex, n_bits, fold, weighted) = rows[row_index]
    row_index += 1
    assert_eq(row_bits, bits)
    let a = finite_from_parts(false, div_long_coeff(random, bits), -bits, bits)
    let b = finite_from_parts(false, div_long_coeff(random, bits), -bits, bits)
    let quotient = a.div(b)
    assert_true(quotient.to_hex() == expected_hex)
    let (general, flags) = a.div_ctx(b, BinaryContext::new(precision=bits))
    assert_identical(general, quotient)
    assert_true(flags.inexact())
    // a divisor that is a multiple structure: a = q b exactly
    let q = div_long_coeff(random, 700)
    let product = q.mul(b.coefficient_())
    assert_eq(product.bit_length(), n_bits)
    assert_eq(div_long_fold(product), (fold, weighted))
    let exact_x = finite_from_parts(
      false,
      product,
      0,
      q.bit_length() + b.coefficient_().bit_length(),
    )
    let (exact, exact_flags) = exact_x.div_ctx(
      b,
      BinaryContext::new(precision=800),
    )
    assert_eq(exact_flags.inexact(), false)
    assert_identical(exact, finite_from_parts(false, q, -b.exponent2_(), 800))
  }
  assert_eq(row_index, rows.length())
}
