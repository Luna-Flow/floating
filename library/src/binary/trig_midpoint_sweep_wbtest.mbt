// The midpoint form of the reduced trigonometric bounds against main's
// two-ended form: same values and flags, never NaN, and no more refinement
// rounds than the reference plus one. The expected digest and rounds were
// recorded on the two-ended form (the tree before the midpoint form).

///|
fn trig_sweep_functions() -> Array[
  (String, Bool, (Binary, BinaryContext) -> (Binary, BinaryFlags)),
] {
  [
    ("sin", false, fn(x, c) { x.sin_ctx(c) }),
    ("cos", false, fn(x, c) { x.cos_ctx(c) }),
    ("tan", false, fn(x, c) { x.tan_ctx(c) }),
    ("sinpi", true, fn(x, c) { x.sinpi_ctx(c) }),
    ("cospi", true, fn(x, c) { x.cospi_ctx(c) }),
    ("tanpi", true, fn(x, c) { x.tanpi_ctx(c) }),
  ]
}

///|
/// Arguments: 2^e and 3 * 2^e of both signs down to the bottom of the range,
/// and, for the plain functions, floats just above, at and below multiples of
/// pi/2 (reduced ends distinct, results near 0 and near plus or minus 1); for
/// the pi-scaled ones, multiples of 1/2 plus and minus small powers of two.
fn trig_sweep_arguments(pi_scaled : Bool) -> Array[Binary] {
  let values : Array[Binary] = []
  for
    e in [
      -60, -200, -1000, -10000, -100000, -1000000, -100000000, -500000000, -1073741870,
    ] {
    for c in [1UL, 3UL] {
      let x = Binary::make_coeff(Coeff::from_uint64(c), e, 64)
      values.push(x)
      values.push(x.neg())
    }
  }
  // The smallest subnormal of each tested precision (2^(e_min - (p - 1))) and the
  // next quanta above it, where the midpoint and the distances are rounded to the
  // quantum of the work precision.
  for p in [2, 3, 24, 53, 113] {
    let bottom = binary_value_e_min - (p - 1)
    for c in [1UL, 2UL, 3UL, 5UL] {
      let x = Binary::make_coeff(Coeff::from_uint64(c), bottom, 128)
      values.push(x)
      values.push(x.neg())
    }
  }
  // Operands finer than the work quantum: the leading bit 100 and 400 binades
  // below e_min, stored at an operand precision of 113 and 500 bits (a value of
  // width w keeps nothing below 2^(e_min - (w - 1)), so only a few bits remain).
  for shape in [(100, 113, 12), (100, 500, 60), (400, 500, 60)] {
    let (depth, width, bits) = shape
    for tail in [1UL, 77UL] {
      let coefficient = Coeff::one()
        .shift_left(bits - 1)
        .add(Coeff::from_uint64(tail * 2UL))
        .add(Coeff::one())
      let x = Binary::make_coeff(
        coefficient,
        binary_value_e_min - depth - (bits - 1),
        width,
      )
      values.push(x)
      values.push(x.neg())
    }
  }
  let wide = BinaryContext::new(precision=400)
  if pi_scaled {
    for k in [1, 2, 3, 5] {
      let base = Binary::from_int(k, precision=400).mul_ctx(
          Binary::make_coeff(Coeff::one(), -1, 400),
          wide,
        ).0
      for d in [-200, -60, -20] {
        let delta = Binary::make_coeff(Coeff::one(), d, 400)
        values.push(base.add_ctx(delta, wide).0)
        values.push(base.sub_ctx(delta, wide).0)
      }
    }
  } else {
    let pi = binary_pi_bounds(300).unwrap().0
    for k in [1, 2, 3, 5, 100, 1001] {
      let base = Binary::from_int(k, precision=400).mul_ctx(pi, wide).0.mul_ctx(
        Binary::make_coeff(Coeff::one(), -1, 400),
        wide,
      ).0.with_precision(80, BinaryRoundingMode::RoundTowardNegative)
      let ulp = Binary::make_coeff(Coeff::one(), base.exponent2(), 400)
      values.push(base)
      values.push(base.add_ctx(ulp, wide).0)
      values.push(base.sub_ctx(ulp, wide).0)
      values.push(base.neg())
    }
  }
  values
}

///|
/// Runs the whole sweep: a digest (FNV-1a over the text of every result and its
/// flags) and the number of refinement rounds of every case, one digit each.
fn trig_sweep_run() -> (UInt64, String, Int32) {
  let mut hash = 0xcbf29ce484222325UL
  let rounds = StringBuilder()
  let mut nans = 0
  for f in trig_sweep_functions() {
    let (name, pi_scaled, run) = f
    for x in trig_sweep_arguments(pi_scaled) {
      for p in [2, 3, 24, 53, 113] {
        for mode in e2s_modes() {
          let context = BinaryContext::new(precision=p, rounding=mode)
          binary_reduced_trigonometric_calls.val = 0
          let (value, flags) = run(x, context)
          let calls = binary_reduced_trigonometric_calls.val
          if value.is_nan() {
            nans += 1
          }
          let text = "\{name}(\{x}) p=\{p} \{e2s_mode_name(mode)} => \{value} \{e2s_flags(flags)}\n"
          for c in text {
            hash = (hash ^ c.to_int().to_uint64()) * 0x100000001b3UL
          }
          rounds.write_string(Int32::min(calls, 9).to_string())
        }
      }
    }
  }
  (hash, rounds.to_string(), nans)
}

