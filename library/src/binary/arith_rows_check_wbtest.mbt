// add_ctx, mul_ctx, div_ctx and sqrt_ctx against exact rational arithmetic on operands of up to
// p bits, p from 2 to 4097, in the implementation range and in binary16, binary32 and binary64
// (overflow, the subnormal range), five rounding directions, both tininess rules.
//
// The rows of arith_rows_wbtest.mbt come from tools/generate_arith_rows.py (Python fractions
// and math.isqrt, the range rule of IEEE 754-2019 7.4 and 7.5); the library did not run.

///|
fn arith_row_operand(text : String, p : Int32) -> Binary {
  // at most p bits: the value is exact and the operand has precision p
  Binary::from_hex_ctx(text, BinaryContext::new(precision=p)).unwrap().0
}

///|
fn arith_row_context(
  p : Int32,
  emax : Int32,
  mode : String,
  tininess : String,
) -> BinaryContext {
  BinaryContext::new(
    precision=p,
    e_max=emax,
    rounding=hex_ctx_mode(mode),
    tininess=if tininess == "before" {
      TininessDetection::BeforeRounding
    } else {
      TininessDetection::AfterRounding
    },
  )
}

///|
// oracle: A
// source: arith_rows_wbtest.mbt, generated by tools/generate_arith_rows.py from Python fractions and math.isqrt (exact value, quantum of the binade, subnormal grid, 7.4 and 7.5), library-ran: no
// shares: Binary::from_hex_ctx reads the operands (level A through hex_ctx_rows and hex_agree_rows); Display and e2s_flags print the result
test "add, mul, div and sqrt are rounded once, exactly: rows from exact arithmetic" {
  let rows = arith_rows()
  let mut count = 0
  for row in rows {
    let (op, p, _, emax, mode, tininess, left_text, right_text, expected, flags) = row
    let context = arith_row_context(p, emax, mode, tininess)
    let left = arith_row_operand(left_text, p)
    let (value, actual_flags) = match op {
      "sqrt" => left.sqrt_ctx(context)
      "add" => left.add_ctx(arith_row_operand(right_text, p), context)
      "mul" => left.mul_ctx(arith_row_operand(right_text, p), context)
      _ => left.div_ctx(arith_row_operand(right_text, p), context)
    }
    let label = "\{op} p=\{p} \{mode} \{tininess} \{left_text} \{right_text}"
    assert_eq(
      "\{label} => \{value} \{e2s_flags(actual_flags)}",
      "\{label} => \{expected} \{flags}",
    )
    count += 1
  }
  assert_eq(count, rows.length())
}

///|
// oracle: A
// source: arith_rows_wbtest.mbt, generated by tools/generate_arith_rows.py from Python fractions and math.isqrt, library-ran: no; only the rows in the implementation range with ties to even are used (add, mul, div and sqrt without a context round that way, at the larger operand precision, which is p)
// shares: Binary::from_hex_ctx reads the operands (level A through hex_ctx_rows and hex_agree_rows); Display prints the result
test "add, mul, div and sqrt without a context: the ties-to-even rows" {
  let mut count = 0
  for row in arith_rows() {
    let (op, p, _, emax, mode, _, left_text, right_text, expected, _) = row
    if mode != "RNE" || emax != 1073741823 {
      continue
    }
    let left = arith_row_operand(left_text, p)
    let value = match op {
      "sqrt" => left.sqrt()
      "add" => left.add(arith_row_operand(right_text, p))
      "mul" => left.mul(arith_row_operand(right_text, p))
      _ => left.div(arith_row_operand(right_text, p))
    }
    let label = "\{op} p=\{p} \{left_text} \{right_text}"
    assert_eq("\{label} => \{value}", "\{label} => \{expected}")
    count += 1
  }
  assert_true(count > 700)
}
