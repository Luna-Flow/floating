///|
fn binary_exp_fixed_test_values() -> Array[Binary] {
  let values : Array[Binary] = []
  let mut state = 0x2545F4914F6CDD1DUL
  for index in 0..<60 {
    state = state * 6364136223846793005UL + 1442695040888963407UL
    let bits = 20 + index % 90
    let mantissa = Coeff::from_uint64((state >> 11) | 1UL)
      .shift_right(64 - Int32::min(bits, 53))
      .add(Coeff::one())
    // magnitudes from 2^-30 up to 2^9, both signs
    let exponent = -Int32::min(bits, 53) - 30 + index * 7 % 40
    values.push(
      Binary::make_coeff(
        mantissa,
        exponent,
        Int32::max(Int32::min(bits, 53), 2),
        negative=index % 3 == 0,
      ),
    )
  }
  values.push(Binary::make_coeff(Coeff::one(), -3, 53)) // exactly 1/8
  values.push(Binary::make_coeff(Coeff::one(), -3, 53, negative=true))
  values.push(Binary::make_coeff(Coeff::one(), -60000, 53)) // tiny
  values.push(Binary::make_coeff(Coeff::one(), 9, 53)) // 512
  values.push(Binary::make_coeff(Coeff::one(), -1, 53, negative=true))
  values
}

///|
// oracle: A
// source: enclosure_rows_wbtest.mbt, generated by tools/generate_enclosure_rows.py; exp rows at 2 work + 64 bits; the width limit 2^-(work - 16) of the upper end is written in the test and is a tightness check, not an oracle (GNU MPFR 4.2.2 rounded toward negative and toward positive infinity at the stated precision), library-ran: no; the arguments are inputs of the test and the reference is the pair of MPFR results
// shares: Binary::to_hex writes the key of the request, Binary::from_hex_ctx and Binary::add_ctx read the pair exactly (level A through hex_ctx_rows and arith_rows), Binary::compare in the containment check; binary_exp_fixed_test_values builds the arguments, Binary::sub_ctx and mul in the width check
test "fixed-point exp enclosure contains the series enclosure's true value" {
  for work in [20, 53, 64, 117, 181, 300] {
    for value in binary_exp_fixed_test_values() {
      let fixed = binary_exp_bounds_fixed(value, work)
      // arguments exact at the working precision always take the fixed path
      if value.coefficient_bits() <= work {
        assert_true(fixed is Some(_))
      }
      guard fixed is Some((fixed_lower, fixed_upper)) else { continue }
      assert_true(fixed_lower.compare(fixed_upper) <= 0)
      // A far tighter series enclosure of the same exponential brackets the
      // true value, so it must lie inside the fixed-point enclosure.
      let tight_precision = work * 2 + 64
      let (tight_lower, tight_upper) = mpfr_enclosure(
        "exp", value, tight_precision,
      )
      assert_true(fixed_lower.compare(tight_lower) <= 0)
      assert_true(fixed_upper.compare(tight_upper) >= 0)
      // and the enclosure is tight: at most 2^-(work - 16) of its upper end wide
      let fixed_width = fixed_upper.sub_ctx(
          fixed_lower,
          BinaryContext::new(precision=work + 32, rounding=RoundTowardPositive),
        ).0
      let limit = fixed_upper.mul(
        Binary::make_coeff(Coeff::one(), -(work - 16), 1),
      )
      assert_true(fixed_width.compare(limit) <= 0)
    }
  }
}

///|
// oracle: A
// source: enclosure_rows_wbtest.mbt, generated by tools/generate_enclosure_rows.py; exp at 2 precision + 200 bits, rounded in each context by binary_certified_inexact_target_rounding when both ends round alike rows (GNU MPFR 4.2.2 rounded toward negative and toward positive infinity at the stated precision), library-ran: no; the arguments are inputs of the test and the reference is the pair of MPFR results
// shares: Binary::to_hex writes the key of the request, Binary::from_hex_ctx and Binary::add_ctx read the pair exactly (level A through hex_ctx_rows and arith_rows), Binary::compare in the containment check; binary_exp_fixed_test_values builds the arguments; binary_certified_inexact_target_rounding rounds the pair (level A through round_rows_wbtest.mbt)
test "fixed-point exp path gives the same correctly rounded results" {
  let contexts = [
    BinaryContext::binary64(),
    BinaryContext::new(precision=24),
    BinaryContext::new(precision=100),
    BinaryContext::new(precision=53, rounding=RoundTowardZero),
    BinaryContext::new(precision=53, rounding=RoundTowardPositive),
  ]
  for context in contexts {
    for value in binary_exp_fixed_test_values() {
      let value = value.with_precision(
        context.precision,
        BinaryRoundingMode::RoundTiesToEven,
      )
      let expected = mpfr_rounded(
        "exp",
        value,
        context,
        2 * context.precision + 200,
      )
      match expected {
        Some((result, flags)) => {
          let (actual, actual_flags) = value.exp_ctx(context)
          assert_identical(actual, result)
          assert_eq(actual_flags, flags)
        }
        None => ()
      }
    }
  }
}

///|
test "fixed-point exp path declines arguments it does not cover" {
  assert_true(binary_exp_bounds_fixed(Binary::zero(), 100) is None)
  assert_true(binary_exp_bounds_fixed(Binary::nan(), 100) is None)
  assert_true(binary_exp_bounds_fixed(Binary::inf(precision=53), 100) is None)
  // not exact at the working precision: the general path runs
  let wide = Binary::make_coeff(
    Coeff::one().shift_left(150).add(Coeff::one()),
    -151,
    160,
  )
  assert_true(binary_exp_bounds_fixed(wide, 100) is None)
  assert_true(binary_exp_bounds(wide, 100) is Some(_))
}
