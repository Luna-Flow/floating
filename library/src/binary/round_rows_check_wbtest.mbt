// binary_round_dyadic and binary_round_sqrt against integer arithmetic and the range rule of IEEE 754-2019 4.3, 7.4, 7.5,
// with the leading bit around e_min, e_max and both ends of the implementation exponent range.
//
// The rows of round_rows_wbtest.mbt come from tools/generate_round_rows.py (Python integers: a shift,
// a quotient and a remainder; cross-checked against the Fraction-based generate_hex_ctx_rows.convert in
// tools/generate_round_rows_test.py); the library did not run.

///|
// oracle: A
// source: round_rows_wbtest.mbt, generated by tools/generate_round_rows.py from Python integer arithmetic (math.isqrt for the root) and the range rule of 7.4 and 7.5; library-ran: no
// shares: Coeff::parse reads the magnitude (level A in the bin_kernel tests); Binary Display and e2s_flags print the result
test "binary_round_dyadic and binary_round_sqrt against integer arithmetic at the range limits, five directions, both tininess rules" {
  let rows = round_rows()
  let mut count = 0
  for row in rows {
    let (
      operation,
      negative,
      hex,
      exponent2,
      p,
      emax,
      mode,
      tininess,
      expected,
      flags,
    ) = row
    let context = BinaryContext::new(
      precision=p,
      e_max=emax,
      rounding=hex_ctx_mode(mode),
      tininess=if tininess == "before" {
        TininessDetection::BeforeRounding
      } else {
        TininessDetection::AfterRounding
      },
    )
    let magnitude = Coeff::parse(hex, radix=16).unwrap()
    let (value, actual_flags) = if operation == "sqrt" {
      binary_round_sqrt(magnitude, exponent2, context)
    } else {
      binary_round_dyadic(negative == 1, magnitude, exponent2, context)
    }
    let label = "\{operation} \{negative} \{hex} e=\{exponent2} p=\{p} emax=\{emax} \{mode} \{tininess}"
    assert_eq(
      "\{label} => \{value} \{e2s_flags(actual_flags)}",
      "\{label} => \{expected} \{flags}",
    )
    count += 1
  }
  assert_eq(count, rows.length())
}
