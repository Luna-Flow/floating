///|
/// Test-only copies of `binary_exp2_bounds` and `binary_log2_bounds` before
/// #378 (they recomputed `ln 2` through the full `ln` path): the new bounds
/// must contain the old ones evaluated at 128 more bits.

///|
// oracle: A
// source: enclosure_rows_wbtest.mbt, generated by tools/generate_enclosure_rows.py; exp2 and log2 at w + 128 bits; the rows are (GNU MPFR 4.2.2 rounded toward negative and toward positive infinity at the stated precision), library-ran: no; the arguments are inputs of the test and the reference is the pair of MPFR results
// shares: Binary::to_hex writes the key of the request, Binary::from_hex_ctx and Binary::add_ctx read the pair exactly (level A through hex_ctx_rows and arith_rows), Binary::compare in the containment check; the arguments are doubles read by Binary::from_double
test "exp2 and log2 bounds with the cached ln 2 contain the old enclosures" {
  for w in [64, 128, 300] {
    for
      d in [1.0e-20, 0.001, 0.3, 0.75, 1.0, 1.5, 2.0, 3.7, 10.0, 77.25, 1000.5] {
      for sign in [1.0, -1.0] {
        let x = Binary::from_double(d * sign, precision=53)
        let fresh = binary_exp2_bounds(x, w).unwrap()
        let reference = mpfr_enclosure("exp2", x, w + 128)
        assert_true(
          fresh.0.compare(reference.0) <= 0,
          msg="exp2 lower \{x} \{w}",
        )
        assert_true(
          fresh.1.compare(reference.1) >= 0,
          msg="exp2 upper \{x} \{w}",
        )
      }
      let y = Binary::from_double(d, precision=53)
      let fresh = binary_log2_bounds(y, w).unwrap()
      let reference = mpfr_enclosure("log2", y, w + 128)
      assert_true(fresh.0.compare(reference.0) <= 0, msg="log2 lower \{y} \{w}")
      assert_true(fresh.1.compare(reference.1) >= 0, msg="log2 upper \{y} \{w}")
    }
  }
}
