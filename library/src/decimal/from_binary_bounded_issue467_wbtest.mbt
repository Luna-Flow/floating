// Issue 467: the plain `Decimal::from_binary` formed the whole expansion
// `c * 5^k` (or `c << e2`) before it rounded to `precision` digits, so its cost
// grew with the binary exponent. The bounded form rounds the surrogate digits of
// `Binary::to_decimal_string_ctx` once; the result must be the one of the
// expansion: same coefficient, exponent, sign and precision field.

///|
/// The binary value `mantissa * 2^exponent`, signed, as an exact `Binary`.
fn from_binary_row_value(
  mantissa : String,
  exponent : Int32,
  negative : Bool,
) -> @binary.Binary {
  @binary.Binary::make(
    @binary.BinCoeff::from_bytes_be(bigint_from_text(mantissa).to_octets()),
    exponent,
    64,
    negative~,
    mode=@binary.BinaryRoundingMode::RoundTiesToEven,
  )
}

///|
fn from_binary_mode_of(name : String) -> DecimalRoundingMode {
  match name {
    "half_even" => DecimalRoundingMode::RoundTiesToEven
    "half_up" => DecimalRoundingMode::RoundTiesToAway
    "down" => DecimalRoundingMode::RoundTowardZero
    "ceiling" => DecimalRoundingMode::RoundTowardPositive
    "floor" => DecimalRoundingMode::RoundTowardNegative
    _ => abort("unexpected mode \{name}")
  }
}

///|
// oracle: A
// source: table from_binary_rows generated by tools/generate_decimal_oracle_rows.py: 660 dyadic values (15 bases times 22 binary shifts from -6000 to 5000, both signs) rounded to 1 to 100 digits half-even from the exact value (integer arithmetic, then CPython decimal plus); the earlier oracle was the exact expansion c * 5^k that from_binary computed before the bounded form
// shares: Binary::make and bigint_from_text (they build the operand from an exact mantissa and exponent), Decimal::to_string and decimal_from_binary_surrogate or Decimal::from_binary (the code under test)
test "issue 467: the bounded form gives the result of the exact expansion" {
  for row in from_binary_rows {
    let (mantissa, exponent, negative, precision, _, expected) = row
    let x = from_binary_row_value(mantissa, exponent, negative)
    let label = (mantissa, exponent, negative, precision)
    assert_eq(
      (
        label,
        decimal_from_binary_surrogate(x, precision, DecimalRound::HalfEven).to_string(),
      ),
      (label, expected),
    )
    assert_eq(
      (label, Decimal::from_binary(x, precision~).to_string()),
      (label, expected),
    )
  }
}

///|
// oracle: S
// source: the bound on the size of the result (at most 34 digits) and the sign, at binary exponents up to 1e9 (the earlier code took minutes); no value is written out. The values at exponents up to 5000 are level A in the blocks of this file
// shares: Binary::from_int, scaleb_ctx and Decimal::from_binary (the code under test)
test "issue 467: the cost does not depend on the binary exponent" {
  let wide = @binary.BinaryContext::new(precision=53)
  let three = @binary.Binary::from_int(3, precision=53)
  // Before the bounded form these took minutes (quadratic in the exponent).
  for exponent in [-100000000, -1000000, 1000000, 100000000, 1000000000] {
    let x = three.scaleb_ctx(@binary.Binary::from_int(exponent), wide).0
    let value = Decimal::from_binary(x, precision=34)
    inspect(value.coefficient().to_string().length() <= 34, content="true")
    inspect(value.is_sign_minus(), content="false")
  }
}

///|
/// The rounding attribute is the one of the radix of the result: the bounded form
/// and the exact expansion agree in each of the five `DecimalRoundingMode`s, for
/// both signs, exact values and ties included (the surrogate keeps a sticky digit).
// oracle: A
// source: table from_binary_mode_rows generated by tools/generate_decimal_oracle_rows.py: the same 660 dyadic values with the precision and the direction (five modes) rotating with the row, from the exact value by integer arithmetic and CPython decimal plus; the ties at 2.5 and 3.5 are written out below (half-even 2, away 3, toward positive 3, toward zero 2)
// shares: Binary::make, Binary::from_double and bigint_from_text (they build the operands), Decimal::from_binary and to_string (the code under test and its output)
test "issue 467: from_binary rounds in every DecimalRoundingMode like the exact expansion" {
  for row in from_binary_mode_rows {
    let (mantissa, exponent, negative, precision, mode, expected) = row
    let x = from_binary_row_value(mantissa, exponent, negative)
    let label = (mantissa, exponent, negative, precision, mode)
    assert_eq(
      (
        label,
        Decimal::from_binary(x, precision~, mode=from_binary_mode_of(mode)).to_string(),
      ),
      (label, expected),
    )
  }
  // 0.5 at one digit is a tie: even gives 0.5 exactly (one digit), so use 2.5 and 3.5
  let tie = @binary.Binary::from_double(2.5, precision=53)
  inspect(Decimal::from_binary(tie, precision=1).to_string(), content="2")
  inspect(
    Decimal::from_binary(
      tie,
      precision=1,
      mode=DecimalRoundingMode::RoundTiesToAway,
    ).to_string(),
    content="3",
  )
  inspect(
    Decimal::from_binary(
      tie,
      precision=1,
      mode=DecimalRoundingMode::RoundTowardPositive,
    ).to_string(),
    content="3",
  )
  inspect(
    Decimal::from_binary(
      tie,
      precision=1,
      mode=DecimalRoundingMode::RoundTowardZero,
    ).to_string(),
    content="2",
  )
}

///|
/// `from_binary` on operands that take the bounded (surrogate) route, with the
/// part discarded by the rounding exactly zero, one unit below half, exactly half and
/// one unit above half, an even and an odd last kept digit, both signs, all five
/// modes: the value is `T * 10^1100` with `T = D * 1000 + tail`, exact in a binary
/// float of 3000 bits (`T * 5^1100 * 2^1100`), and the exact expansion decides.
/// Only a positive binary exponent is built this way. For a negative one the
/// expansion of a dyadic value `c * 2^-n` has about `0.7 n` digits, so a precision
/// that leaves exactly one discarded digit (the 5 that ends it, the exact half)
/// is about `0.7 n`, which breaks the bound `2 p <= n` of the bounded route: an
/// exact half cannot be constructed there, and the arbitrary rows above cover the
/// negative operands of that route.
// oracle: A
// source: table from_binary_boundary_rows generated by tools/generate_decimal_oracle_rows.py: the exact integer T * 10^1100 (T = D * 1000 + tail) rounded to the digits of D in each of the five modes by CPython decimal plus, in the loop order below (kept, tail, sign, mode); the earlier oracle was the exact expansion built by the previous implementation
// shares: Binary::make, bigint_from_text and pow5 (they build the operand: T * 5^1100 * 2^1100 is exact in 3000 bits), decimal_from_binary_is_bounded, Decimal::from_binary and to_string (the code under test and its output)
test "from_binary: the bounded route at the rounding boundaries in every mode" {
  let modes = [
    DecimalRoundingMode::RoundTiesToEven,
    DecimalRoundingMode::RoundTiesToAway,
    DecimalRoundingMode::RoundTowardZero,
    DecimalRoundingMode::RoundTowardPositive,
    DecimalRoundingMode::RoundTowardNegative,
  ]
  let five_1100 = pow5(1100)
  let mut index = 0
  for
    kept in [
      ("1", 1),
      ("2", 1),
      ("12", 2),
      ("13", 2),
      ("12345", 5),
      ("12346", 5),
      ("99999999999999999", 17),
      ("1234567890123456789012345678901234", 34),
      ("1234567890123456789012345678901235", 34),
    ] {
    let (digits, precision) = kept
    for tail in [0, 499, 500, 501] {
      let t = bigint_from_text(digits) * BigInt::from_int(1000) +
        BigInt::from_int(tail)
      let coefficient = @binary.BinCoeff::from_bytes_be(
        (t * five_1100).to_octets(),
      )
      for negative in [false, true] {
        let x = @binary.Binary::make(
          coefficient,
          1100,
          3000,
          negative~,
          mode=@binary.BinaryRoundingMode::RoundTiesToEven,
        )
        assert_true(decimal_from_binary_is_bounded(x, precision))
        for mode in modes {
          let expected = from_binary_boundary_rows[index]
          index += 1
          assert_eq(
            (
              digits,
              tail,
              negative,
              Decimal::from_binary(x, precision~, mode~).to_string(),
            ),
            (digits, tail, negative, expected),
          )
        }
      }
    }
  }
  assert_eq(index, from_binary_boundary_rows.length())
}
