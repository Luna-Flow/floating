      "add",
      ["-9.5", "-0.5"],
      1,
      -5,
      0,
      false,
      HalfDown,
      "-Infinity",
      "xr..o...",
    ),
    ("add", ["-9.5", "-0.5"], 1, -5, 0, false, Down, "-9", "xr..o..."),
    ("add", ["-9.5", "-0.5"], 1, -5, 0, false, Ceiling, "-9", "xr..o..."),
