      ["-99E-1", "-999E-1", "-9E1"],
      1,
      0,
      2,
      false,
      Floor,
      "8E+2",
      "xr......",
    ),
    (
      "fma",
      ["-99E-1", "-999E-1", "-9E1"],
      1,
      0,
      2,
      false,
      Up,
      "9E+2",
      "xr......",
    ),
    (
      "fma",
      ["-99E-1", "-999E-1", "-9E1"],
      1,
      0,
      2,
      false,
      ZeroFiveUp,
      "8E+2",
      "xr......",
    ),
    (
      "fma",
      ["594E-1", "1E-4", "-95E-1"],
      1,
      -1,
      0,
      true,
      HalfEven,
      "-9",
      "xr......",
    ),
    (
      "fma",
      ["594E-1", "1E-4", "-95E-1"],
      1,
      -1,
      0,
      true,
      HalfUp,
      "-9",
      "xr......",
