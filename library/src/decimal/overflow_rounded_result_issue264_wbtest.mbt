      false,
      HalfUp,
      "9E+2",
      "xr......",
    ),
    (
      "fma",
      ["-99E-1", "-999E-1", "-9E1"],
      1,
      0,
      2,
      false,
      HalfDown,
      "9E+2",
      "xr......",
