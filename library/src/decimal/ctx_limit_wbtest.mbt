///|
fn ctx_limit_flags(flags : DecimalFlags) -> String {
  let text = (if flags.inexact() { "x" } else { "" }) +
    (if flags.overflow() { "o" } else { "" }) +
    (if flags.underflow() { "u" } else { "" })
  if text == "" {
    "-"
  } else {
    text
  }
}

///|
// oracle: A
// source: expected texts and flags of add, sub, mul, div and fma from CPython decimal (libmpdec) with Emin and Emax at and just below the stored limits, table ctx_limit_rows generated by tools/generate_decimal_ctx_limit_rows.py (the first 48 rows are the rows of issue 806)
// shares: Decimal::from_string, Decimal::to_string, DecimalContext::raw and the _ctx operations of the code under test (operands and contexts are built from the row, the result is compared as text)
test "context operations at the limits of the exponent range follow libmpdec (#806)" {
  let mut index = -1
  let misses = []
  for chunk in ctx_limit_chunks {
    for row in chunk {
      index += 1
      let (op, rounding, precision, e_min, e_max, a, b, c, expected, flags) = row
      let ctx = DecimalContext::raw(precision, e_min, e_max, round=rounding)
      let x = Decimal::from_string(a).unwrap()
      let y = Decimal::from_string(b).unwrap()
      let (value, got) = match op {
        "add" => x.add_ctx(y, ctx)
        "sub" => x.sub_ctx(y, ctx)
        "mul" => x.mul_ctx(y, ctx)
        "div" => x.div_ctx(y, ctx)
        _ => x.fma_ctx(y, Decimal::from_string(c).unwrap(), ctx)
      }
      let actual = (value.to_string(), ctx_limit_flags(got))
      if actual != (expected, flags) {
        misses.push((index, op, a, b, c, actual, (expected, flags)))
      }
    }
  }
  assert_eq(misses.length(), 0, msg=misses.to_string())
}
