///|
// `to_binary` and the lower and upper bounds of `decimal_to_certified_ball`
// (#378): one division with a shift of `precision + 3 + ceil(log2 10^scale)`
// bits instead of two with `precision + 4 scale + 2`. The results are
// compared with exact integer arithmetic in Python, in every rounding mode, for positive and negative exponents, around the power caches
// (4096), for coefficients of the three decimal formats, and for the bounds
// built from one conversion.

///|
// oracle: A
// source: table to_binary_grid_rows generated by tools/generate_decimal_oracle_rows.py with the rounding of tools/generate_decimal_to_bin_rows.py: 1100 rows over 11 coefficients, 25 exponents (around the power caches at 4096 and up to E-150000), both signs, two (precision, mode) pairs each (precisions 1 to 600, five modes), the value C * 2^k by exact integer arithmetic in Python; the earlier oracle was the previous implementation of to_binary kept as private reference code
// shares: Decimal::from_string, bigint_from_text, abs_bigint, Binary::make and to_binary_mode (they build the operand and the expected value from an exact coefficient and exponent), Binary::compare and is_sign_minus
test "to_binary equals the previous implementation in every mode" {
  for row in to_binary_grid_rows {
    let (text, precision, mode, coefficient, exponent) = row
    let value = Decimal::from_string(text, precision=40).unwrap()
    let negative = value.signum() == Sign::Negative
    let got = value.to_binary(precision~, mode=to_binary_mode(mode, negative))
    let expected = ball_row_binary(coefficient, exponent)
    assert_true(
      got.compare(expected) == 0 &&
      got.is_sign_minus() == expected.is_sign_minus(),
      msg="\{text} p=\{precision} \{mode}",
    )
  }
}

///|
/// The binary value `C * 2^k` of a table row, as an exact `Binary`.
fn ball_row_binary(coefficient : String, exponent : Int32) -> @binary.Binary {
  let value = bigint_from_text(coefficient)
  let negative = value < BigInt::from_int(0)
  let magnitude = abs_bigint(value)
  @binary.Binary::make(
    @binary.BinCoeff::from_bytes_be(magnitude.to_octets()),
    exponent,
    magnitude.bit_length() + 2,
    negative~,
    mode=@binary.BinaryRoundingMode::RoundTiesToEven,
  )
}

///|
// oracle: A
// source: table ball_rows generated by tools/generate_decimal_oracle_rows.py: the exact decimal value rounded toward negative and toward positive to p bits, by integer arithmetic in Python (generate_decimal_to_bin_rows.round_to_bits, the generator of the to_binary table above); no to_binary call produces an expected value
// shares: Decimal::from_string (reads the text), bigint_from_text, abs_bigint, BigInt::to_octets and bit_length, BinCoeff::from_bytes_be and Binary::make (they build the expected value from an exact coefficient and exponent, no rounding since the coefficient has fewer bits than the precision), and Binary::compare and is_sign_minus (they read both sides)
test "decimal_to_certified_ball bounds are the two directed conversions" {
  assert_eq(ball_rows.length(), 40)
  for row in ball_rows {
    let (text, p, lower_c, lower_k, upper_c, upper_k) = row
    let value = Decimal::from_string(text, precision=40).unwrap()
    let ball = decimal_to_certified_ball(value, p)
    let lower = ball_row_binary(lower_c, lower_k)
    let upper = ball_row_binary(upper_c, upper_k)
    assert_true(
      ball.lower_bound().compare(lower) == 0 &&
      ball.lower_bound().is_sign_minus() == lower.is_sign_minus(),
      msg="lower \{text} \{p}",
    )
    assert_true(
      ball.upper_bound().compare(upper) == 0 &&
      ball.upper_bound().is_sign_minus() == upper.is_sign_minus(),
      msg="upper \{text} \{p}",
    )
  }
}

///|
/// The rounding attribute of a row's mode name for a value of the given sign:
/// the generated rows keep the names of the retired `@arithmetic` modes, and
/// `AwayFromZero` is the direction of the sign.
fn to_binary_mode(name : String, negative : Bool) -> @binary.BinaryRoundingMode {
  match name {
    "ToNearestEven" => @binary.BinaryRoundingMode::RoundTiesToEven
    "ToNearestAway" => @binary.BinaryRoundingMode::RoundTiesToAway
    "TowardZero" => @binary.BinaryRoundingMode::RoundTowardZero
    "AwayFromZero" =>
      if negative {
        @binary.BinaryRoundingMode::RoundTowardNegative
      } else {
        @binary.BinaryRoundingMode::RoundTowardPositive
      }
    "TowardNegative" => @binary.BinaryRoundingMode::RoundTowardNegative
    "TowardPositive" => @binary.BinaryRoundingMode::RoundTowardPositive
    _ => abort("unknown mode " + name)
  }
}

///|
test "to_binary at large exponents equals exact integer arithmetic (not the old code)" {
  // Expected values: tools/generate_decimal_to_bin_rows.py (Python integers):
  // exponents about +-2e5 and +-2e6, +-4096 and 4097 around the switch to
  // bounds of 5^e, every direction and sign, and values exactly representable
  // or exactly halfway between two numbers (the round-to-odd sticky bit; the
  // bounds of 5^e straddle them, so the exact conversion decides).
  let rows = to_binary_rows()
  for row in rows {
    let (text, precision, mode, coefficient, exponent) = row
    let value = Decimal::from_string(
      text,
      precision=Int32::max(40, text.length()),
    ).unwrap()
    let got = value.to_binary(
      precision~,
      mode=to_binary_mode(mode, value.signum() == Sign::Negative),
    )
    let expected_value = bigint_from_text(coefficient)
    let negative = expected_value < BigInt::from_int(0)
    let magnitude = abs_bigint(expected_value)
    let expected = @binary.Binary::make(
      @binary.BinCoeff::from_bytes_be(magnitude.to_octets()),
      exponent,
      magnitude.bit_length() + 2,
      negative~,
      mode=@binary.BinaryRoundingMode::RoundTiesToEven,
    )
    assert_true(
      got.compare(expected) == 0 && got.is_sign_minus() == negative,
      msg="\{text[:Int32::min(40, text.length())].to_owned()} p=\{precision} \{mode}",
    )
  }
  assert_true(rows.length() > 500)
}
