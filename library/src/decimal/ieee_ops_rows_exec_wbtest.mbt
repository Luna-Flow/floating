///|
// Executes `ieee_ops_rows` (generated by tools/generate_decimal_ieee_ops_rows.py
// from Python `decimal`): the IEEE 754-2019 operations on contexts of IEEE
// formats. The value is compared with `total_order_compare` (so the cohort, the
// sign of a zero and a NaN payload count); the five IEEE flags are compared on
// every row. The flags of `next_toward` are not CPython's: IEEE 754-2019 has no
// nextToward, and the operation follows the nextafter rule of IEEE 754-1985 and
// ISO C (overflow and inexact for a finite operand and an infinite result, underflow
// and inexact for a subnormal or zero result when the operands differ, otherwise
// none), which the generator writes (`next_toward_flags`) and the API page states.

///|
fn ieee_ops_mode(name : String) -> DecimalRoundingMode {
  match name {
    "half_even" => RoundTiesToEven
    "half_up" => RoundTiesToAway
    "down" => RoundTowardZero
    "ceiling" => RoundTowardPositive
    "floor" => RoundTowardNegative
    _ => abort("unknown rounding " + name)
  }
}

///|
fn ieee_ops_flags(flags : DecimalFlags) -> String {
  (if flags.inexact { "x" } else { "." }) +
  (if flags.underflow { "u" } else { "." }) +
  (if flags.overflow { "o" } else { "." }) +
  (if flags.division_by_zero { "z" } else { "." }) +
  (if flags.invalid_operation { "i" } else { "." })
}

///|
fn ieee_ops_parse(text : String, ctx : DecimalContext) -> Decimal {
  Decimal::from_string(text, precision=ctx.precision()).unwrap()
}

///|
fn ieee_ops_call(
  op : String,
  a : Decimal,
  b : Decimal,
  c : Decimal,
  ctx : DecimalContext,
) -> (Decimal, DecimalFlags) {
  match op {
    "next_up" => a.next_up_ctx(ctx)
    "next_down" => a.next_down_ctx(ctx)
    "next_toward" => a.next_toward_ctx(b, ctx)
    "logb" => a.logb_ctx(ctx)
    "scaleb" => a.scaleb_ctx(b, ctx)
    "remainder" => a.remainder_ctx(b, ctx)
    "quantize" => a.quantize_ctx(b, ctx)
    "to_integral_exact" => a.to_integral_exact_ctx(ctx)
    "to_integral_value" => a.to_integral_value_ctx(ctx)
    "sqrt" => a.sqrt_ctx(ctx)
    "add" => a.add_ctx(b, ctx)
    "subtract" => a.sub_ctx(b, ctx)
    "multiply" => a.mul_ctx(b, ctx)
    "divide" => a.div_ctx(b, ctx)
    "fma" => a.fma_ctx(b, c, ctx)
    "nan_payload" => a.add_ctx(Decimal::one(precision=ctx.precision()), ctx)
    _ => abort("unknown operation " + op)
  }
}

///|
test "IEEE operations on legal contexts agree with the Python decimal oracle" {
  // a guard against a generator that silently loses rows: the table size and the
  // size of the `next_toward` family
  inspect(ieee_ops_rows.length(), content="7479")
  inspect(
    ieee_ops_rows.filter(fn(row) { row.0 == "next_toward" }).length(),
    content="510",
  )
  let failures = StringBuilder()
  let mut count = 0
  let per_op : Map[String, Int32] = Map([])
  for row in ieee_ops_rows {
    let (op, p, e_max, mode, a, b, c, expected, flags) = row
    let ctx = DecimalContext::new(
      precision=p,
      e_max~,
      rounding=ieee_ops_mode(mode),
    )
    let x = ieee_ops_parse(a, ctx)
    let y = if b == "-" {
      Decimal::zero(precision=p)
    } else {
      ieee_ops_parse(b, ctx)
    }
    let z = if c == "-" {
      Decimal::zero(precision=p)
    } else {
      ieee_ops_parse(c, ctx)
    }
    let (value, actual_flags) = ieee_ops_call(op, x, y, z, ctx)
    let want = ieee_ops_parse(expected, ctx)
    let got = ieee_ops_flags(actual_flags)
    if value.total_order_compare(want) != 0 || got != flags {
      count += 1
      let seen = per_op.get(op).unwrap_or(0)
      per_op[op] = seen + 1
      if seen < 6 {
        failures.write_string(
          "\{op} p=\{p} emax=\{e_max} \{mode} \{a} \{b} \{c}: want \{expected} \{flags}, got \{value} \{got}\n",
        )
      }
    }
  }
  inspect(failures.to_string(), content="")
  inspect(count, content="0")
}
