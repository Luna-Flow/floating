// Issue 446: the plain `+` and `-` of `Decimal` formed the exact aligned sum, so
// an exponent gap above 2^31 - 1 panicked and a smaller one allocated memory
// proportional to the gap. The far smaller operand only contributes a sticky
// digit; the cost is independent of the gap.

///|
fn gap_value(
  coefficient : BigInt,
  exponent : Int32,
  precision : Int32,
) -> Decimal {
  Decimal::make(coefficient, exponent, precision)
}

///|
test "issue 446: plain add and sub with an exponent gap above 2^31 - 1 do not panic" {
  let a = gap_value(1N, 1_100_000_000, 34)
  let b = gap_value(1N, -1_100_000_000, 34)
  let sum = a + b
  let difference = a - b
  let reversed = b + a
  let negated = a + b.neg()
  // The sum is rounded to 34 digits: 1E+1100000000 plus or minus a sticky digit.
  inspect(sum == a, content="true")
  inspect(reversed == a, content="true")
  inspect(difference == a, content="true")
  inspect(negated == a, content="true")
  inspect(sum.coefficient.digits10() <= 34, content="true")
  // The negative operand large: -a + b is -a.
  inspect(a.neg() + b == a.neg(), content="true")
  inspect(b - a == a.neg(), content="true")
}

///|
// oracle: A
// source: expected texts of a + b and a - b from CPython decimal (libmpdec) in the plain working context (precision 34, half-even, no clamp), table gap_446_rows generated by tools/generate_decimal_oracle_rows.py; the inexact results carry a full 34 digit coefficient as in GDA 1.70 rounding
// shares: Decimal::make, gap_value, Decimal::to_string and the plain operators + and - of the code under test (the operands are built with make and the result is compared as text with the expected text)
test "issue 446: a gap below 2^31 - 1 costs nothing and rounds like add_ctx" {
  // The same shape within the exponent range of a context.
  let cases : Array[(BigInt, Int32, BigInt, Int32)] = [
    (1N, 900_000, 1N, -900_000),
    (1N, 900_000, -1N, -900_000),
    (-1N, 900_000, 1N, -900_000),
    (9999999999999999999999999999999999N, 500_000, 1N, -400_000),
    (9999999999999999999999999999999999N, 500_000, -1N, -400_000),
    (5N, 0, 3N, -700_000),
    (5N, 0, -3N, -700_000),
    (12345N, -10, 6N, 400_000),
  ]
  let expected_rows = gap_446_rows()
  assert_eq(cases.length(), expected_rows.length())
  for index, c in cases {
    let (ac, ae, bc, be) = c
    let a = gap_value(ac, ae, 34)
    let b = gap_value(bc, be, 34)
    let (plus, minus) = expected_rows[index]
    assert_eq((index, (a + b).to_string()), (index, plus))
    assert_eq((index, (a - b).to_string()), (index, minus))
  }
}

///|
// oracle: A
// source: table sticky_446_rows generated by tools/generate_decimal_oracle_rows.py: the operands rounded to `precision` digits and the sum rounded once, by CPython decimal (libmpdec), in the loop order below; the gaps straddle the point where the absorption starts
// shares: Decimal::make, gap_value, Decimal::to_string and the plain operator + of the code under test (the operands are built with make and the result is compared as text with the expected text)
test "issue 446: the sticky absorption gives the result of the exact aligned sum" {
  let coefficients : Array[BigInt] = [
    1N, 9N, 12345N, 5000000000000N, 9999999999999999999999999999999999N, 1000000000000000000000000000000000N,
  ]
  let mut index = 0
  let expected_rows = sticky_446_rows()
  for precision in [1, 2, 5, 34] {
    for hc in coefficients {
      for lc in [1N, 5N, 7N, 99N] {
        for
          gap in [
            precision - 1,
            precision,
            precision + 1,
            precision + 2,
            precision + 3,
            precision + 7,
            precision + 40,
            5000,
          ] {
          for high_negative in [false, true] {
            for low_negative in [false, true] {
              let high = gap_value(
                if high_negative {
                  -hc
                } else {
                  hc
                },
                0,
                precision,
              )
              let low = gap_value(
                if low_negative {
                  -lc
                } else {
                  lc
                },
                -gap - lc.to_string().length() - hc.to_string().length(),
                precision,
              )
              let expected = expected_rows[index]
              index += 1
              assert_eq((index, (high + low).to_string()), (index, expected))
              assert_eq((index, (low + high).to_string()), (index, expected))
            }
          }
        }
      }
    }
  }
  assert_eq(index, expected_rows.length())
}

///|
test "issue 446: a gap above 2^31 - 1 between a small and a large exponent" {
  let small = gap_value(5N, -2_000_000_000, 34)
  let big = gap_value(3N, 2_000_000_000, 34)
  // 3E+2000000000 plus 5E-2000000000 rounds to 3E+2000000000 at 34 digits.
  inspect(small + big == big, content="true")
  inspect(big - small == big, content="true")
  inspect(small - big == big.neg(), content="true")
}

///|
test "issue 446: the exact context cannot panic through the exponent gap" {
  let a = gap_value(1N, 1_100_000_000, 34)
  let b = gap_value(1N, -1_100_000_000, 34)
  let (sum, flags) = a.add_ctx(b, decimal_exact_work_context())
  inspect(sum.is_nan(), content="true")
  inspect(flags.not_computed && !flags.invalid_operation, content="true")
  let (difference, _) = a.sub_ctx(b, decimal_exact_work_context())
  inspect(difference.is_nan(), content="true")
}
