///|
// White-box tests of asinPi, acosPi, atanPi and atan2Pi (issue #236, PR 3).
// The clause quotes are from IEEE Std 754-2019; the generated table
// `elementary_pi_inverse_rows_wbtest.mbt` holds the exact and MPFR-certified
// rows.

///|
fn pii_try(
  op : String,
  x : String,
  y : String,
  ctx : DecimalContext,
) -> Result[(Decimal, DecimalFlags), @def.ArithmeticError] {
  let a = pm1_exact(x)
  match op {
    "asinpi" => a.try_asinpi_ctx(ctx)
    "acospi" => a.try_acospi_ctx(ctx)
    "atanpi" => a.try_atanpi_ctx(ctx)
    "atan2pi" => a.try_atan2pi_ctx(pm1_exact(y), ctx)
    _ => abort("unknown operation " + op)
  }
}

///|
fn pii_call(
  op : String,
  x : String,
  y : String,
  ctx : DecimalContext,
) -> String {
  match pii_try(op, x, y, ctx) {
    Ok((value, flags)) => "\{value} \{pm1_flags_text(flags)}"
    Err(_) => "certification-failure"
  }
}

///|
// oracle: A
// source: table pii_rows generated by tools/generate_decimal_pi_inverse_rows.py (--check passes, run 2026-11-26): the exact Niven values with fractions.Fraction at the preferred exponent 0 (IEEE 754-2019 9.2.2) rounded once by libmpdec, every other row the rounding of certified MPFR 4.2.2 enclosures (tools/mpfr_decimal_enclosure.c) rounded by libmpdec kept only when both endpoints round alike; no row comes from the library
// shares: pm1_ctx_cached, pm1_exact (Decimal::from_string), pm1_flags_text and pii_call (build the context and operands and print value and flags through to_string), total_order_compare (compares the value), try_asinpi_ctx, try_acospi_ctx, try_atanpi_ctx and try_atan2pi_ctx (the code under test)
test "pi inverse generated rows: exact and certified results, cohort and flags" {
  let failures = StringBuilder()
  let mut count = 0
  let rows = pii_rows()
  for row in rows {
    let (
      op,
      rounding,
      precision,
      e_min,
      e_max,
      clamp,
      tininess,
      x,
      y,
      expected,
      flags,
    ) = row
    let ctx = pm1_ctx_cached(precision, rounding, e_min, e_max, clamp, tininess)
    // Value (cohort included) and flags are compared directly; the result is
    // formatted only to describe a failure.
    let ok = match pii_try(op, x, y, ctx) {
      Ok((value, actual_flags)) =>
        value.total_order_compare(pm1_exact(expected)) == 0 &&
        pm1_flags_text(actual_flags) == flags
      Err(_) => false
    }
    if !ok {
      count += 1
      if count <= 20 {
        failures.write_string(
          "\{op} \{rounding} p=\{precision} [\{e_min},\{e_max}] clamp=\{clamp} \{tininess} x=\{x} y=\{y}: want \{expected} \{flags}, got \{pii_call(op, x, y, ctx)}\n",
        )
      }
    }
  }
  inspect(failures.to_string(), content="")
  assert_true(rows.length() > 3000)
}

///|
fn pii_all_modes(op : String, x : String, y : String) -> String raise {
  // The same text in every rounding mode (exact constants, domain errors).
  let outputs : Array[String] = []
  for mode in pm1_modes {
    let ctx = pm1_ctx(16, mode, -383, 384, true, "b")
    outputs.push(pii_call(op, x, y, ctx))
  }
  for text in outputs {
    assert_eq(text, outputs[0], msg="\{op}(\{x}, \{y})")
  }
  outputs[0]
}

///|
// oracle: A
// source: IEEE 754-2019 9.2.1 and Table 9.1 (read from the PDF text in this session): asinPi(+-0) is +-0 with no exception, asinPi(+-1) is +-1/2 exact (Niven), |x| > 1 and infinite x are invalid operation; the table is written out, one text for all eight directions; the NaN payload and sign of the result (nan12, -nan3) follow 6.2.3, which leaves the sign unspecified, so those two rows are the library's convention
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "asinPi special values (9.2.1, Table 9.1)" {
  // 9.2.1: "f(+0) is +0 and f(-0) is -0 with no exception" for asinPi.
  // Table 9.1: "|x| > 1: invalid operation". asinPi(+-1) = +-1/2 (Niven).
  let out = StringBuilder()
  for
    x in [
      "0", "-0", "0E-9", "-0E+5", "1", "-1", "1.000", "-1E+0", "2", "-1.0000001",
      "Infinity", "-Infinity", "NaN12", "-sNaN3",
    ] {
    out.write_string("asinpi(\{x}) = \{pii_all_modes("asinpi", x, "")}\n")
  }
  inspect(
    out.to_string(),
    content=(
      #|asinpi(0) = 0 -
      #|asinpi(-0) = -0 -
      #|asinpi(0E-9) = 0 -
      #|asinpi(-0E+5) = -0 -
      #|asinpi(1) = 0.5 -
      #|asinpi(-1) = -0.5 -
      #|asinpi(1.000) = 0.5 -
      #|asinpi(-1E+0) = -0.5 -
      #|asinpi(2) = nan v
      #|asinpi(-1.0000001) = nan v
      #|asinpi(Infinity) = nan v
      #|asinpi(-Infinity) = nan v
      #|asinpi(NaN12) = nan12 -
      #|asinpi(-sNaN3) = -nan3 v
      #|
    ),
  )
}

///|
// oracle: A
// source: IEEE 754-2019 9.2.1 and Table 9.1 (read from the PDF text in this session): acosPi(1) is +0, acosPi(-1) is 1 and acosPi(+-0) is 1/2 (acos of those is pi, pi/2 over pi), |x| > 1 and infinite x are invalid operation; written out
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "acosPi special values (9.2.1, Table 9.1)" {
  // 9.2.1: "acos(1), acosPi(1), and acosh(1) are +0." acosPi(-1) = 1 and
  // acosPi(+-0) = 1/2 are exact; |x| > 1 is invalid.
  let out = StringBuilder()
  for
    x in [
      "0", "-0", "0E-9", "1", "1.000", "-1", "-1E+0", "2", "-1.0000001", "Infinity",
      "-Infinity", "NaN12", "-sNaN3",
    ] {
    out.write_string("acospi(\{x}) = \{pii_all_modes("acospi", x, "")}\n")
  }
  inspect(
    out.to_string(),
    content=(
      #|acospi(0) = 0.5 -
      #|acospi(-0) = 0.5 -
      #|acospi(0E-9) = 0.5 -
      #|acospi(1) = 0 -
      #|acospi(1.000) = 0 -
      #|acospi(-1) = 1 -
      #|acospi(-1E+0) = 1 -
      #|acospi(2) = nan v
      #|acospi(-1.0000001) = nan v
      #|acospi(Infinity) = nan v
      #|acospi(-Infinity) = nan v
      #|acospi(NaN12) = nan12 -
      #|acospi(-sNaN3) = -nan3 v
      #|
    ),
  )
}

///|
// oracle: A
// source: IEEE 754-2019 9.2.1 and Table 9.1 (read from the PDF text in this session): atanPi(+-0) is +-0, atanPi(+-1) is +-1/4 (Niven), atanPi(+-infinity) is +-1/2 with no exception; written out
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "atanPi special values (9.2.1)" {
  // 9.2.1: "atanPi(+-inf) is +-1/2 with no exception"; f(+-0) = +-0;
  // atanPi(+-1) = +-1/4 (Niven).
  let out = StringBuilder()
  for
    x in [
      "0", "-0", "0E-9", "1", "-1", "1.000", "-1E+0", "Infinity", "-Infinity", "NaN12",
      "-sNaN3",
    ] {
    out.write_string("atanpi(\{x}) = \{pii_all_modes("atanpi", x, "")}\n")
  }
  inspect(
    out.to_string(),
    content=(
      #|atanpi(0) = 0 -
      #|atanpi(-0) = -0 -
      #|atanpi(0E-9) = 0 -
      #|atanpi(1) = 0.25 -
      #|atanpi(-1) = -0.25 -
      #|atanpi(1.000) = 0.25 -
      #|atanpi(-1E+0) = -0.25 -
      #|atanpi(Infinity) = 0.5 -
      #|atanpi(-Infinity) = -0.5 -
      #|atanpi(NaN12) = nan12 -
      #|atanpi(-sNaN3) = -nan3 v
      #|
    ),
  )
}

///|
// oracle: A
// source: IEEE 754-2019 9.2.1 and Table 9.1 (read from the PDF text in this session): the 26 operand pairs are the cases of the list for atan2Pi in 9.2.1 (zero, infinite and mixed operands, both signs), the expected text is that list; no exception is signaled
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "atan2Pi: the special cases of 9.2.1" {
  // "atan2Pi(+-0, -0) is +-1; atan2Pi(+-0, +0) is +-0; atan2Pi(+-0, x) is +-1
  // for x < 0; atan2Pi(+-0, x) is +-0 for x > 0; atan2Pi(y, +-0) is -1/2 for
  // y < 0; atan2Pi(y, +-0) is +1/2 for y > 0; atan2Pi(+-y, -inf) is +-1 for
  // finite y > 0; atan2Pi(+-y, +inf) is +-0 for finite y > 0; atan2Pi(+-inf, x)
  // is +-1/2 for finite x; atan2Pi(+-inf, -inf) is +-3/4; atan2Pi(+-inf,
  // +inf) is +-1/4." No exception is signaled.
  let out = StringBuilder()
  for
    pair in [
      ("0", "-0"),
      ("-0", "-0"),
      ("0", "0"),
      ("-0", "0"),
      ("0", "-5"),
      ("-0", "-5"),
      ("0", "5"),
      ("-0", "5"),
      ("-3", "0"),
      ("-3", "-0"),
      ("3", "0"),
      ("3", "-0"),
      ("3", "-Infinity"),
      ("-3", "-Infinity"),
      ("3", "Infinity"),
      ("-3", "Infinity"),
      ("Infinity", "7"),
      ("-Infinity", "7"),
      ("Infinity", "-7"),
      ("-Infinity", "-7"),
      ("Infinity", "0"),
      ("-Infinity", "-0"),
      ("Infinity", "-Infinity"),
      ("-Infinity", "-Infinity"),
      ("Infinity", "Infinity"),
      ("-Infinity", "Infinity"),
    ] {
    let (y, x) = pair
    out.write_string(
      "atan2pi(\{y}, \{x}) = \{pii_all_modes("atan2pi", y, x)}\n",
    )
  }
  inspect(
    out.to_string(),
    content=(
      #|atan2pi(0, -0) = 1 -
      #|atan2pi(-0, -0) = -1 -
      #|atan2pi(0, 0) = 0 -
      #|atan2pi(-0, 0) = -0 -
      #|atan2pi(0, -5) = 1 -
      #|atan2pi(-0, -5) = -1 -
      #|atan2pi(0, 5) = 0 -
      #|atan2pi(-0, 5) = -0 -
      #|atan2pi(-3, 0) = -0.5 -
      #|atan2pi(-3, -0) = -0.5 -
      #|atan2pi(3, 0) = 0.5 -
      #|atan2pi(3, -0) = 0.5 -
      #|atan2pi(3, -Infinity) = 1 -
      #|atan2pi(-3, -Infinity) = -1 -
      #|atan2pi(3, Infinity) = 0 -
      #|atan2pi(-3, Infinity) = -0 -
      #|atan2pi(Infinity, 7) = 0.5 -
      #|atan2pi(-Infinity, 7) = -0.5 -
      #|atan2pi(Infinity, -7) = 0.5 -
      #|atan2pi(-Infinity, -7) = -0.5 -
      #|atan2pi(Infinity, 0) = 0.5 -
      #|atan2pi(-Infinity, -0) = -0.5 -
      #|atan2pi(Infinity, -Infinity) = 0.75 -
      #|atan2pi(-Infinity, -Infinity) = -0.75 -
      #|atan2pi(Infinity, Infinity) = 0.25 -
      #|atan2pi(-Infinity, Infinity) = -0.25 -
      #|
    ),
  )
}

///|
// oracle: A, S
// source: IEEE 754-2019 6.2.3 and 7.2: a NaN operand gives a NaN with the payload of an input NaN and a signaling NaN signals invalid operation; which operand's payload is taken when both are NaN (the first) and the sign carried are the library's convention (level S for those two details)
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "atan2Pi: quiet and signaling NaN operands" {
  let out = StringBuilder()
  for
    pair in [
      ("NaN5", "1"),
      ("1", "NaN6"),
      ("NaN5", "NaN6"),
      ("-sNaN3", "2"),
      ("2", "sNaN4"),
      ("NaN7", "Infinity"),
      ("0", "NaN8"),
    ] {
    let (y, x) = pair
    out.write_string(
      "atan2pi(\{y}, \{x}) = \{pii_all_modes("atan2pi", y, x)}\n",
    )
  }
  inspect(
    out.to_string(),
    content=(
      #|atan2pi(NaN5, 1) = nan5 -
      #|atan2pi(1, NaN6) = nan6 -
      #|atan2pi(NaN5, NaN6) = nan5 -
      #|atan2pi(-sNaN3, 2) = -nan3 v
      #|atan2pi(2, sNaN4) = nan4 v
      #|atan2pi(NaN7, Infinity) = nan7 -
      #|atan2pi(0, NaN8) = nan8 -
      #|
    ),
  )
}

///|
// oracle: A
// source: mathematics: atan(1) = pi/4, so atan2Pi(y, x) is +-1/4 for x > 0 and +-3/4 for x < 0 when |y| = |x| (also for different cohorts of the same value); exact, so no flags; written out
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "atan2Pi: |y| = |x| is exactly +-1/4 or +-3/4 (Niven)" {
  let out = StringBuilder()
  for
    pair in [
      ("1", "1"),
      ("-1", "1"),
      ("1", "-1"),
      ("-1", "-1"),
      ("2.50", "2.5"),
      ("-7E+100", "-7000E+97"),
      ("3E-300", "-30E-301"),
      ("9.99", "-9.990000"),
    ] {
    let (y, x) = pair
    out.write_string(
      "atan2pi(\{y}, \{x}) = \{pii_all_modes("atan2pi", y, x)}\n",
    )
  }
  inspect(
    out.to_string(),
    content=(
      #|atan2pi(1, 1) = 0.25 -
      #|atan2pi(-1, 1) = -0.25 -
      #|atan2pi(1, -1) = 0.75 -
      #|atan2pi(-1, -1) = -0.75 -
      #|atan2pi(2.50, 2.5) = 0.25 -
      #|atan2pi(-7E+100, -7000E+97) = -0.75 -
      #|atan2pi(3E-300, -30E-301) = 0.75 -
      #|atan2pi(9.99, -9.990000) = 0.75 -
      #|
    ),
  )
}

///|
// oracle: A
// source: IEEE 754-2019 9.2.2 (preferred exponent 0, from the PDF text) and arithmetic: 1/2, 1, 1/4 and 3/4 at exponent 0 are 0.5, 1, 0.25, 0.75; at precision 1 the value 0.75 rounds to 0.8 and 0.25 to 0.2 under ties-to-even (inexact); at precision 2 they are exact
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "exact results are at the preferred exponent 0 (9.2.2)" {
  // 9.2.2: "the preferred exponent for asinPi, ... is 0 (Q(f(x)) = 0)": 1/2 is
  // 5E-1, 1/4 is 25E-2, 3/4 is 75E-2 and 1 is 1, never a shorter or longer
  // cohort member; a context too narrow for them rounds (with Inexact).
  let wide = DecimalContext::decimal128()
  let out = StringBuilder()
  out.write_string("asinpi(1) = \{pii_call("asinpi", "1", "", wide)}\n")
  out.write_string("acospi(0) = \{pii_call("acospi", "0", "", wide)}\n")
  out.write_string("acospi(-1) = \{pii_call("acospi", "-1", "", wide)}\n")
  out.write_string("atanpi(1) = \{pii_call("atanpi", "1", "", wide)}\n")
  out.write_string("atan2pi(1, -1) = \{pii_call("atan2pi", "1", "-1", wide)}\n")
  for precision in [1, 2] {
    let ctx = pm1_ctx(precision, "half_even", -383, 384, true, "b")
    out.write_string(
      "p=\{precision} atan2pi(1, -1) = \{pii_call("atan2pi", "1", "-1", ctx)}\n",
    )
    out.write_string(
      "p=\{precision} atanpi(1) = \{pii_call("atanpi", "1", "", ctx)}\n",
    )
  }
  inspect(
    out.to_string(),
    content=(
      #|asinpi(1) = 0.5 -
      #|acospi(0) = 0.5 -
      #|acospi(-1) = 1 -
      #|atanpi(1) = 0.25 -
      #|atan2pi(1, -1) = 0.75 -
      #|p=1 atan2pi(1, -1) = 0.8 x
      #|p=1 atanpi(1) = 0.2 x
      #|p=2 atan2pi(1, -1) = 0.75 -
      #|p=2 atanpi(1) = 0.25 -
      #|
    ),
  )
}

///|
fn pii_anchor_cases() -> Array[(String, String, String)] {
  // (op, x, y): one result next to each anchor class.
  [
    ("atanpi", "1E+40", ""),
    ("atanpi", "-1E+40", ""),
    ("atanpi", "-7.3E+25", ""),
    ("acospi", "1E-40", ""),
    ("acospi", "-1E-40", ""),
    ("acospi", "3.5E-30", ""),
    ("atan2pi", "1E+40", "1"),
    ("atan2pi", "-1E+40", "1"),
    ("atan2pi", "1E+40", "-1"),
    ("atan2pi", "-1E+40", "-3"),
    ("atan2pi", "1", "1E+40"),
    ("atan2pi", "-1", "1E+40"),
    ("atan2pi", "1", "-1E+40"),
    ("atan2pi", "-1", "-1E+40"),
    ("atan2pi", "3E-60", "-2E+60"),
    ("atan2pi", "-3E-60", "-2E+60"),
    ("atan2pi", "3E+60", "-2E-60"),
    ("atan2pi", "-3E+60", "2E-60"),
  ]
}

///|
// oracle: S
// source: equivalence of the anchored fast paths with the plain Ziv loop (decimal_certified_unary_result and decimal_certified_binary_result with the interval atan, acos, try_atan2 and decimal_pi_ball), the general route they replace; value, flags and error compared, no expected value written out. The level A table of elementary_pi_inverse_rows_wbtest.mbt (MPFR 4.2.2 enclosures and Niven values, tools/generate_decimal_pi_inverse_rows.py) covers atanPi, acosPi and atan2Pi in every rounding direction, but the anchor operands of this block are not all rows of it
// shares: decimal_certified_unary_result, decimal_certified_binary_result, decimal_pi_ball and the interval functions (both sides use them)
test "anchored results agree with the certified loop in all modes and ranges" {
  // The anchor paths of atanPi (large |x|), acosPi (tiny |x|) and atan2Pi
  // (extreme ratios) are one-sided neighbours of 1/2 or 1. In every mode, on
  // both sides, they must equal what the plain Ziv loop certifies.
  let mut checked = 0
  for mode in pm1_modes {
    for precision in [1, 16] {
      for tininess in ["b"] {
        let ctx = pm1_ctx(precision, mode, -6143, 6144, true, tininess)
        for case_ in pii_anchor_cases() {
          let (op, x, y) = case_
          let value = pm1_exact(x)
          let plain = match op {
            "atanpi" =>
              decimal_certified_unary_result(value, ctx, op, fn(i) {
                Ok(i.atan().div(decimal_pi_ball(i.precision())))
              })
            "acospi" =>
              decimal_certified_unary_result(value, ctx, op, fn(i) {
                Ok(i.acos().div(decimal_pi_ball(i.precision())))
              })
            _ =>
              decimal_certified_binary_result(value, pm1_exact(y), ctx, op, fn(
                a,
                b,
              ) {
                a
                .try_atan2(b)
                .map(fn(t) { t.div(decimal_pi_ball(t.precision())) })
              })
          }
          let fast = match op {
            "atanpi" => value.try_atanpi_ctx(ctx)
            "acospi" => value.try_acospi_ctx(ctx)
            _ => value.try_atan2pi_ctx(pm1_exact(y), ctx)
          }
          match (plain, fast) {
            (Ok(a), Ok(b)) => {
              assert_eq(
                a.0.total_order_compare(b.0),
                0,
                msg="\{op} \{x} \{y} p=\{precision} \{mode}: \{a.0} vs \{b.0}",
              )
              assert_eq(
                pm1_flags_text(a.1),
                pm1_flags_text(b.1),
                msg="\{op} \{x} \{y} p=\{precision} \{mode}",
              )
              checked += 1
            }
            _ => fail("certification failure \{op} \{x} \{y} \{mode}")
          }
        }
      }
    }
  }
  assert_eq(checked, 8 * 2 * 18)
}

///|
// oracle: A
// source: CPython decimal at 300 digits (pi by Machin's formula, atan series): atanPi(1E+40) = 1/2 - atan(1E-40)/pi = 0.5 - 3.18E-41, acosPi(1E-40) = 1/2 - asin(1E-40)/pi and the atan2Pi neighbours of 1/2 and 1, rounded in the eight directions at 16 digits with decimal plus: all 16 lines agree with the table written out; every result is inexact
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "anchors: both sides in all eight modes (precision 16)" {
  // atanPi(1E+40) = 1/2 - 3.18E-41: below 1/2, so the directed modes that
  // round down give 0.4999999999999999 and the ones that round up give 0.5;
  // the mirror image for x < 0, and the acosPi and atan2Pi clusters.
  let out = StringBuilder()
  for mode in pm1_modes {
    let ctx = pm1_ctx(16, mode, -383, 384, true, "b")
    out.write_string(
      "\{mode}: atanpi(1E+40)=\{pii_call("atanpi", "1E+40", "", ctx)} atanpi(-1E+40)=\{pii_call("atanpi", "-1E+40", "", ctx)} acospi(1E-40)=\{pii_call("acospi", "1E-40", "", ctx)} acospi(-1E-40)=\{pii_call("acospi", "-1E-40", "", ctx)}\n",
    )
    out.write_string(
      "  atan2pi(1E+40,1)=\{pii_call("atan2pi", "1E+40", "1", ctx)} atan2pi(1E+40,-1)=\{pii_call("atan2pi", "1E+40", "-1", ctx)} atan2pi(-1E+40,-1)=\{pii_call("atan2pi", "-1E+40", "-1", ctx)} atan2pi(1,-1E+40)=\{pii_call("atan2pi", "1", "-1E+40", ctx)} atan2pi(-1,-1E+40)=\{pii_call("atan2pi", "-1", "-1E+40", ctx)} atan2pi(1,1E+40)=\{pii_call("atan2pi", "1", "1E+40", ctx)}\n",
    )
  }
  inspect(
    out.to_string(),
    content=(
      #|half_even: atanpi(1E+40)=0.5000000000000000 x atanpi(-1E+40)=-0.5000000000000000 x acospi(1E-40)=0.5000000000000000 x acospi(-1E-40)=0.5000000000000000 x
      #|  atan2pi(1E+40,1)=0.5000000000000000 x atan2pi(1E+40,-1)=0.5000000000000000 x atan2pi(-1E+40,-1)=-0.5000000000000000 x atan2pi(1,-1E+40)=1.000000000000000 x atan2pi(-1,-1E+40)=-1.000000000000000 x atan2pi(1,1E+40)=3.183098861837907E-41 x
      #|half_up: atanpi(1E+40)=0.5000000000000000 x atanpi(-1E+40)=-0.5000000000000000 x acospi(1E-40)=0.5000000000000000 x acospi(-1E-40)=0.5000000000000000 x
      #|  atan2pi(1E+40,1)=0.5000000000000000 x atan2pi(1E+40,-1)=0.5000000000000000 x atan2pi(-1E+40,-1)=-0.5000000000000000 x atan2pi(1,-1E+40)=1.000000000000000 x atan2pi(-1,-1E+40)=-1.000000000000000 x atan2pi(1,1E+40)=3.183098861837907E-41 x
      #|half_down: atanpi(1E+40)=0.5000000000000000 x atanpi(-1E+40)=-0.5000000000000000 x acospi(1E-40)=0.5000000000000000 x acospi(-1E-40)=0.5000000000000000 x
      #|  atan2pi(1E+40,1)=0.5000000000000000 x atan2pi(1E+40,-1)=0.5000000000000000 x atan2pi(-1E+40,-1)=-0.5000000000000000 x atan2pi(1,-1E+40)=1.000000000000000 x atan2pi(-1,-1E+40)=-1.000000000000000 x atan2pi(1,1E+40)=3.183098861837907E-41 x
      #|down: atanpi(1E+40)=0.4999999999999999 x atanpi(-1E+40)=-0.4999999999999999 x acospi(1E-40)=0.4999999999999999 x acospi(-1E-40)=0.5000000000000000 x
      #|  atan2pi(1E+40,1)=0.4999999999999999 x atan2pi(1E+40,-1)=0.5000000000000000 x atan2pi(-1E+40,-1)=-0.5000000000000000 x atan2pi(1,-1E+40)=0.9999999999999999 x atan2pi(-1,-1E+40)=-0.9999999999999999 x atan2pi(1,1E+40)=3.183098861837906E-41 x
      #|ceiling: atanpi(1E+40)=0.5000000000000000 x atanpi(-1E+40)=-0.4999999999999999 x acospi(1E-40)=0.5000000000000000 x acospi(-1E-40)=0.5000000000000001 x
      #|  atan2pi(1E+40,1)=0.5000000000000000 x atan2pi(1E+40,-1)=0.5000000000000001 x atan2pi(-1E+40,-1)=-0.5000000000000000 x atan2pi(1,-1E+40)=1.000000000000000 x atan2pi(-1,-1E+40)=-0.9999999999999999 x atan2pi(1,1E+40)=3.183098861837907E-41 x
      #|floor: atanpi(1E+40)=0.4999999999999999 x atanpi(-1E+40)=-0.5000000000000000 x acospi(1E-40)=0.4999999999999999 x acospi(-1E-40)=0.5000000000000000 x
      #|  atan2pi(1E+40,1)=0.4999999999999999 x atan2pi(1E+40,-1)=0.5000000000000000 x atan2pi(-1E+40,-1)=-0.5000000000000001 x atan2pi(1,-1E+40)=0.9999999999999999 x atan2pi(-1,-1E+40)=-1.000000000000000 x atan2pi(1,1E+40)=3.183098861837906E-41 x
      #|up: atanpi(1E+40)=0.5000000000000000 x atanpi(-1E+40)=-0.5000000000000000 x acospi(1E-40)=0.5000000000000000 x acospi(-1E-40)=0.5000000000000001 x
      #|  atan2pi(1E+40,1)=0.5000000000000000 x atan2pi(1E+40,-1)=0.5000000000000001 x atan2pi(-1E+40,-1)=-0.5000000000000001 x atan2pi(1,-1E+40)=1.000000000000000 x atan2pi(-1,-1E+40)=-1.000000000000000 x atan2pi(1,1E+40)=3.183098861837907E-41 x
      #|05up: atanpi(1E+40)=0.4999999999999999 x atanpi(-1E+40)=-0.4999999999999999 x acospi(1E-40)=0.4999999999999999 x acospi(-1E-40)=0.5000000000000001 x
      #|  atan2pi(1E+40,1)=0.4999999999999999 x atan2pi(1E+40,-1)=0.5000000000000001 x atan2pi(-1E+40,-1)=-0.5000000000000001 x atan2pi(1,-1E+40)=0.9999999999999999 x atan2pi(-1,-1E+40)=-0.9999999999999999 x atan2pi(1,1E+40)=3.183098861837906E-41 x
      #|
    ),
  )
}

///|
// oracle: A
// source: CPython decimal at 300 digits (pi by Machin's formula): x/pi for 1E-30 and 7E-9999 at 34 digits, 1/2 - x/pi at 34 digits for acosPi (0.4999999999999999999999999999996817 for 1E-30), and for 3E-1000000 and 1E-1999996 the subnormal results at e_max 999999 (31 digits for the first, 0E-1000031 for the second, flags inexact and underflow): all agree with the table written out
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "tiny and huge operands: relative width of the enclosure" {
  // asinPi and atanPi of a tiny x are x/pi (1 - O(x^2)): the result must
  // carry its full precision for the least legal operands, which the digit
  // count of the working precision does not cover by itself.
  let ctx = pm1_ctx(34, "half_even", -6143, 6144, true, "b")
  let out = StringBuilder()
  for x in ["1E-1999996", "-3E-1000000", "7E-9999", "1E-30"] {
    let wide = DecimalContext::new(precision=34, e_max=999999)
    out.write_string("asinpi(\{x}) = \{pii_call("asinpi", x, "", wide)}\n")
    out.write_string("atanpi(\{x}) = \{pii_call("atanpi", x, "", wide)}\n")
    out.write_string("acospi(\{x}) = \{pii_call("acospi", x, "", ctx)}\n")
  }
  inspect(
    out.to_string(),
    content=(
      #|asinpi(1E-1999996) = 0E-1000031 xu
      #|atanpi(1E-1999996) = 0E-1000031 xu
      #|acospi(1E-1999996) = 0.5000000000000000000000000000000000 x
      #|asinpi(-3E-1000000) = -9.549296585513720146133025802351E-1000001 xu
      #|atanpi(-3E-1000000) = -9.549296585513720146133025802351E-1000001 xu
      #|acospi(-3E-1000000) = 0.5000000000000000000000000000000000 x
      #|asinpi(7E-9999) = 2.228169203286534700764372687215201E-9999 x
      #|atanpi(7E-9999) = 2.228169203286534700764372687215201E-9999 x
      #|acospi(7E-9999) = 0.5000000000000000000000000000000000 x
      #|asinpi(1E-30) = 3.183098861837906715377675267450287E-31 x
      #|atanpi(1E-30) = 3.183098861837906715377675267450287E-31 x
      #|acospi(1E-30) = 0.4999999999999999999999999999996817 x
      #|
    ),
  )
}

///|
// oracle: S
// source: equivalence of the scaled evaluation with the plain certified loop (decimal_certified_unary_result and decimal_certified_binary_result with the interval asin, atan, try_atan2 and decimal_pi_ball), the general route it replaces; value, cohort and flags compared, no expected value written out. The level A table of elementary_pi_inverse_rows_wbtest.mbt (MPFR 4.2.2, tools/generate_decimal_pi_inverse_rows.py) has asinPi, atanPi and atan2Pi rows with operands of the order of E-300, but the operands E-120 and E-150 of this block are not rows of it
// shares: decimal_certified_unary_result, decimal_certified_binary_result, decimal_pi_ball and the interval functions (both sides use them)
test "tiny operands: the scaled evaluation equals the plain certified loop" {
  // For a tiny x the loop encloses (s / pi) (1 +- x^2) and shifts it by 10^adj;
  // the result, cohort and flags must be those of the unscaled enclosure.
  let mut checked = 0
  for mode in pm1_modes {
    for precision in [1, 16] {
      let ctx = pm1_ctx(precision, mode, -6143, 6144, true, "b")
      for x in ["1E-120", "-3.7E-150"] {
        let value = pm1_exact(x)
        let one = pm1_exact("1")
        let cases : Array[
          (
            String,
            Result[(Decimal, DecimalFlags), @def.ArithmeticError],
            Result[(Decimal, DecimalFlags), @def.ArithmeticError],
          ),
        ] = [
          (
            "asinpi",
            decimal_certified_unary_result(value, ctx, "asinpi", fn(i) {
              Ok(i.asin().div(decimal_pi_ball(i.precision())))
            }),
            value.try_asinpi_ctx(ctx),
          ),
          (
            "atanpi",
            decimal_certified_unary_result(value, ctx, "atanpi", fn(i) {
              Ok(i.atan().div(decimal_pi_ball(i.precision())))
            }),
            value.try_atanpi_ctx(ctx),
          ),
          (
            "atan2pi",
            decimal_certified_binary_result(value, one, ctx, "atan2pi", fn(
              a,
              b,
            ) {
              a
              .try_atan2(b)
              .map(fn(t) { t.div(decimal_pi_ball(t.precision())) })
            }),
            value.try_atan2pi_ctx(one, ctx),
          ),
        ]
        for case_ in cases {
          match (case_.1, case_.2) {
            (Ok(a), Ok(b)) => {
              assert_eq(
                a.0.total_order_compare(b.0),
                0,
                msg="\{case_.0} \{x} p=\{precision} \{mode}: \{a.0} vs \{b.0}",
              )
              assert_eq(pm1_flags_text(a.1), pm1_flags_text(b.1))
              checked += 1
            }
            _ => fail("certification failure \{case_.0} \{x} \{mode}")
          }
        }
      }
    }
  }
  assert_eq(checked, 8 * 2 * 2 * 3)
}

///|
// oracle: A
// source: CPython decimal plus on x/pi at precision 7, Emin -95 (Etiny -101) in the eight directions: 3E-101/pi = 9.55E-102 rounds to 1E-101 or 0 by direction, 1E-300/(1E+300 pi) rounds to 0 or 1E-101 by direction; all 48 values agree with the table written out; flags inexact and underflow (IEEE 754-2019 7.5)
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "underflow of the Pi functions follows the context (Table 9.1)" {
  // asinPi, atanPi and atan2Pi may underflow: x/pi for a tiny x is rounded by
  // the context like any inexact result.
  let out = StringBuilder()
  for mode in pm1_modes {
    let ctx = pm1_ctx(7, mode, -95, 96, true, "b")
    out.write_string(
      "\{mode}: \{pii_call("asinpi", "3E-101", "", ctx)} \{pii_call("asinpi", "-3E-101", "", ctx)} \{pii_call("atanpi", "3E-101", "", ctx)} \{pii_call("atan2pi", "-3E-101", "1", ctx)} \{pii_call("atan2pi", "1E-300", "1E+300", ctx)} \{pii_call("atan2pi", "-1E-300", "1E+300", ctx)}\n",
    )
  }
  inspect(
    out.to_string(),
    content=(
      #|half_even: 1E-101 xu -1E-101 xu 1E-101 xu -1E-101 xu 0E-101 xu -0E-101 xu
      #|half_up: 1E-101 xu -1E-101 xu 1E-101 xu -1E-101 xu 0E-101 xu -0E-101 xu
      #|half_down: 1E-101 xu -1E-101 xu 1E-101 xu -1E-101 xu 0E-101 xu -0E-101 xu
      #|down: 0E-101 xu -0E-101 xu 0E-101 xu -0E-101 xu 0E-101 xu -0E-101 xu
      #|ceiling: 1E-101 xu -0E-101 xu 1E-101 xu -0E-101 xu 1E-101 xu -0E-101 xu
      #|floor: 0E-101 xu -1E-101 xu 0E-101 xu -1E-101 xu 0E-101 xu -1E-101 xu
      #|up: 1E-101 xu -1E-101 xu 1E-101 xu -1E-101 xu 1E-101 xu -1E-101 xu
      #|05up: 1E-101 xu -1E-101 xu 1E-101 xu -1E-101 xu 1E-101 xu -1E-101 xu
      #|
    ),
  )
}

///|
// oracle: A
// source: arithmetic: asinPi(0.5) = 1/6 = 0.1666666666666667 and acosPi(0.5) = 1/3 = 0.3333333333333333 at 16 digits (asin(1/2) = pi/6, acos(1/2) = pi/3), atanPi(1) = 1/4, atan2Pi(-1, -1) = -3/4; the flag text for the first is inexact only
// shares: pii_call, pii_all_modes, pm1_exact (Decimal::from_string), pm1_ctx and pm1_flags_text (they build the operands, the contexts and print value and flags: Decimal::to_string), try_*_ctx (the code under test)
test "checked tier methods" {
  let ctx = DecimalContext::decimal64()
  let a = pm1_exact("0.5")
  let (value, flags) = a.asinpi_ctx(ctx)
  assert_eq(pm1_flags_text(flags), "x")
  assert_eq(value.to_string(), "0.1666666666666667")
  let (value, _) = a.acospi_ctx(ctx)
  assert_eq(value.to_string(), "0.3333333333333333")
  let (value, _) = pm1_exact("1").atanpi_ctx(ctx)
  assert_eq(value.to_string(), "0.25")
  let (value, _) = pm1_exact("-1").atan2pi_ctx(pm1_exact("-1"), ctx)
  assert_eq(value.to_string(), "-0.75")
}
