///|
fn from_binary_rows() -> Array[(String, Int32, Bool, Int32, String, String)] {
  let rows : Array[(String, Int32, Bool, Int32, String, String)] = []
  for row in from_binary_rows_0() {
    rows.push(row)
  }
  for row in from_binary_rows_1() {
    rows.push(row)
  }
  for row in from_binary_rows_2() {
    rows.push(row)
  }
  for row in from_binary_rows_3() {
    rows.push(row)
  }
  for row in from_binary_rows_4() {
    rows.push(row)
  }
  for row in from_binary_rows_5() {
    rows.push(row)
  }
  for row in from_binary_rows_6() {
    rows.push(row)
  }
  rows
}

