fn to_binary_rows() -> Array[(String, Int32, String, String, Int32)] {
  let rows : Array[(String, Int32, String, String, Int32)] = []
  for row in to_binary_rows_0() {
    rows.push(row)
  }
  for row in to_binary_rows_1() {
    rows.push(row)
  }
  for row in to_binary_rows_2() {
    rows.push(row)
  }
  for row in to_binary_rows_3() {
    rows.push(row)
  }
  for row in to_binary_rows_4() {
    rows.push(row)
  }
  for row in to_binary_rows_5() {
    rows.push(row)
  }
  for row in to_binary_rows_6() {
    rows.push(row)
  }
  for row in to_binary_rows_7() {
    rows.push(row)
  }
  rows
}
