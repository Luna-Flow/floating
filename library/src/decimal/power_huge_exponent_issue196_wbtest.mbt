    ("7.5", "-1E+4100", Ceiling, "1E-398", "x...u"),
    ("7.5", "-1E+4100", Up, "1E-398", "x...u"),
    ("7.5", "-1E+4100", Down, "0E-398", "x...u"),
    ("7.5", "-1E+400000", HalfEven, "0E-398", "x...u"),
    ("7.5", "-1E+400000", Floor, "0E-398", "x...u"),
    ("7.5", "-1E+400000", Ceiling, "1E-398", "x...u"),
    ("7.5", "-1E+400000", Up, "1E-398", "x...u"),
    ("7.5", "-1E+400000", Down, "0E-398", "x...u"),
    ("7.5", "1" + "0".repeat(4100), HalfEven, "inf", "x..o."),
    ("7.5", "1" + "0".repeat(4100), Floor, "9.999999999999999E+384", "x..o."),
    ("7.5", "1" + "0".repeat(4100), Ceiling, "inf", "x..o."),
    ("7.5", "1" + "0".repeat(4100), Up, "inf", "x..o."),
    ("7.5", "1" + "0".repeat(4100), Down, "9.999999999999999E+384", "x..o."),
    ("7.5", "3E+100000", HalfEven, "inf", "x..o."),
    ("7.5", "3E+100000", Floor, "9.999999999999999E+384", "x..o."),
    ("7.5", "3E+100000", Ceiling, "inf", "x..o."),
    ("7.5", "3E+100000", Up, "inf", "x..o."),
    ("7.5", "3E+100000", Down, "9.999999999999999E+384", "x..o."),
    ("7.5", "-7E+99999", HalfEven, "0E-398", "x...u"),
    ("7.5", "-7E+99999", Floor, "0E-398", "x...u"),
    ("7.5", "-7E+99999", Ceiling, "1E-398", "x...u"),
    ("7.5", "-7E+99999", Up, "1E-398", "x...u"),
    ("7.5", "-7E+99999", Down, "0E-398", "x...u"),
  ]
  for row in rows {
    let (base, exponent, mode, expected, expected_flags) = row
    let ctx = { ..context, decimal_rounding: mode, }
    let (value, flags) = Decimal::from_string(base)
      .unwrap()
      .pow_ctx(Decimal::from_string(exponent).unwrap(), ctx)
    assert_eq(
      (base, exponent.length(), value.to_string(), issue196_flags(flags)),
      (base, exponent.length(), expected, expected_flags),
    )
  }
}
