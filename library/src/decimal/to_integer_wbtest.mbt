///|
/// `to_int_ctx`, `to_int64_ctx`, `to_uint_ctx` and `to_uint64_ctx`, IEEE
/// 754-2019 §5.4.1 and §5.8 ("Conversion to integer shall round as specified in
/// Clause 4; the rounding direction is indicated by the operation name"; "the
/// invalid operation exception shall be signaled" for a NaN, an infinity and an
/// operand outside the range of the destination format; the `Exact` operations
/// signal inexact when the result differs from the operand). The expected rows
/// come from the generator of the issue (exact rational arithmetic with Python
/// `Fraction`, one rounding function per direction, not from this library):
/// `value, mode, Int, Int64, UInt, UInt64 results ("none" = out of range or
/// not a number) and whether rounding changed the value`.

///|
fn issue226_mode(name : String) -> DecimalRoundingMode {
  match name {
    "half_even" => HalfEven
    "half_up" => HalfUp
    "half_down" => HalfDown
    "down" => Down
    "up" => Up
    "ceiling" => Ceiling
    "floor" => Floor
    "05up" => ZeroFiveUp
    _ => abort("unexpected rounding mode \{name}")
  }
}

///|
fn issue226_text(value : String?) -> String {
  match value {
    Some(text) => text
    None => "none"
  }
}

///|
fn issue226_flags_text(flags : DecimalFlags) -> String {
  (if flags.inexact { "x" } else { "." }) +
  (if flags.rounded { "r" } else { "." }) +
  (if flags.lost_digits { "l" } else { "." }) +
  (if flags.invalid_operation { "i" } else { "." }) +
  (if flags.division_by_zero { "z" } else { "." }) +
  (if flags.overflow { "o" } else { "." }) +
  (if flags.underflow { "u" } else { "." }) +
  (if flags.subnormal { "s" } else { "." }) +
  (if flags.clamped { "c" } else { "." })
}

///|
fn issue226_check_flags(
  label : String,
  flags : DecimalFlags,
  valid : Bool,
  changed : Bool,
  exact : Bool,
) -> Unit raise {
  let expected = DecimalFlags::{
    ..DecimalFlags::new(),
    invalid_operation: !valid,
    inexact: valid && changed && exact,
  }
  assert_eq(
    (label, issue226_flags_text(flags)),
    (label, issue226_flags_text(expected)),
  )
}

///|
test "convertToInteger rounds in every direction with the exact flags (IEEE 754-2019 5.8)" {
  for row in issue226_rows {
    let (text, mode, i32, i64, u32, u64, changed) = row
    let value = Decimal::from_string(text).unwrap()
    let ctx = DecimalContext::new(
      precision=16,
      decimal_rounding=issue226_mode(mode),
      e_min=-383,
      e_max=384,
    )
    for exact in [false, true] {
      let label = "\{text} \{mode} exact=\{exact}"
      let (a, fa) = value.to_int_ctx(ctx, exact~)
      assert_eq(
        (label + " int", issue226_text(a.map(x => x.to_string()))),
        (label + " int", i32),
      )
      issue226_check_flags(label + " int", fa, i32 != "none", changed, exact)
      let (b, fb) = value.to_int64_ctx(ctx, exact~)
      assert_eq(
        (label + " int64", issue226_text(b.map(x => x.to_string()))),
        (label + " int64", i64),
      )
      issue226_check_flags(label + " int64", fb, i64 != "none", changed, exact)
      let (c, fc) = value.to_uint_ctx(ctx, exact~)
      assert_eq(
        (label + " uint", issue226_text(c.map(x => x.to_string()))),
        (label + " uint", u32),
      )
      issue226_check_flags(label + " uint", fc, u32 != "none", changed, exact)
      let (d, fd) = value.to_uint64_ctx(ctx, exact~)
      assert_eq(
        (label + " uint64", issue226_text(d.map(x => x.to_string()))),
        (label + " uint64", u64),
      )
      issue226_check_flags(label + " uint64", fd, u64 != "none", changed, exact)
    }
  }
}

///|
test "convertToInteger ignores the precision and the exponent range of the context" {
  // A context with precision 3 does not round the integer: 123456 stays.
  let ctx = DecimalContext::new(precision=3)
  let (value, flags) = Decimal::from_string("123456")
    .unwrap()
    .to_int_ctx(ctx, exact=true)
  assert_eq(value, Some(123456))
  assert_eq(issue226_flags_text(flags), ".........")
}

