///|
/// IEEE 754-2019 §5.4.2 convertFormat and §6.2.3 NaN propagation for
/// `Decimal::convert_format`, `Decimal::from_binary_ctx` and
/// `Decimal::to_binary_ctx`. The rows are in `convert_format_rows_wbtest.mbt`
/// (generated by `tools/generate_decimal_conversion_rows.py`): rows of the MPFR
/// 4.2.2 corpora (`mpfr_strtofr`, `mpfr_get_str`) and rows from exact integer
/// arithmetic for every pair of decimal32/64/128 and binary16/32/64/128 and
/// every IEEE rounding direction.

///|
fn convert_binary_mode(name : String) -> @binary.BinaryRoundingMode {
  match name {
    "n" | "ties_even" => @binary.BinaryRoundingMode::RoundTiesToEven
    "na" | "ties_away" => @binary.BinaryRoundingMode::RoundTiesToAway
    "z" | "toward_zero" => @binary.BinaryRoundingMode::RoundTowardZero
    "u" | "toward_positive" => @binary.BinaryRoundingMode::RoundTowardPositive
    "d" | "toward_negative" => @binary.BinaryRoundingMode::RoundTowardNegative
    _ => abort("unexpected binary rounding mode \{name}")
  }
}

///|
fn convert_decimal_mode(name : String) -> DecimalRound {
  match name {
    "n" | "half_even" => HalfEven
    "na" | "half_up" => HalfUp
    "z" | "down" => Down
    "u" | "ceiling" => Ceiling
    "d" | "floor" => Floor
    "a" | "up" => Up
    _ => abort("unexpected decimal rounding mode \{name}")
  }
}

///|
fn convert_binary_context(
  format : String,
  mode : String,
) -> @binary.BinaryContext {
  let rounding = convert_binary_mode(mode)
  match format {
    "binary16" => @binary.BinaryContext::binary16(rounding~)
    "binary32" => @binary.BinaryContext::binary32(rounding~)
    "binary64" => @binary.BinaryContext::binary64(rounding~)
    "binary128" => @binary.BinaryContext::binary128(rounding~)
    _ => abort("unexpected binary format \{format}")
  }
}

///|
fn convert_decimal_context(format : String, mode : String) -> DecimalContext {
  let (precision, e_max) = match format {
    "decimal32" => (7, 96)
    "decimal64" => (16, 384)
    "decimal128" => (34, 6144)
    _ => abort("unexpected decimal format \{format}")
  }
  DecimalContext::new(precision~, e_max~).with_round(convert_decimal_mode(mode))
}

///|
fn convert_interchange_format(format : String) -> DecimalInterchangeFormat {
  match format {
    "decimal32" => Decimal32
    "decimal64" => Decimal64
    "decimal128" => Decimal128
    _ => abort("unexpected decimal format \{format}")
  }
}

///|
fn convert_binary_matches(
  label : String,
  expected : String,
  precision : Int32,
  actual : @binary.Binary,
) -> Unit raise {
  match expected {
    "+inf" => {
      assert_true(actual.classify() == FpClass::Infinity, msg=label)
      assert_false(actual.is_sign_minus(), msg=label)
    }
    "-inf" => {
      assert_true(actual.classify() == FpClass::Infinity, msg=label)
      assert_true(actual.is_sign_minus(), msg=label)
    }
    "0" => {
      assert_true(actual.is_zero(), msg=label)
      assert_false(actual.is_sign_minus(), msg=label)
    }
    "-0" => {
      assert_true(actual.is_zero(), msg=label)
      assert_true(actual.is_sign_minus(), msg=label)
    }
    _ => {
      let value = @binary.Binary::from_hex(expected, precision).unwrap()
      assert_true(
        value.identical(actual),
        msg="\{label}: \{actual.to_hex()} != \{expected}",
      )
    }
  }
}

///|
// oracle: A
// source: table mpfr_strtofr_rows generated by tools/generate_decimal_conversion_rows.py (the committed table is an earlier output of the script: its current output has more MPFR rows and --check reports the file stale, see the pull request) from the committed MPFR 4.2.2 corpus testdata/binary/mpfr-4.2.2-strtofr.txt (every fourth row of each cell): the expected binary value and the inexact, overflow and underflow flags are MPFR's mpfr_strtofr results
// shares: Decimal::from_string (builds the operand), Binary::from_hex, identical, classify, is_zero and is_sign_minus (read the expected value in convert_binary_matches), to_binary_ctx (the code under test)
test "decimal to binary: the MPFR mpfr_strtofr rows" {
  for row in mpfr_strtofr_rows {
    let (literal, precision, mode, expected, inexact, overflow, underflow) = row
    let value = Decimal::from_string(literal, precision=200).unwrap()
    let context = @binary.BinaryContext::new(
      precision~,
      rounding=convert_binary_mode(mode),
    )
    let (actual, flags) = value.to_binary_ctx(context)
    let label = "\{literal} p\{precision} \{mode}"
    convert_binary_matches(label, expected, precision, actual)
    assert_eq((label, flags.inexact()), (label, inexact))
    assert_eq((label, flags.overflow()), (label, overflow))
    assert_eq((label, flags.underflow()), (label, underflow))
    assert_false(flags.invalid_operation(), msg=label)
  }
}

///|
// oracle: A
// source: table mpfr_getstr_rows generated by tools/generate_decimal_conversion_rows.py (the committed table is an earlier output of the script: its current output has more MPFR rows and --check reports the file stale, see the pull request) from the committed MPFR 4.2.2 corpus testdata/binary/mpfr-4.2.2-decimal-output.txt (every fourth row): the digits, the exponent and the inexact flag are MPFR's mpfr_get_str result, the cohort member of an exact row comes from the preferred-exponent search in Python integers
// shares: Binary::from_hex (builds the operand), coeff_bigint and to_string (read the result), from_binary_ctx (the code under test)
test "binary to decimal: the MPFR mpfr_get_str rows" {
  for row in mpfr_getstr_rows {
    let (
      digits,
      precision,
      mode,
      value,
      expected_digits,
      expected_exponent,
      inexact,
      cohort_coefficient,
      cohort_exponent,
      _cohort_rounded,
    ) = row
    let x = @binary.Binary::from_hex(value, precision).unwrap()
    let context = DecimalContext::new(precision=digits, e_max=999_999_999).with_round(
      convert_decimal_mode(mode),
    )
    let (actual, flags) = Decimal::from_binary_ctx(x, context)
    let label = "\{value} n\{digits} \{mode}"
    let text = coeff_bigint(actual.coefficient).to_string()
    let adjusted = actual.exponent10 + text.length() - 1
    // MPFR pads the digits to n; the preferred exponent of an exact result keeps
    // fewer digits, so the trailing zeros are compared away.
    let strip = fn(s : String) {
      let mut end = s.length()
      while end > 1 && s[end - 1] == '0' {
        end = end - 1
      }
      s[0:end].to_owned()
    }
    // MPFR pads the digits to n: compare the digits with the zeros stripped and
    // the adjusted exponent; for an exact row also the cohort member itself
    // (coefficient and exponent), which MPFR's padding hides.
    assert_eq((label, strip(text)), (label, strip(expected_digits)))
    assert_eq((label, adjusted), (label, expected_exponent))
    assert_eq((label, flags.inexact), (label, inexact))
    if !inexact {
      assert_eq(
        (label, text, actual.exponent10),
        (label, cohort_coefficient, cohort_exponent),
      )
    }
    assert_eq((label, actual.negative), (label, x.is_sign_minus()))
  }
}

///|
// oracle: A
// source: table decimal_to_binary_rows generated by tools/generate_decimal_conversion_rows.py (the committed table is an earlier output of the script: its current output has more MPFR rows and --check reports the file stale, see the pull request): every pair of decimal32/64/128 text and binary16/32/64/128 with the five IEEE rounding directions, the expected value and flags computed by exact integer arithmetic (fractions.Fraction) in the script, independent of the library, with the MPFR rows as the cross-check of the rounding core
// shares: Decimal::from_string (builds the operand), Binary::from_hex, identical, classify and is_sign_minus (read the expected value in convert_binary_matches), to_binary_ctx (the code under test)
test "decimal to binary: every format pair and rounding direction (IEEE 754-2019 5.4.2)" {
  for row in decimal_to_binary_rows {
    let (text, format, mode, expected, inexact, overflow, underflow) = row
    let value = Decimal::from_string(text, precision=200).unwrap()
    let context = convert_binary_context(format, mode)
    let (actual, flags) = value.to_binary_ctx(context)
    let label = "\{text} \{format} \{mode}"
    convert_binary_matches(label, expected, context.precision(), actual)
    assert_eq((label, flags.inexact()), (label, inexact))
    assert_eq((label, flags.overflow()), (label, overflow))
    assert_eq((label, flags.underflow()), (label, underflow))
    assert_false(flags.invalid_operation(), msg=label)
  }
}

///|
// oracle: A
// source: table binary_to_decimal_rows generated by tools/generate_decimal_conversion_rows.py (the committed table is an earlier output of the script: its current output has more MPFR rows and --check reports the file stale, see the pull request): every pair of binary16/32/64/128 hex value and decimal32/64/128 with the five rounding directions, the coefficient, the exponent (the preferred exponent rule), the sign and the flags computed by exact integer arithmetic in the script, independent of the library
// shares: Binary::from_hex (builds the operand), coeff_bigint and to_string (read the result), from_binary_ctx (the code under test)
test "binary to decimal: every format pair and rounding direction, preferred exponent (IEEE 754-2019 5.4.2)" {
  for row in binary_to_decimal_rows {
    let (
      hexa,
      format,
      mode,
      shape,
      coefficient,
      exponent,
      negative,
      inexact,
      overflow,
      underflow,
    ) = row
    let x = @binary.Binary::from_hex(hexa, 256).unwrap()
    let context = convert_decimal_context(format, mode)
    let (actual, flags) = Decimal::from_binary_ctx(x, context)
    let label = "\{hexa} \{format} \{mode}"
    if shape == "inf" {
      assert_true(actual.is_infinite(), msg=label)
      assert_eq((label, actual.negative), (label, negative))
    } else {
      assert_eq(
        (label, coeff_bigint(actual.coefficient).to_string(), actual.exponent10),
        (label, coefficient, exponent),
      )
      assert_eq((label, actual.negative), (label, negative))
    }
    assert_eq((label, flags.inexact), (label, inexact))
    assert_eq((label, flags.overflow), (label, overflow))
    assert_eq((label, flags.underflow), (label, underflow))
    assert_false(flags.invalid_operation, msg=label)
  }
}

///|
// oracle: A
// source: table convert_format_rows generated by tools/generate_decimal_conversion_rows.py (the committed table is an earlier output of the script: its current output has more MPFR rows and --check reports the file stale, see the pull request): decimal to decimal conversions with the preferred exponent Q(source), cohort and exponent-range cases, the coefficient, exponent, sign and flags computed by exact integer arithmetic (decimal_convert) in the script, independent of the library
// shares: Decimal::from_string (builds the operand), coeff_bigint and to_string (read the result), convert_format (the code under test)
test "decimal to decimal: convertFormat keeps the quantum of the source (IEEE 754-2019 5.4.2)" {
  for row in convert_format_rows {
    let (
      text,
      format,
      shape,
      coefficient,
      exponent,
      negative,
      inexact,
      overflow,
      underflow,
    ) = row
    let value = Decimal::from_string(text, precision=200).unwrap()
    let (actual, flags) = value.convert_format(
      convert_interchange_format(format),
    )
    let label = "\{text} to \{format}"
    if shape == "inf" {
      assert_true(actual.is_infinite(), msg=label)
      assert_eq((label, actual.negative), (label, negative))
    } else {
      assert_eq(
        (label, coeff_bigint(actual.coefficient).to_string(), actual.exponent10),
        (label, coefficient, exponent),
      )
      assert_eq((label, actual.negative), (label, negative))
    }
    assert_eq((label, flags.inexact), (label, inexact))
    assert_eq((label, flags.overflow), (label, overflow))
    assert_eq((label, flags.underflow), (label, underflow))
    assert_false(flags.invalid_operation, msg=label)
  }
}

///|
// oracle: A, S
// source: IEEE 754-2019 6.2.3 and 5.4.2: a signaling NaN gives a quiet NaN and invalid operation, a quiet NaN keeps its sign and payload when the destination can hold it (decimal32 6 digits, decimal64 15, decimal128 33, binary16 9 bits, 3.5.2 and 3.4); the reduction of a payload that does not fit to its low digits or bits (1234567 to 234567, 517 to 5) is the library's convention (level S); written out
// shares: Decimal::quiet_nan, signaling_nan, Binary::quiet_nan and signaling_nan (build the operands), nan_payload, is_nan and is_signaling_nan (read the results), convert_format, to_binary_ctx and from_binary_ctx (the code under test)
test "convertFormat of NaNs: payload, sign and the signaling exception (IEEE 754-2019 6.2.3)" {
  // decimal to decimal: the payload is kept when the destination holds p - 1 digits
  let quiet = Decimal::quiet_nan(
    payload=BigInt::from_int(123456),
    negative=true,
  )
  let (narrow, flags) = quiet.convert_format(Decimal32)
  assert_true(narrow.is_nan())
  assert_false(narrow.is_signaling_nan())
  assert_true(narrow.negative)
  assert_eq(narrow.nan_payload(), BigInt::from_int(123456))
  assert_false(flags.invalid_operation)
  // a payload beyond p - 1 = 6 digits is reduced to its low digits
  let wide = Decimal::quiet_nan(payload=BigInt::from_int(1234567))
  assert_eq(
    wide.convert_format(Decimal32).0.nan_payload(),
    BigInt::from_int(234567),
  )
  assert_eq(
    wide.convert_format(Decimal64).0.nan_payload(),
    BigInt::from_int(1234567),
  )
  // a signaling NaN gives a quiet NaN and the invalid operation exception
  let signaling = Decimal::signaling_nan(payload=BigInt::from_int(42))
  let (result, flags) = signaling.convert_format(Decimal128)
  assert_true(result.is_nan())
  assert_false(result.is_signaling_nan())
  assert_eq(result.nan_payload(), BigInt::from_int(42))
  assert_true(flags.invalid_operation)
  // decimal to binary: the payload is kept when the destination holds p - 2 bits
  let context = @binary.BinaryContext::binary16()
  let (kept, flags) = Decimal::quiet_nan(
    payload=BigInt::from_int(300),
    negative=true,
  ).to_binary_ctx(context)
  assert_true(kept.classify() == FpClass::NaN)
  assert_true(kept.is_sign_minus())
  assert_eq(kept.nan_payload().to_string(), "300")
  assert_false(flags.invalid_operation())
  // binary16 holds 9 payload bits: 512 + 5 keeps its low 9 bits
  let (reduced, _) = Decimal::quiet_nan(payload=BigInt::from_int(517)).to_binary_ctx(
    context,
  )
  assert_eq(reduced.nan_payload().to_string(), "5")
  let (quiet_result, flags) = Decimal::signaling_nan(
    payload=BigInt::from_int(7),
  ).to_binary_ctx(context)
  assert_true(quiet_result.classify() == FpClass::NaN)
  assert_false(quiet_result.is_signaling_nan())
  assert_true(flags.invalid_operation())
  // binary to decimal
  let binary_nan = @binary.Binary::quiet_nan(
    payload=@binary.BinCoeff::from_uint64(300UL),
    negative=true,
    precision=11,
  )
  let (decimal_nan, flags) = Decimal::from_binary_ctx(
    binary_nan,
    DecimalContext::decimal64(),
  )
  assert_true(decimal_nan.is_nan())
  assert_true(decimal_nan.negative)
  assert_eq(decimal_nan.nan_payload(), BigInt::from_int(300))
  assert_false(flags.invalid_operation)
  let (from_signaling, flags) = Decimal::from_binary_ctx(
    @binary.Binary::signaling_nan(precision=24),
    DecimalContext::decimal32(),
  )
  assert_false(from_signaling.is_signaling_nan())
  assert_true(flags.invalid_operation)
}

///|
// oracle: A
// source: IEEE 754-2019 5.4.2 and 6.3: convertFormat of an infinity or a zero is the infinity or the zero of the same sign, exact (no inexact flag); a decimal negative zero converts to a negative zero of the other radix with preferred exponent 0; written out
// shares: Decimal::inf and negative_zero and Binary::inf and negative_zero (build the operands), classify, is_sign_minus and is_negative_zero (read the results), to_binary_ctx and from_binary_ctx (the code under test)
test "convertFormat of infinities and zeros keeps the sign" {
  let b64 = @binary.BinaryContext::binary64()
  let (inf, flags) = Decimal::inf(negative=true).to_binary_ctx(b64)
  assert_true(inf.classify() == FpClass::Infinity && inf.is_sign_minus())
  assert_false(flags.inexact())
  let (zero, flags) = Decimal::negative_zero().to_binary_ctx(b64)
  assert_true(zero.is_negative_zero())
  assert_false(flags.inexact())
  let d64 = DecimalContext::decimal64()
  let (decimal_inf, _) = Decimal::from_binary_ctx(
    @binary.Binary::inf(negative=true, precision=53),
    d64,
  )
  assert_true(decimal_inf.is_infinite() && decimal_inf.negative)
  let (negative_zero, flags) = Decimal::from_binary_ctx(
    @binary.Binary::negative_zero(precision=53),
    d64,
  )
  assert_true(negative_zero.negative && negative_zero.coefficient.is_zero())
  assert_eq(negative_zero.exponent10, 0)
  assert_false(flags.inexact)
}

///|
// oracle: A
// source: table exact_cohort_rows generated by tools/generate_decimal_conversion_rows.py (the committed table is an earlier output of the script: its current output has more MPFR rows and --check reports the file stale, see the pull request): exact binary values c * 5^k * 2^k = c * 10^k at precision 7, 16 and 34, the expected cohort member (coefficient, exponent, rounded flag) from exact_cohort, a search over the exponents by the rule of 5.4.2 and 5.2 in Python integers
// shares: Binary::from_hex (builds the operand), coeff_bigint and to_string (read the result), from_binary_ctx (the code under test)
test "binary to decimal: an exact conversion returns the cohort member closest to the preferred exponent 0 (IEEE 754-2019 5.4.2, 5.2)" {
  for row in exact_cohort_rows {
    let (hexa, precision, coefficient, exponent, negative, _rounded) = row
    let x = @binary.Binary::from_hex(hexa, 20000).unwrap()
    let context = DecimalContext::new(precision~, e_max=999_999)
    let (actual, flags) = Decimal::from_binary_ctx(x, context)
    let label = "\{hexa} p\{precision}"
    // coefficient, exponent, sign and every flag, no stripping
    assert_eq(
      (
        label,
        coeff_bigint(actual.coefficient).to_string(),
        actual.exponent10,
        actual.negative,
      ),
      (label, coefficient, exponent, negative),
    )
    assert_eq(
      (
        label,
        flags.inexact,
        flags.overflow,
        flags.underflow,
        flags.invalid_operation,
      ),
      (label, false, false, false, false),
    )
  }
}

///|
fn convert_identical_to_exact_expansion(
  label : String,
  x : @binary.Binary,
  context : DecimalContext,
) -> Unit raise {
  // The previous implementation: the exact expansion `c * 5^k * 10^-k` rounded by `apply_ctx`.
  let (old, old_flags) = decimal_exact_from_binary(x).apply_ctx(context)
  let (new, new_flags) = Decimal::from_binary_ctx(x, context)
  assert_eq(
    (
      label,
      coeff_bigint(new.coefficient).to_string(),
      new.exponent10,
      new.negative,
    ),
    (
      label,
      coeff_bigint(old.coefficient).to_string(),
      old.exponent10,
      old.negative,
    ),
  )
  assert_true(new_flags == old_flags, msg=label + " flags")
}

///|
// oracle: S
// source: equivalence of Decimal::from_binary_ctx (the bounded surrogate route) with decimal_exact_from_binary(x).apply_ctx(context) (the exact expansion c * 5^k rounded once) on every row of exact_cohort_rows, mpfr_getstr_rows and binary_to_decimal_rows; no expected value is written out, the correct values of those rows are level A in the blocks above and of the bounded route in from_binary_bounded_issue467_wbtest.mbt
// shares: decimal_exact_from_binary, apply_ctx and Decimal::from_binary_ctx (both routes are library code), Binary::from_hex (builds the operand)
test "binary to decimal: the surrogate path equals the exact expansion on every row, cohort and flags included" {
  for row in exact_cohort_rows {
    let (hexa, precision, _, _, _, _) = row
    let x = @binary.Binary::from_hex(hexa, 20000).unwrap()
    let context = DecimalContext::new(precision~, e_max=999_999)
    convert_identical_to_exact_expansion("cohort " + hexa, x, context)
  }
  for row in mpfr_getstr_rows {
    let (digits, precision, mode, value, _, _, _, _, _, _) = row
    let x = @binary.Binary::from_hex(value, precision).unwrap()
    let context = DecimalContext::new(precision=digits, e_max=999_999_999).with_round(
      convert_decimal_mode(mode),
    )
    convert_identical_to_exact_expansion("getstr " + value, x, context)
  }
  for row in binary_to_decimal_rows {
    let (hexa, format, mode, _, _, _, _, _, _, _) = row
    let x = @binary.Binary::from_hex(hexa, 256).unwrap()
    convert_identical_to_exact_expansion(
      "pair " + hexa + " " + format,
      x,
      convert_decimal_context(format, mode),
    )
  }
}

///|
// oracle: A
// source: table large_binary_rows generated by tools/generate_decimal_conversion_rows.py (the committed table is an earlier output of the script: its current output has more MPFR rows and --check reports the file stale, see the pull request): mantissa * 2^exponent for exponents up to +-10^9, correctly rounded with CPython decimal at precision + 80 digits in six directions, kept only when the digits after the kept ones are neither all zero nor all nine
// shares: Binary::from_hex (builds the operand), coeff_bigint and to_string (read the result), from_binary_ctx (the code under test)
test "binary to decimal: values beyond a binary exponent of 2^22 are correctly rounded (issue 423)" {
  for row in large_binary_rows {
    let (hexa, precision, mode, coefficient, exponent, negative) = row
    let x = @binary.Binary::from_hex(hexa, 128).unwrap()
    let context = DecimalContext::new(precision~, e_max=999_999_999).with_round(
      convert_decimal_mode(mode),
    )
    let (actual, flags) = Decimal::from_binary_ctx(x, context)
    let label = "\{hexa} p\{precision} \{mode}"
    assert_eq(
      (
        label,
        coeff_bigint(actual.coefficient).to_string(),
        actual.exponent10,
        actual.negative,
      ),
      (label, coefficient, exponent, negative),
    )
    assert_true(flags.inexact, msg=label)
  }
}

///|
// oracle: A
// source: CPython decimal at 60 digits: 2^5000000 = 9.513052773090666E+1505149 at 16 digits (5000000 log10 2 = 1505149.978...), inexact; written out; beyond the range of decimal64 (e_max 384) the value overflows (IEEE 754-2019 7.4)
// shares: Binary::make and BinCoeff::one (build the operand), Decimal::to_string, from_binary_ctx (the code under test)
test "binary to decimal: 2^5000000 in a wide context, and the work bound of an unlimited precision" {
  let huge = @binary.Binary::make(@binary.BinCoeff::one(), 5_000_000, 53)
  let wide = DecimalContext::new(precision=16, e_max=999_999_999)
  let (value, flags) = Decimal::from_binary_ctx(huge, wide)
  assert_eq(value.to_string(), "9.513052773090666E+1505149")
  assert_true(flags.inexact)
  // beyond the range of decimal64 the value overflows without its digits
  let (result, flags) = Decimal::from_binary_ctx(
    huge,
    DecimalContext::decimal64(),
  )
  assert_true(result.is_infinite())
  assert_true(flags.overflow)
}

///|
// oracle: A
// source: the double 0.1 is the nearest binary64 to the decimal 0.1 (the compiler's float literal, correctly rounded, is the oracle), and 0.5 is exact: Decimal 0.5 at 16 digits is the text 0.5; written out
// shares: Decimal::from_string, Binary::from_double and to_hex (build the operand and print), to_binary and from_binary (the code under test)
test "from_binary and to_binary keep their results" {
  let tenth = Decimal::from_string("0.1").unwrap().to_binary(precision=53)
  assert_eq(tenth.to_hex(), @binary.Binary::from_double(0.1).to_hex())
  assert_eq(
    Decimal::from_binary(@binary.Binary::from_double(0.5), precision=16).to_string(),
    "0.5",
  )
}
