///|
// oracle-file: A
// producer: tools/generate_decimal_quantum_rows.py (CPython `decimal`, libmpdec; the versions are on the line before the table)
// input: operands of decimal128 (precision 34, emax 6144) with 7 coefficients (1 to 34 digits), 19 exponents from the smallest, -6176, to the largest, 6111, subnormal ones included, both signs, and zeros; expected text is the number (0, q, 1) of IEEE 754-2019 5.3.2 built from the exponent of the operand text by Python, printed by CPython decimal
// library-ran: no
// shares: the operands are parsed by `Decimal::from_string_ctx` (input only); the expected result is text compared with `to_string` of the result
// check: python3 tools/generate_decimal_quantum_rows.py --check library/src/decimal/quantum_ctx_wbtest.mbt

///|
// oracle: A
// source: the rows of the table, see the header of the file
// shares: nothing
test "quantum_ctx of a finite operand is 1E+q with the exponent q of the operand (5.3.2)" {
  let ctx = DecimalContext::decimal128()
  let mut count = 0
  for row in quantum_rows {
    let (operand, expected) = row
    let x = Decimal::from_string_ctx(operand, ctx).0
    let (result, flags) = x.quantum_ctx(ctx)
    if result.to_string() != expected ||
      result.is_negative() ||
      flags != DecimalFlags::new() {
      count += 1
      if count <= 10 {
        println(
          "row \{operand}: got \{result} \{flags.invalid_operation()}, expected \{expected}",
        )
      }
    }
  }
  assert_eq(count, 0)
}

///|
// oracle: A
// source: IEEE 754-2019 5.3.2 written out: quantum(x) for an infinite x is +inf with no exception, whatever the sign of x; 6.2: a quiet NaN is propagated with its payload and signals nothing, a signaling NaN signals invalid and gives a quiet NaN with the payload of the operand (6.2.2: quieting leaves the digits unchanged); the accessor of the exponent is `exponent10`, unchanged
// shares: nothing
test "quantum_ctx of infinities and NaNs (5.3.2, 6.2)" {
  let ctx = DecimalContext::decimal128()
  let d = fn(s : String) { Decimal::from_string(s).unwrap() }
  for text in ["Infinity", "-Infinity"] {
    let (result, flags) = d(text).quantum_ctx(ctx)
    assert_eq(result.to_string(), "inf")
    assert_false(result.is_negative())
    assert_true(flags == DecimalFlags::new())
  }
  let (quiet, quiet_flags) = d("NaN9").quantum_ctx(ctx)
  assert_true(quiet.is_quiet_nan())
  assert_eq(quiet.nan_payload(), 9N)
  assert_true(quiet_flags == DecimalFlags::new())
  let (signaling, signaling_flags) = d("sNaN7").quantum_ctx(ctx)
  assert_true(signaling.is_quiet_nan())
  assert_eq(signaling.nan_payload(), 7N)
  assert_true(signaling_flags.invalid_operation())
  assert_false(signaling_flags.not_computed())
  // the accessor of the exponent
  assert_eq(d("12.3400").exponent10(), -4)
}

///|
// oracle: A
// source: by hand from 5.3.2: quantum(x) has the preferred exponent Q(x), and its value is 10^q, so quantum(1.2300) is 0.0001, quantum(12) is 1, quantum(1E+3) is 1000 written 1E+3; two operands of the same value and different cohorts have different quanta
// shares: nothing
test "quantum_ctx tells the cohort members apart" {
  let ctx = DecimalContext::decimal128()
  let d = fn(s : String) { Decimal::from_string(s).unwrap() }
  assert_eq(d("1.2300").quantum_ctx(ctx).0.to_string(), "0.0001")
  assert_eq(d("12").quantum_ctx(ctx).0.to_string(), "1")
  assert_eq(d("1E+3").quantum_ctx(ctx).0.to_string(), "1E+3")
  assert_eq(d("100").quantum_ctx(ctx).0.to_string(), "1")
  assert_eq(d("1.00").quantum_ctx(ctx).0.to_string(), "0.01")
  assert_eq(d("0.00").quantum_ctx(ctx).0.to_string(), "0.01")
}

