///|
// oracle-file: A
// producer: tools/generate_decimal_div_range_rows.py (CPython `decimal`, libmpdec; the versions are on the line before the table)
// input: the plain working context of `decimal` as a libmpdec context (precision 34, half-even, no clamp,
//   Emax 2147483646, Emin -2147483645 + 33); rows 1 to 8 are the table of issue 676, then a seeded sweep (seed 676)
//   of `/`, `+`, `-`, `*` over operand exponents at the bottom and the top of the stored range and in the middle;
//   operands have 1 to 34 digits (the default precision, so parsing does not round), 20 percent negative
// library-ran: no
// shares: the operands are parsed by `Decimal::from_string` (input only); the expected result is the text of the
//   generator, compared with `to_string` of the result as text, no library parser on the expected side
// check: python3 tools/generate_decimal_div_range_rows.py --check library/src/decimal/div_range_issue676_wbtest.mbt

///|
fn sweep_676_check(from : Int32, to : Int32) -> String {
  let bad = StringBuilder()
  let mut count = 0
  for i = from; i < to; i = i + 1 {
    let (op, a, b, expected) = sweep_676_rows[i]
    let x = Decimal::from_string(a).unwrap()
    let y = Decimal::from_string(b).unwrap()
    let r = match op {
      "/" => x.div(y)
      "+" => x.add(y)
      "-" => x.sub(y)
      _ => x.mul(y)
    }
    if r.to_string() != expected {
      count += 1
      if count <= 400 {
        bad.write_string(
          "row \{i}: \{a} \{op} \{b} gave \{r}, expected \{expected}\n",
        )
      }
    }
  }
  "mismatches: \{count}\n" + bad.to_string()
}

///|
// oracle: A
// source: issue 676 table, values from CPython decimal (libmpdec)
// shares: nothing
test "issue 676: plain division at the bottom of the stored exponent range" {
  inspect(sweep_676_check(0, 8), content="mismatches: 0\n")
}

///|
// oracle: A
// source: seeded sweep of plain operators against CPython decimal (libmpdec), see the file header
// shares: nothing
test "issue 676: plain operators over the ends of the stored exponent range" {
  inspect(
    sweep_676_check(8, sweep_676_rows.length()),
    content="mismatches: 0\n",
  )
}

