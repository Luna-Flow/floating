///|
// `exact_decimal_division_result` against CPython `decimal`: whether a quotient
// with a finite decimal expansion is produced at all (the part of the divisor
// prime to 10 divides the dividend after the common factors are removed), and
// the rounded result and flags in every context of the table: the IEEE formats
// and five rounding directions at seven precisions, dividends that are and are
// not multiples of the part prime to 10 or of the divisor, divisors with factors
// 2 and 5 of high valuation (rows of exact_division_rows).

///|
// oracle: A
// source: table exact_division_rows generated by tools/generate_decimal_oracle_rows.py: the decision from Python integers (math.gcd, the reduced denominator has only the primes 2 and 5) and the quotient with its inexact, underflow and overflow flags from CPython decimal (libmpdec) in the row's context; the earlier oracle was the gcd route kept as private reference code of the library
// shares: DecimalContext::raw, Decimal::from_string_ctx, to_string and plain_round_of, plain_answer_text (they build the context and the operands and print the result)
test "exact division with the finite-expansion decision equals the gcd route" {
  let wide = DecimalContext::new(precision=400)
  let mut answered = 0
  for row in exact_division_rows {
    let (precision, e_max, mode, clamp, dividend_text, divisor_text, expected) = row
    let ctx = DecimalContext::raw(
      precision,
      1 - e_max,
      e_max,
      clamp~,
      round=plain_round_of(mode),
    )
    let dividend = Decimal::from_string_ctx(dividend_text, wide).0
    let divisor = Decimal::from_string_ctx(divisor_text, wide).0
    let got = match exact_decimal_division_result(dividend, divisor, ctx) {
      None => "none"
      Some((value, flags)) => {
        answered += 1
        plain_answer_text(value, flags)
      }
    }
    assert_eq(
      (dividend_text, divisor_text, precision, mode, got),
      (dividend_text, divisor_text, precision, mode, expected),
    )
  }
  assert_true(answered > 200)
}

///|
// oracle: S
// source: self-consistency of DecimalFlags::new(): the shared empty value is not changed by operations on contexts built from it (a copy compared with the same value, flag set unions, and a flag-clean check); no expected value of an operation is written out
// shares: DecimalFlags, DecimalContext::new, Decimal::from_string_ctx, add_ctx, sub_ctx, mul_ctx and div_ctx (only to raise flags; their values are not asserted)
test "the shared empty flag set is never written" {
  let none = DecimalFlags::new()
  let fresh : DecimalFlags = {
    inexact: false,
    underflow: false,
    overflow: false,
    division_by_zero: false,
    invalid_operation: false,
    not_computed: false,
  }
  let updated = { ..none, inexact: true, }
  assert_true(updated != none)
  assert_true(none.combine(updated).combine(none) == updated)
  assert_true(updated.combine(none) == updated)
  assert_true(DecimalFlags::new() == fresh)
  // operations that raise flags on contexts built from the shared value
  let ctx = DecimalContext::new(precision=7)
  let a = Decimal::from_string_ctx("1234567890123456789", ctx).0
  let b = Decimal::from_string_ctx("9.87654321E-3", ctx).0
  for _ in 0..<4 {
    let (_, flags) = a.add_ctx(b, ctx)
    assert_true(flags.inexact())
    ignore(a.sub_ctx(b, ctx))
    ignore(a.mul_ctx(b, ctx))
    ignore(a.div_ctx(b, ctx))
  }
  assert_true(DecimalFlags::new() == fresh)
  assert_true(DecimalFlags::new() == none)
  assert_true(decimal_flags_are_clear(DecimalFlags::new()))
}
