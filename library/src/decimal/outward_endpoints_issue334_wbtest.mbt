///|
// oracle: A
// source: tables outward_binary_rows and outward_rows generated by tools/generate_decimal_oracle_rows.py: the 200-bit endpoints of each text rounded toward negative and toward positive from the exact value (Python integers), and for 8, 32 and 60 digits the bounds the outward endpoint must lie between (the exact endpoint rounded down or up to 80 digits on one side, to the digits plus one unit on the other; CPython decimal in a wide context); the earlier oracle compared the endpoints with decimal_exact_dyadic_endpoint, which shares the code under test
// shares: ball_row_binary and bigint_from_text (they build the endpoints from the table), Decimal::from_string_ctx and total_order_compare (they parse the bounds and compare), digits10 (it counts the digits of the coefficient)
test "outward endpoints enclose the exact expansion" {
  let ctx = DecimalContext::new(precision=20, e_max=999999)
  let wide = DecimalContext::new(precision=100, e_max=999999)
  let endpoints = outward_binary_rows()
  let mut checked = 0
  for row in outward_rows() {
    let (text, digits, bounds) = row
    let (lo_min, lo_max, hi_min, hi_max) = bounds
    let mut found = false
    for entry in endpoints {
      let (name, lower_c, lower_k, upper_c, upper_k) = entry
      if name != text {
        continue
      }
      found = true
      let lower = ball_row_binary(lower_c, lower_k)
      let upper = ball_row_binary(upper_c, upper_k)
      let lo = decimal_outward_dyadic_endpoint(lower, ctx, digits, false).unwrap()
      let hi = decimal_outward_dyadic_endpoint(upper, ctx, digits, true).unwrap()
      let label = "\{text} at \{digits} digits"
      assert_true(
        lo.total_order_compare(Decimal::from_string_ctx(lo_min, wide).0) >= 0,
        msg="lower too low \{label} \{lo}",
      )
      assert_true(
        lo.total_order_compare(Decimal::from_string_ctx(lo_max, wide).0) <= 0,
        msg="lower too high \{label} \{lo}",
      )
      assert_true(
        hi.total_order_compare(Decimal::from_string_ctx(hi_min, wide).0) >= 0,
        msg="upper too low \{label} \{hi}",
      )
      assert_true(
        hi.total_order_compare(Decimal::from_string_ctx(hi_max, wide).0) <= 0,
        msg="upper too high \{label} \{hi}",
      )
      assert_true(digits10(lo.coefficient.to_bigint()) <= digits + 1)
      assert_true(digits10(hi.coefficient.to_bigint()) <= digits + 1)
      checked += 1
    }
    assert_true(found)
  }
  assert_eq(checked, outward_rows().length())
}

///|
// oracle: A
// source: written out: expm1(x) = x + x^2/2 + ... for x = 10^-n, n at least 1000, is 10^-n plus a relative 5e-1001 or less, which a 20-digit result cannot see, so the rounded value is the operand in 20 digits (1.0000000000000000000E-n) and inexact
// shares: Decimal::from_string_ctx and to_string (they parse and print), expm1_ctx (the code under test)
test "wide-range expm1 of a tiny argument is fast and unchanged" {
  let ctx = DecimalContext::new(precision=20, e_max=999999)
  for n in [1000, 100000, 300000] {
    let x = Decimal::from_string_ctx("1E-\{n}", ctx).0
    let (r, flags) = x.expm1_ctx(ctx)
    inspect(r.to_string(), content="1.0000000000000000000E-\{n}")
    assert_true(flags.inexact)
  }
}
