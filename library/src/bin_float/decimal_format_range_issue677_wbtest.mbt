///|
// oracle: A
// source: expected digit strings from CPython decimal (exact 2^e, 60 guard digits), tools/generate_decimal_digits_rows.py
// shares: nothing
test "to_decimal_string_ctx at both ends of the exponent range (issue 677)" {
  let context = BinaryContext::new(precision=53)
  for row in binary_decimal_digits_range_rows {
    let (c, e, d, expected) = row
    let value = BinFloat::make(BinCoeff::from_uint64(c), e, 128)
    let (text, _) = value.to_decimal_string_ctx(d, context)
    assert_eq(text, expected)
  }
}
