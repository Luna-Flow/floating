// Generated by tools/generate_decimal_huge_trig_rows.py; do not edit.
// sin, cos and tan of 2^k (binary exponent above the old trigonometric cutoff and
// the series-precision threshold of 256 bits), rounded to nearest even; the
// expected values are the rounding of MPFR 4.2.2 enclosures at the exact argument
// (tools/mpfr_huge_trig.c), kept only when both bounds round to one value.

///|
test "sin, cos and tan of 2^k against MPFR at the exact argument" {
  let rows : Array[(String, Int32, Int32, String)] = [
    ("sin", 300, 53, "8802398251462213p-53"),
    ("sin", 300, 113, "2537118559056123495398529478244855p-111"),
    ("cos", 300, 53, "7639291524492727p-55"),
    ("cos", 300, 113, "8807503478548488390306992855327465p-115"),
    ("tan", 300, 53, "162165224018779p-45"),
    ("tan", 300, 113, "5982840770260386786609755522327137p-110"),
    ("sin", 5000, 53, "-4975204865389281p-53"),
    ("sin", 5000, 113, "-5736020679131915224319396481248901p-113"),
    ("cos", 5000, 53, "-1877115056443223p-51"),
    ("cos", 5000, 113, "-2164166315194687174895772817344705p-111"),
    ("tan", 5000, 53, "2984144565479485p-52"),
    ("tan", 5000, 113, "6880968884793907149027382466366393p-113"),
    ("sin", 70000, 53, "4410396487554295p-52"),
    ("sin", 70000, 113, "5084840954343850887069035493631661p-112"),
    ("cos", 70000, 53, "3645956502692609p-54"),
    ("cos", 70000, 113, "4203501656815480372883663701310671p-114"),
    ("tan", 70000, 53, "170245619730007p-45"),
    ("tan", 70000, 113, "1570238688414758204929100495373557p-108"),
    ("sin", 100000, 53, "-3577529868676257p-53"),
    ("sin", 100000, 113, "-8249222237940332308238053378127919p-114"),
    ("cos", 100000, 53, "-8266251777760941p-53"),
    ("cos", 100000, 113, "-4765169718537584077750302005737867p-112"),
    ("tan", 100000, 53, "7796405247090775p-54"),
    ("tan", 100000, 113, "1123580408500076541786470947040061p-111"),
  ]
  for row in rows {
    let (op, k, p, expected) = row
    let x = BinFloat::make(BinCoeff::one(), k, 2)
    let ctx = BinaryContext::unbounded(p)
    let value = match op {
      "sin" => x.try_sin_ctx(ctx).unwrap().0
      "cos" => x.try_cos_ctx(ctx).unwrap().0
      _ => x.try_tan_ctx(ctx).unwrap().0
    }
    assert_eq(
      "\{op}(2^\{k}) p=\{p} => \{value}",
      "\{op}(2^\{k}) p=\{p} => \{expected}",
    )
  }
}
