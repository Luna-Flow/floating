///|
/// Digest table of the enclosure kernels (issue #368).
///
/// The shared fixed-point toolkit is a pure refactor: for the same
/// `(value, work_precision)` every kernel must return the same enclosure
/// `(L, U)`, bit for bit (coefficient, exponent, sign and precision of both
/// ends), and decline in the same cases. This file hashes the results of a fixed
/// corpus, one FNV-1a digest per kernel and working precision, and asserts the
/// table `toolkit_digest_expected` below. The table was generated by running
/// this very file against the kernels of `origin/main` at `d64c739` (before the
/// refactor); to regenerate it, empty `toolkit_digest_expected`, run the test
/// and copy the rows it prints. The corpus uses only integer arithmetic, so the
/// digests are identical on native, wasm, wasm-gc and js.
///
/// Row format: `kernel wp some/total digest`.
fn toolkit_digest_mix(hash : UInt64, text : String) -> UInt64 {
  let mut h = hash
  for ch in text {
    h = (h ^ ch.to_int().to_uint64()) * 1099511628211UL
  }
  h
}

///|
fn toolkit_digest_float(value : BinFloat) -> String {
  value.coefficient_.to_radix_string(16) +
  "x" +
  value.exponent2().to_string() +
  "p" +
  value.precision().to_string() +
  (if value.is_negative() { "n" } else { "+" })
}

///|
fn toolkit_digest_hex(value : UInt64) -> String {
  let digits = "0123456789abcdef"
  let buffer = StringBuilder()
  let mut shift = 60
  while shift >= 0 {
    let nibble = ((value >> shift) & 15UL).to_int()
    buffer.write_char(Int32::unsafe_to_char(digits[nibble].to_int()))
    shift -= 4
  }
  buffer.to_string()
}

///|
/// Accumulates the enclosures of one kernel at one working precision.
priv struct ToolkitDigest {
  mut hash : UInt64
  mut total : Int32
  mut some : Int32
}

///|
fn ToolkitDigest::new() -> ToolkitDigest {
  { hash: 14695981039346656037UL, total: 0, some: 0, }
}

///|
fn ToolkitDigest::add(
  self : ToolkitDigest,
  result : (BinFloat, BinFloat)?,
) -> Unit {
  self.total += 1
  match result {
    Some((low, high)) => {
      self.some += 1
      self.hash = toolkit_digest_mix(
        self.hash,
        "[" + toolkit_digest_float(low) + "," + toolkit_digest_float(high) + "]",
      )
    }
    None => self.hash = toolkit_digest_mix(self.hash, "N")
  }
}

///|
fn ToolkitDigest::add_text(self : ToolkitDigest, text : String) -> Unit {
  self.total += 1
  self.some += 1
  self.hash = toolkit_digest_mix(self.hash, text + ";")
}

///|
fn ToolkitDigest::add_ints(
  self : ToolkitDigest,
  result : (Coeff, Coeff)?,
) -> Unit {
  match result {
    Some((low, high)) =>
      self.add_text(low.to_radix_string(16) + "," + high.to_radix_string(16))
    None => {
      self.total += 1
      self.hash = toolkit_digest_mix(self.hash, "N;")
    }
  }
}

///|
fn ToolkitDigest::add_balls(
  self : ToolkitDigest,
  result : BurstRotation?,
) -> Unit {
  match result {
    Some(rotation) =>
      self.add_text(
        rotation.cos.mid.to_radix_string(16) +
        "," +
        rotation.cos.rad.to_radix_string(16) +
        "," +
        rotation.sin.mid.to_radix_string(16) +
        "," +
        rotation.sin.rad.to_radix_string(16),
      )
    None => {
      self.total += 1
      self.hash = toolkit_digest_mix(self.hash, "N;")
    }
  }
}

///|
fn ToolkitDigest::row(
  self : ToolkitDigest,
  name : String,
  work : Int32,
) -> String {
  name +
  " " +
  work.to_string() +
  " " +
  self.some.to_string() +
  "/" +
  self.total.to_string() +
  " " +
  toolkit_digest_hex(self.hash)
}

///|
/// A value `m / 2^(bits - 1 - top)` with a `bits`-bit pseudo-random coefficient.
fn toolkit_digest_value(
  bits : Int32,
  top : Int32,
  negative : Bool,
  seed : UInt64,
) -> BinFloat {
  burst_test_value(bits, top, negative, seed)
}

///|
/// `k * base` rounded to `bits` bits, plus `step` units in the last place.
fn toolkit_digest_multiple(
  base : (BinFloat, BinFloat),
  k : Int32,
  bits : Int32,
  step : Int32,
) -> BinFloat {
  let scaled = base.0.mul_ctx(
      BinFloat::from_int(k, precision=64),
      BinaryContext::new(precision=bits, rounding=RoundTowardNegative),
    ).0
  if step == 0 {
    scaled
  } else {
    scaled.add_ctx(
      BinFloat::make_coeff(
        Coeff::from_uint64(step.abs().to_uint64()),
        scaled.exponent2(),
        64,
        negative=step < 0,
      ),
      BinaryContext::new(precision=bits + 2),
    ).0
  }
}

///|
/// Arguments of the `exp` kernels at one working precision: tiny, medium and
/// large magnitudes of both signs, the edges `2^-64` and `2^30`, neighbours of
/// multiples of `ln 2`, and values with fewer and with more bits than the
/// working precision.
fn toolkit_digest_exp_values(work : Int32) -> Array[BinFloat] {
  let values : Array[BinFloat] = []
  let full = work <= 300
  let tops = if full {
    [-64, -63, -60, -30, -8, -4, -3, -2, -1, 0, 1, 3, 5, 10, 20, 29, 30]
  } else {
    [-64, -8, -3, 0, 1, 5, 29, 30]
  }
  let mut seed = 11UL
  for top in tops {
    for negative in [false, true] {
      seed += 1UL
      values.push(
        toolkit_digest_value(Int32::min(work, 53), top, negative, seed),
      )
      if full {
        seed += 1UL
        values.push(
          toolkit_digest_value(Int32::min(work, 120), top, negative, seed),
        )
        seed += 1UL
        values.push(toolkit_digest_value(work + 40, top, negative, seed))
      }
    }
  }
  // Powers of two and the smallest and largest accepted magnitudes.
  for exponent in [-64, -10, -3, -1, 0, 4, 29] {
    values.push(BinFloat::make_coeff(Coeff::one(), exponent, 8))
    values.push(BinFloat::make_coeff(Coeff::one(), exponent, 8, negative=true))
  }
  values.push(BinFloat::make_coeff(Coeff::one(), -65, 8))
  values.push(BinFloat::make_coeff(Coeff::one(), 30, 8))
  // Neighbours of multiples of ln 2.
  let ln2 = binary_ln2_bounds(320).unwrap()
  let ks = if full { [1, 2, 3, 50, -7, 40000] } else { [1, -7] }
  for k in ks {
    for step in [-1, 0, 1] {
      values.push(toolkit_digest_multiple(ln2, k, Int32::min(work, 120), step))
    }
  }
  values
}

///|
fn toolkit_digest_unit_values(work : Int32, near : Bool) -> Array[BinFloat] {
  let values : Array[BinFloat] = []
  let mut seed = 77UL
  let bit_counts = [Int32::min(work, 53), Int32::min(work, 130), work]
  for bits in bit_counts {
    for _ in 0..<(if work <= 300 { 4 } else { 2 }) {
      seed += 1UL
      // a bits-bit number in [1, 2)
      values.push(toolkit_digest_value(bits, 1, false, seed))
    }
  }
  if near {
    // longer than the working precision: any length is allowed
    values.push(toolkit_digest_value(work + 100, 1, false, 901UL))
  }
  values.push(BinFloat::from_int(2, precision=8))
  values.push(BinFloat::make_coeff(Coeff::from_uint64(3UL), -1, 2))
  values.push(BinFloat::make_coeff(Coeff::from_uint64(0xFFFFFFFFUL), -31, 32))
  // 1 + 2^-k around the near-one switch at 2^-16 and tiny differences
  for k in [3, 15, 16, 17, 40, 90] {
    if k < work {
      values.push(
        BinFloat::make_coeff(
          Coeff::one().shift_left(k).add(Coeff::one()),
          -k,
          k + 1,
        ),
      )
    }
  }
  values.push(BinFloat::one(precision=8))
  values.push(BinFloat::make_coeff(Coeff::from_uint64(1UL), -1, 8))
  values
}

///|
fn toolkit_digest_trig_values(work : Int32) -> Array[BinFloat] {
  let values : Array[BinFloat] = []
  let full = work <= 300
  let tops = if full {
    [-64, -40, -10, -3, -1, 0, 1, 2, 5, 12, 100, 1000, 4096]
  } else {
    [-64, -3, 0, 1, 12, 200]
  }
  let mut seed = 31UL
  for top in tops {
    for negative in [false, true] {
      seed += 1UL
      values.push(
        toolkit_digest_value(Int32::min(work, 53), top, negative, seed),
      )
      seed += 1UL
      values.push(
        toolkit_digest_value(Int32::min(work, 130), top, negative, seed),
      )
    }
  }
  values.push(BinFloat::make_coeff(Coeff::one(), -65, 8))
  values.push(BinFloat::make_coeff(Coeff::one(), 4097, 8))
  values.push(BinFloat::one(precision=8))
  values.push(BinFloat::make_coeff(Coeff::one(), 0, 8, negative=true))
  let pi = binary_pi_bounds(448).unwrap()
  let half_pi = (
    pi.0.mul_ctx(
      BinFloat::make_coeff(Coeff::one(), -1, 1),
      BinaryContext::new(precision=448, rounding=RoundTowardNegative),
    ).0,
    pi.1,
  )
  let ks = if full { [1, 2, 3, 4, 7, 1000, -5] } else { [1, 3, -2] }
  for k in ks {
    for step in [-1, 0, 1] {
      values.push(
        toolkit_digest_multiple(half_pi, k, Int32::min(work, 150), step),
      )
    }
  }
  values
}

///|
fn toolkit_digest_rows() -> Array[String] {
  let rows : Array[String] = []
  // exp: table, fixed, burst
  for
    work in [
      24, 53, 64, 100, 128, 200, 256, 257, 300, 512, 576, 639, 640, 641, 1023, 1024,
      1088, 1536, 1792, 2048, 2112, 3072,
    ] {
    let values = toolkit_digest_exp_values(work)
    let table = ToolkitDigest::new()
    let fixed = ToolkitDigest::new()
    let burst = ToolkitDigest::new()
    for value in values {
      table.add(binary_exp_bounds_table(value, work))
      fixed.add(binary_exp_bounds_fixed(value, work))
      burst.add(
        binary_exp_bounds_burst(
          value,
          work,
          first_chunk=binary_exp_burst_first_chunk,
          chunk_factor=binary_exp_burst_chunk_factor,
          split_min_terms=binary_exp_burst_split_min_terms,
        ),
      )
    }
    rows.push(table.row("exp_table", work))
    rows.push(fixed.row("exp_fixed", work))
    rows.push(burst.row("exp_burst", work))
  }
  // ln on (1, 2]
  for work in [24, 53, 64, 100, 128, 256, 512, 1024, 1152, 1280] {
    let fixed = ToolkitDigest::new()
    for value in toolkit_digest_unit_values(work, false) {
      fixed.add(binary_ln_unit_fixed_bounds(value, work))
    }
    rows.push(fixed.row("ln_fixed", work))
  }
  for work in [96, 128, 200, 256, 512, 576, 1152, 1280, 1536, 2048] {
    let burst = ToolkitDigest::new()
    for value in toolkit_digest_unit_values(work, true) {
      burst.add(binary_ln_unit_burst_bounds(value, work))
    }
    rows.push(burst.row("ln_burst", work))
  }
  // sin and cos
  for work in [24, 53, 64, 100, 128, 256, 512, 1536] {
    let fixed = ToolkitDigest::new()
    for value in toolkit_digest_trig_values(work) {
      fixed.add(binary_sin_cos_fixed_series(value, false, work))
      fixed.add(binary_sin_cos_fixed_series(value, true, work))
    }
    rows.push(fixed.row("trig_fixed", work))
  }
  for work in [64, 128, 256, 512, 640, 1536, 2112, 3072] {
    let burst = ToolkitDigest::new()
    for value in toolkit_digest_trig_values(work) {
      burst.add(
        binary_trig_bounds_burst(
          value,
          false,
          work,
          first_chunk=binary_exp_burst_first_chunk,
          chunk_factor=binary_exp_burst_chunk_factor,
          split_min_terms=binary_exp_burst_split_min_terms,
        ),
      )
      burst.add(
        binary_trig_bounds_burst(
          value,
          true,
          work,
          first_chunk=binary_exp_burst_first_chunk,
          chunk_factor=binary_exp_burst_chunk_factor,
          split_min_terms=binary_exp_burst_split_min_terms,
        ),
      )
    }
    rows.push(burst.row("trig_burst", work))
  }
  // constants: the series below 64 bits, binary splitting from 64 bits
  for
    work in [20, 30, 40, 63, 64, 65, 100, 128, 192, 256, 500, 1024, 2048, 4096] {
    let ln2 = ToolkitDigest::new()
    let ln10 = ToolkitDigest::new()
    let pi = ToolkitDigest::new()
    ln2.add(binary_ln2_compute(work))
    ln10.add(binary_ln10_bounds_compute(work))
    pi.add(binary_pi_bounds_compute(work))
    if work >= 64 {
      ln2.add(Some(binary_ln2_split_bounds(work)))
      ln10.add(binary_ln10_split_bounds(work))
      pi.add(binary_pi_split_bounds(work))
    }
    rows.push(ln2.row("const_ln2", work))
    rows.push(ln10.row("const_ln10", work))
    rows.push(pi.row("const_pi", work))
  }
  // the raw integer stages of the bit-burst kernels (no outward rounding to
  // the working precision hides a change of a slack constant here)
  for f in [100, 300, 1100, 3000] {
    let exp_fixed = ToolkitDigest::new()
    let exp_split = ToolkitDigest::new()
    let trig_fixed = ToolkitDigest::new()
    let trig_split = ToolkitDigest::new()
    let mut seed = 21UL
    for
      (s, bits) in [
        (16, 16),
        (16, 3),
        (64, 48),
        (256, 192),
        (1024, 768),
        (1024, 1),
      ] {
      seed += 1UL
      let n = burst_test_coefficient(bits, seed)
      exp_fixed.add_ints(burst_fixed_stage(n, s, f, burst_no_mutation))
      exp_split.add_ints(burst_split_stage(n, s, f, burst_no_mutation))
      trig_fixed.add_balls(
        burst_trig_fixed_stage(n, s, f, burst_trig_no_mutation),
      )
      trig_split.add_balls(
        burst_trig_split_stage(n, s, f, burst_trig_no_mutation),
      )
    }
    rows.push(exp_fixed.row("stage_exp_fixed", f))
    rows.push(exp_split.row("stage_exp_split", f))
    rows.push(trig_fixed.row("stage_trig_fixed", f))
    rows.push(trig_split.row("stage_trig_split", f))
  }
  // the exp tables, entry by entry
  for f in [128, 192, 1088, 1536] {
    let (k1, k2) = binary_exp_table_shape(f)
    let tables = ToolkitDigest::new()
    match binary_exp_table_get(f, k1, k2) {
      Some(table) => {
        tables.add_text("shape " + k1.to_string() + " " + k2.to_string())
        for
          list in [
            table.first_low,
            table.first_high,
            table.second_low,
            table.second_high,
          ] {
          for entry in list {
            tables.add_text(entry.to_radix_string(16))
          }
        }
      }
      None => tables.add_text("N")
    }
    rows.push(tables.row("exp_table_entries", f))
  }
  // rectangular-splitting Taylor series of the table kernel
  for f in [144, 200, 300, 600, 1200, 2500] {
    let taylor = ToolkitDigest::new()
    let mut seed = 5UL
    for k in [14, 12, 13] {
      for fill in [f - k, f - k - 7, 1] {
        seed += 1UL
        let a = burst_test_coefficient(Int32::max(1, fill), seed)
        let (low, high) = binary_exp_taylor_fixed(a, f, k)
        taylor.add(
          Some(
            (
              BinFloat::make_coeff(low, 0, Int32::max(1, low.bit_length())),
              BinFloat::make_coeff(high, 0, Int32::max(1, high.bit_length())),
            ),
          ),
        )
      }
    }
    rows.push(taylor.row("exp_taylor", f))
  }
  // ln by the arithmetic-geometric mean
  for work in [384, 640, 1024, 2048] {
    let agm = ToolkitDigest::new()
    for value in toolkit_digest_unit_values(work, true) {
      agm.add(binary_ln_unit_agm_bounds(value, work))
    }
    rows.push(agm.row("ln_agm", work))
  }
  // the bit-burst kernels with the chunk constants of the working precision
  for work in [1088, 2112, 2368, 2624, 3072, 4160, 6208] {
    let burst = ToolkitDigest::new()
    for value in toolkit_digest_exp_values(work) {
      burst.add(binary_exp_bounds_burst(value, work))
    }
    rows.push(burst.row("exp_burst_default", work))
  }
  for work in [1536, 2112, 3072, 4160, 6208] {
    let burst = ToolkitDigest::new()
    for value in toolkit_digest_trig_values(work) {
      burst.add(binary_trig_bounds_burst(value, false, work))
      burst.add(binary_trig_bounds_burst(value, true, work))
    }
    rows.push(burst.row("trig_burst_default", work))
  }
  rows
}

///|
test "kernel enclosures are bit-identical to the pre-toolkit kernels" {
  let rows = toolkit_digest_rows()
  let mismatches : Array[String] = []
  if rows.length() != toolkit_digest_expected.length() {
    mismatches.push(
      "row count \{rows.length()} != \{toolkit_digest_expected.length()}",
    )
  }
  for i in 0..<Int32::min(rows.length(), toolkit_digest_expected.length()) {
    if rows[i] != toolkit_digest_expected[i] {
      mismatches.push(
        "got  " + rows[i] + "\nwant " + toolkit_digest_expected[i],
      )
    }
  }
  if mismatches.length() > 0 {
    println("--- digest rows (copy into toolkit_digest_expected) ---")
    for row in rows {
      println("  \"" + row + "\",")
    }
    println("--- end rows ---")
    fail(mismatches.iter().fold(init="", fn(a, b) { a + b + "\n" }))
  }
}
