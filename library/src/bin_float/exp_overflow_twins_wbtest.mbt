// `expm1`, `exp10`, `exp10m1`, `exp2m1`, `sinh`, `cosh`, `pow`, `powr` and `compound` of
// an argument within about 2^-270 of the overflow threshold of their result (the twins
// of #569): the enclosure of the exponential overflows the implementation range, so no
// working precision separated a result just below 2^(e_max + 1) from one just above it
// (an error, and for `pow` a loop of minutes before it).
//
// Oracle, level A (arguments generated by a separate program, expected values and flags
// written out from IEEE 754-2019 clause 7.4): each pair of arguments is the two 300-bit
// floats around the threshold, computed with Python's `decimal` at 700 digits:
//   expm1, exp10, exp10m1: T = 2^30 ln 2 (resp. 2^30 ln 2 / ln 10);
//   sinh, cosh: T = (2^30 + 1) ln 2 (sinh also at -T);
//   exp2m1: 2^30 -+ 2^-269 (the exact threshold of 2^x);
//   pow, powr: the exponent y = 2^30 ln 2 / ln 3 with base 3;
//   compound: (1 + x)^(2^20) with x = 2^1024 - 1 -+ 2^-60 (the exact threshold).
// `m = floor(T * 2^-e)` for the 300-bit mantissa, `m` and `m + 1` the two arguments.
// The functions that differ from the pure exponential (`expm1`, `exp10m1`, `sinh`:
// the result is below `b^x` or `e^x / 2` by a factor `1 - d`; `cosh`: above it) decide
// the unsafe side only with a margin of `2^(31 - w)` at the working precision `w`
// (see `binary_exp_overflow_side`); a float inside the margin is refined until the
// margin is below its distance from the threshold. No float whose distance from `T`
// is below the difference `d` (below `2^-(2^30)`) can be written down at a feasible
// precision (it would need more than 2^30 bits), so there is no written-out case of
// the margin itself: the cases below are at distance about `2^-270`, which the loop
// reaches at a working precision of about 300 bits.
//
// Below the threshold the exact result is in (Omax(p), 2^(e_max + 1)): RNE, RNA and the
// direction toward the sign of the result round to 2^(e_max + 1) (overflow, inexact,
// infinity); the other directions give Omax(p) = (2^p - 1) 2^(e_max + 1 - p) with only
// inexact. Above it every direction overflows (infinity or Omax(p) by 7.4).

///|
fn twins_cases() -> Array[(String, String, String, Int32, Bool)] {
  [
    (
      "expm1", "1411965743695424507508857192728570223734551239724995589061361292466257174357546532574725854",
      "1411965743695424507508857192728570223734551239724995589061361292466257174357546532574725855",
      -270, false,
    ),
    (
      "exp10", "1226417862246688094273834767213607830049524184798846081282235916197656233542959805696055577",
      "1226417862246688094273834767213607830049524184798846081282235916197656233542959805696055578",
      -271, false,
    ),
    (
      "exp10m1", "1226417862246688094273834767213607830049524184798846081282235916197656233542959805696055577",
      "1226417862246688094273834767213607830049524184798846081282235916197656233542959805696055578",
      -271, false,
    ),
    (
      "sinh", "1411965745010420079196138797127410510250735435353898687209650977660974235566347107672326348",
      "1411965745010420079196138797127410510250735435353898687209650977660974235566347107672326349",
      -270, false,
    ),
    (
      "sinh", "1411965745010420079196138797127410510250735435353898687209650977660974235566347107672326348",
      "1411965745010420079196138797127410510250735435353898687209650977660974235566347107672326349",
      -270, true,
    ),
    (
      "cosh", "1411965745010420079196138797127410510250735435353898687209650977660974235566347107672326348",
      "1411965745010420079196138797127410510250735435353898687209650977660974235566347107672326349",
      -270, false,
    ),
    (
      "exp2m1", "1018517988167243043134222844204689080525734196832968125318070224677190649881668353091698687",
      "1018517988167243043134222844204689080525734196832968125318070224677190649881668353091698689",
      -269, false,
    ),
    (
      "pow", "1285226606564910510106925515990130683434773420736657097147082242176013456189292757974703701",
      "1285226606564910510106925515990130683434773420736657097147082242176013456189292757974703702",
      -270, false,
    ),
    (
      "powr", "1285226606564910510106925515990130683434773420736657097147082242176013456189292757974703701",
      "1285226606564910510106925515990130683434773420736657097147082242176013456189292757974703702",
      -270, false,
    ),
    (
      "compound", "",
      "",
      -60, false,
    ),
  ]
}

///|
test "functions of an exponential near the overflow threshold decide by the side" {
  let mut cases = 0
  for case_ in twins_cases() {
    let (name, below_text, above_text, exponent, negative) = case_
    for side in 0..<2 {
      let mantissa = Coeff::parse(
        if side == 0 {
          below_text
        } else {
          above_text
        },
      ).unwrap()
      let value = if name == "compound" {
        BinFloat::make_coeff(mantissa, exponent, 1200)
      } else {
        BinFloat::make_coeff(mantissa, exponent, 300, negative~)
      }
      for p in [2, 24, 53, 113] {
        for mode in e2s_modes() {
          let context = BinaryContext::new(precision=p, rounding=mode)
          let result = match name {
            "expm1" => value.try_expm1_ctx(context)
            "exp10" => value.try_exp10_ctx(context)
            "exp10m1" => value.try_exp10m1_ctx(context)
            "exp2m1" => value.try_exp2m1_ctx(context)
            "sinh" => value.try_sinh_ctx(context)
            "cosh" => value.try_cosh_ctx(context)
            "pow" =>
              BinFloat::make_coeff(Coeff::from_uint64(3UL), 0, 2).try_pow_ctx(
                value, context,
              )
            "powr" =>
              BinFloat::make_coeff(Coeff::from_uint64(3UL), 0, 2).try_powr_ctx(
                value, context,
              )
            _ => value.try_compound_ctx(1048576, context)
          }
          let (got, flags) = result.unwrap()
          let to_infinity = match mode {
            RoundTiesToEven | RoundTiesToAway => true
            RoundTowardPositive => !negative
            RoundTowardNegative => negative
            RoundTowardZero => false
          }
          let omax = BinFloat::make_coeff(
            Coeff::one().shift_left(p).sub_checked(Coeff::one()).unwrap(),
            binary_implementation_e_max + 1 - p,
            p,
            negative~,
          )
          if to_infinity {
            assert_true(got.classify() == FpClass::Infinity)
            assert_true(got.is_negative() == negative)
          } else {
            assert_true(got == omax)
          }
          assert_true(flags.overflow() == (side == 1 || to_infinity))
          assert_true(flags.inexact() && !flags.underflow())
          cases += 1
        }
      }
    }
  }
  assert_eq(cases, 10 * 2 * 4 * 5)
}
