// `exp` of an argument within 2^-270 of the overflow threshold (e_max + 1) ln 2
// (#569): the enclosure of exp overflows the implementation range, so it never
// separates a result just below 2^(e_max + 1) from one just above it.
//
// Oracle, level A (expected values written out by IEEE 754-2019 clause 7.4 and
// 4.3, arguments generated by a separate program): the two arguments are
//   x_below = 1411965743695424507508857192728570223734551239724995589061361292466257174357546532574725854 * 2^-270
//   x_above = x_below + 2^-270
// the two 300-bit floats around T = 2^30 ln 2, computed with Python's `decimal`
// at 400 digits (`T = Decimal(2).ln() * 2**30; m = floor(T * 2**270)`); T lies at
// 0.7296 of the way from x_below to x_above. Then exp(x_below) = 2^(e_max + 1) (1
// - eta) with eta about 2^-270.5 and exp(x_above) = 2^(e_max + 1) (1 + eta'), so for
// every precision p <= 113 used here (Omax(p) = (2^p - 1) 2^(e_max + 1 - p) lies
// below both): the value rounded with an unbounded exponent range is
//   x_above: >= 2^(e_max + 1) in every direction: overflow, inexact; the result is
//            +inf for RNE, RNA and RTP, Omax(p) for RTZ and RTN (clause 7.4);
//   x_below: 2^(e_max + 1) for RNE, RNA and RTP (a value above Omax(p) + half an ulp
//            or above Omax(p)): overflow, inexact, +inf; Omax(p) for RTZ and RTN: no
//            overflow, inexact.
// The ball case: [x_below, x_above] at 300 bits gives [RTN_300(exp x_below), +inf],
// with RTN_300(exp x_below) = (2^300 - c) 2^(e_max + 1 - 300), c = ceil(2^30 * 0.7296...)
// = 783442263 (the distance T - x_below is 0.7296... * 2^-270, and eta = that to
// 2^-541 relative).

///|
fn exp_edge_x_below() -> BinFloat {
  BinFloat::make_coeff(
    Coeff::parse(
      "1411965743695424507508857192728570223734551239724995589061361292466257174357546532574725854",
    ).unwrap(),
    -270,
    300,
  )
}

///|
fn exp_edge_omax(precision : Int32) -> BinFloat {
  BinFloat::make_coeff(
    Coeff::one().shift_left(precision).sub_checked(Coeff::one()).unwrap(),
    binary_implementation_e_max + 1 - precision,
    precision,
  )
}

///|
test "exp at the overflow threshold rounds by the clause 7.4 rules on both sides" {
  let below = exp_edge_x_below()
  let above = below.add_ctx(
      BinFloat::make_coeff(Coeff::one(), -270, 300),
      BinaryContext::new(precision=400),
    ).0
  let mut cases = 0
  for p in [2, 24, 53, 113] {
    for
      mode in [
        BinaryRoundingMode::RoundTiesToEven,
        BinaryRoundingMode::RoundTiesToAway,
        BinaryRoundingMode::RoundTowardZero,
        BinaryRoundingMode::RoundTowardPositive,
        BinaryRoundingMode::RoundTowardNegative,
      ] {
      let context = BinaryContext::new(precision=p, rounding=mode)
      let to_infinity = match mode {
        RoundTiesToEven | RoundTiesToAway | RoundTowardPositive => true
        RoundTowardZero | RoundTowardNegative => false
      }
      let same = fn(value : BinFloat) -> Bool {
        if to_infinity {
          value.classify() == FpClass::Infinity && !value.is_negative()
        } else {
          value.identical(exp_edge_omax(p))
        }
      }
      // above: overflow in every direction
      let (value, flags) = above.try_exp_ctx(context).unwrap()
      assert_true(value.precision() == p)
      assert_true(same(value))
      assert_true(flags.overflow() && flags.inexact() && !flags.underflow())
      // below: overflow only where the result rounds up to 2^(e_max + 1)
      let (value, flags) = below.try_exp_ctx(context).unwrap()
      assert_true(same(value))
      assert_true(flags.overflow() == to_infinity)
      assert_true(flags.inexact() && !flags.underflow())
      cases += 2
    }
  }
  assert_eq(cases, 40)
}
