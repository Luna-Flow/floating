///|
/// `power(10^k, y)` with a non-integral `y` such that `k*y` is an integer
/// (issue 351).
///
/// Contract, from GDA 1.70, *power*: "In cases not covered above, the result
/// will be inexact unless the right-hand side has an integral value and the
/// result is finite and can be expressed exactly within precision digits", and
/// "Inexact finite results should be correctly rounded, but may be up to 1 ulp
/// (unit in last place) in error". The correctly rounded value of the
/// representable `10^(k*y)` is that value in every rounding mode, written with
/// `precision` digits (or down to Etiny for a subnormal), with Inexact and
/// Rounded; `power.decTest` powx2039 and powx2040 (`rounding: ceiling`) expect
/// the same shape (`power 1 1.01 -> 1.00 Inexact Rounded`). A value beyond the
/// exponent range overflows or underflows through the ordinary rounding of the
/// exact value. The expected rows were derived from these rules and rounded
/// with Python `decimal` (libmpdec 4.0.0) only as an arithmetic helper;
/// libmpdec itself differs by 1 ulp in the upward modes for this input class.
/// The neighbour rows (`k*y` not an integer) stay on the certified path; their
/// expected values are libmpdec results, a cross-check only.

///|
fn issue351_flags_text(flags : DecimalFlags) -> String {
  (if flags.inexact { "x" } else { "." }) +
  (if flags.rounded { "r" } else { "." }) +
  (if flags.invalid_operation { "i" } else { "." }) +
  (if flags.division_by_zero { "z" } else { "." }) +
  (if flags.overflow { "o" } else { "." }) +
  (if flags.underflow { "u" } else { "." }) +
  (if flags.subnormal { "s" } else { "." }) +
  (if flags.clamped { "c" } else { "." })
}

///|
fn issue351_gda_flags_text(flags : GdaFlags) -> String {
  (if flags.inexact { "x" } else { "." }) +
  (if flags.rounded { "r" } else { "." }) +
  (if flags.invalid_operation { "i" } else { "." }) +
  (if flags.division_by_zero { "z" } else { "." }) +
  (if flags.overflow { "o" } else { "." }) +
  (if flags.underflow { "u" } else { "." }) +
  (if flags.subnormal { "s" } else { "." }) +
  (if flags.clamped { "c" } else { "." })
}

///|
fn issue351_mode(name : String) -> DecimalRoundingMode {
  match name {
    "half_even" => HalfEven
    "half_up" => HalfUp
    "half_down" => HalfDown
    "down" => Down
    "up" => Up
    "ceiling" => Ceiling
    "floor" => Floor
    "05up" => ZeroFiveUp
    _ => abort("unexpected rounding mode \{name}")
  }
}

///|
fn issue351_gda_mode(name : String) -> GdaRoundingMode {
  match name {
    "half_even" => GdaRoundingMode::HalfEven
    "half_up" => GdaRoundingMode::HalfUp
    "half_down" => GdaRoundingMode::HalfDown
    "down" => GdaRoundingMode::Down
    "up" => GdaRoundingMode::Up
    "ceiling" => GdaRoundingMode::Ceiling
    "floor" => GdaRoundingMode::Floor
    "05up" => GdaRoundingMode::ZeroFiveUp
    _ => abort("unexpected rounding mode \{name}")
  }
}

///|
fn issue351_value_text(value : Decimal) -> String {
  if value.is_infinite() {
    if value.is_signed() {
      "-Infinity"
    } else {
      "Infinity"
    }
  } else {
    value.to_string()
  }
}

///|
/// Runs one row through `Decimal::power_ctx`, the `GdaContext` adapter and the
/// checked tier; returns the three `(value, flags)` texts.
fn issue351_run(
  context_name : String,
  base : String,
  exponent : String,
  mode : String,
) -> Array[(String, String)] {
  let mut found : (String, Int32, Int32, Int32, Bool)? = None
  for entry in issue351_contexts {
    if entry.0 == context_name {
      found = Some(entry)
    }
  }
  let (_, precision, e_min, e_max, clamp) = found.unwrap()
  let ctx = DecimalContext::new(
    precision~,
    decimal_rounding=issue351_mode(mode),
    e_min~,
    e_max~,
    clamp~,
  ).unwrap()
  let gda = GdaContext::new(
    precision~,
    rounding=issue351_gda_mode(mode),
    e_min~,
    e_max~,
    clamp~,
  ).unwrap()
  let x = Decimal::from_string(base).unwrap()
  let y = Decimal::from_string(exponent).unwrap()
  let (value, flags) = x.power_ctx(y, ctx)
  let outcome = power(x, y, gda)
  [
    (issue351_value_text(value), issue351_flags_text(flags)),
    (
      issue351_value_text(outcome.value()),
      issue351_gda_flags_text(outcome.raised()),
    ),
  ]
}

///|
test "power of a power of ten with an integral k*y is exact in every mode (issue 351)" {
  for row in issue351_exact_rows {
    let (context_name, base, exponent, mode, value, flags) = row
    for got in issue351_run(context_name, base, exponent, mode) {
      let label = "\{context_name} power \{base} \{exponent} \{mode}"
      assert_eq((label, got.0, got.1), (label, value, flags))
    }
  }
}

///|
test "power of a power of ten with a non-integral k*y keeps the certified path (issue 351)" {
  for row in issue351_neighbour_rows {
    let (context_name, base, exponent, mode, value, flags) = row
    for got in issue351_run(context_name, base, exponent, mode) {
      let label = "\{context_name} power \{base} \{exponent} \{mode}"
      assert_eq((label, got.0, got.1), (label, value, flags))
    }
  }
}

///|
test "power of 1E-5 to 1.2 in decimal64 is 1E-6 padded in every mode (issue 351)" {
  // Reported case: Floor, Ceiling, Down and Up returned NaN with Invalid
  // operation; libmpdec gives 0.000001000000000000001 in ceiling and up.
  for
    name in [
      "half_even", "half_up", "half_down", "down", "up", "ceiling", "floor", "05up",
    ] {
    for got in issue351_run("d64clamp", "1E-5", "1.2", name) {
      assert_eq(got, ("0.000001000000000000000", "xr......"))
    }
  }
}

///|
test "power of a power of ten does not take the exact path in a restricted context (issue 351)" {
  // The context check of exp, ln, log10 and non-integral power comes first.
  let wide = GdaContext::new(precision=16).unwrap()
  let outcome = power(
    Decimal::from_string("1E-5").unwrap(),
    Decimal::from_string("1.2").unwrap(),
    wide,
  )
  assert_true(outcome.value().is_nan())
  assert_true(outcome.raised().invalid_context)
}

///|
/// Rows of issue 351: `power(10^k, y)` with a non-integral `y` and an integral `k*y`.
/// Expected values follow GDA 1.70 (see the notes at the test), not libmpdec; the
/// neighbours (`k*y` not an integer) are libmpdec results, a cross-check only.
let issue351_contexts : Array[(String, Int32, Int32, Int32, Bool)] = [
  ("d32", 7, -95, 96, false),
  ("d64", 16, -383, 384, false),
  ("d128", 34, -6143, 6144, false),
  ("d64clamp", 16, -383, 384, true),
  ("p3", 3, -999999, 999999, false),
  ("tiny", 5, -9, 9, true),
]

