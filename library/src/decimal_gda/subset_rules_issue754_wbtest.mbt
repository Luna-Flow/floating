///|
// Issue 754: in a subset context (extended=false) every operation of decimal_gda obeys the
// three result rules of GDA 1.70, page 55 (Appendix A, The X3.274 subset). Rows of the
// tables: op, precision, rounding, emax, emin, extended, a, b, result, flags ("*": the
// flags are not checked).

///|
fn i754_flags(f : GdaFlags) -> String {
  let names = []
  if f.clamped {
    names.push("Clamped")
  }
  if f.division_by_zero {
    names.push("Division_by_zero")
  }
  if f.division_impossible {
    names.push("Division_impossible")
  }
  if f.division_undefined {
    names.push("Division_undefined")
  }
  if f.inexact {
    names.push("Inexact")
  }
  if f.invalid_operation && !f.division_impossible && !f.division_undefined {
    names.push("Invalid_operation")
  }
  if f.lost_digits {
    names.push("Lost_digits")
  }
  if f.overflow {
    names.push("Overflow")
  }
  if f.rounded {
    names.push("Rounded")
  }
  if f.subnormal {
    names.push("Subnormal")
  }
  if f.underflow {
    names.push("Underflow")
  }
  if names.length() == 0 {
    "-"
  } else {
    names.join(",")
  }
}

///|
fn i754_int(s : String) -> Int32 {
  let mut v = 0
  for c in s {
    if c >= '0' && c <= '9' {
      v = v * 10 + (c.to_int() - 48)
    }
  }
  if s.has_prefix("-") {
    -v
  } else {
    v
  }
}

///|
fn i754_mode(s : String) -> GdaRoundingMode {
  match s {
    "half_up" => HalfUp
    "half_even" => HalfEven
    "half_down" => HalfDown
    "down" => Down
    "up" => Up
    "ceiling" => Ceiling
    "floor" => Floor
    _ => ZeroFiveUp
  }
}

///|
fn i754_call(
  op : String,
  a : Decimal,
  b : Decimal,
  ctx : GdaContext,
) -> GdaOutcome[Decimal] {
  match op {
    "abs" => abs(a, ctx)
    "minus" => minus(a, ctx)
    "plus" => plus(a, ctx)
    "apply" => apply(a, ctx)
    "exp" => exp(a, ctx)
    "ln" => ln(a, ctx)
    "log10" => log10(a, ctx)
    "squareroot" => sqrt(a, ctx)
    "reduce" => reduce(a, ctx)
    "tointegral" => round_to_integral_value(a, ctx)
    "tointegralx" => round_to_integral_exact(a, ctx)
    "nextminus" => next_minus(a, ctx)
    "nextplus" => next_plus(a, ctx)
    "add" => add(a, b, ctx)
    "subtract" => subtract(a, b, ctx)
    "multiply" => multiply(a, b, ctx)
    "divide" => divide(a, b, ctx)
    "divideint" => divide_integer(a, b, ctx)
    "remainder" => remainder(a, b, ctx)
    "remaindernear" => remainder_near(a, b, ctx)
    "power" => power(a, b, ctx)
    "max" => max(a, b, ctx)
    "min" => min(a, b, ctx)
    "maxmag" => max_magnitude(a, b, ctx)
    "minmag" => min_magnitude(a, b, ctx)
    "quantize" => quantize(a, b, ctx)
    "rescale" => rescale(a, b, ctx)
    "nexttoward" => next_toward(a, b, ctx)
    "scaleb" => scaleb(a, b, ctx)
    "shift" => shift(a, b, ctx)
    _ => rotate(a, b, ctx)
  }
}

///|
/// Runs every row of a table; returns the number of rows read and the rows whose
/// result (or flags, when the row gives them) differ from the recorded ones.
fn i754_run(rows : String) -> (Int32, Array[String]) {
  let mut calls = 0
  let bad = []
  for line in rows.split("\n") {
    let line = line.to_owned()
    if line == "" {
      continue
    }
    let f = line.split("\t").map(fn(x) { x.to_owned() }).collect()
    let ctx = GdaContext::new(
      precision=i754_int(f[1]),
      rounding=i754_mode(f[2]),
      e_min=i754_int(f[4]),
      e_max=i754_int(f[3]),
      extended=f[5] == "1",
    )
    let a = Decimal::from_string(f[6], precision=60).unwrap()
    let b = if f[7] == "-" {
      a
    } else {
      Decimal::from_string(f[7], precision=60).unwrap()
    }
    let out = i754_call(f[0], a, b, ctx)
    calls += 1
    let value = out.value().to_sci_string()
    let flags = i754_flags(out.raised())
    if value != f[8] || (f[9] != "*" && flags != f[9]) {
      bad.push(line + " => " + value + "\t" + flags)
    }
  }
  (calls, bad)
}

