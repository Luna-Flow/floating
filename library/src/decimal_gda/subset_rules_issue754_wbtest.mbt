///|
// oracle: A
// source: expected values written by hand from the three result rules of GDA 1.70, page 55 (Appendix A, The X3.274 subset): Z (a zero has sign 0 and exponent 0, unless the operation is quantize), S (no subnormal result), P (a positive exponent is reduced to 0 when the coefficient then fits in the precision, unless the operation is quantize); the extended rows from decNumber 3.68 (DECSUBSET=1, DECEXTFLAG=1, archive sha256 14ec2cf30b58758493a7661b78b80abfb281652b61a425b85cda83173518fe25, the pin of testdata/decimal_gda/deviations.tsv), which also gives the other subset rows except reduce, scaleb, shift, rotate, the two round-to-integral operations, sqrt, add of 1.2E+3 and 1E+2 and a zero of scaleb and shift (rows where it differs from the text)
// shares: Decimal::from_string and Decimal::to_sci_string (the printing of a Decimal, `Show` is to_string), GdaFlags accessors
test "issue 754: named calls obey the rules of page 55 in a subset context and are unchanged in an extended one" {
  let (calls, bad) = i754_run(i754_named)
  assert_eq(bad, [])
  assert_eq(calls, 85)
}

///|
// oracle: A
// source: (40 rows were moved by issue 759 to the table of deviations of subset_operand_rounding_issue759_wbtest.mbt: in them decNumber 3.68 gives a different result for an operand longer than the precision in shift, rotate or next_toward, which GDA 1.70, page 56 rounds first) a sample of a matrix of 149338 decNumber 3.68 calls (same build and pin as the named test) over 31 operations, precision 1, 3 and 9, exponent ends of 9, 99 and 999, every rounding where it can matter, operands longer than the precision, positive exponents that fit and do not fit, signed zeros; the rows kept are those where the library and decNumber agree after the fix: every third of the 925 rows whose result the fix changed and every 60th of the other agreeing rows
// shares: Decimal::from_string and Decimal::to_sci_string (the printing of a Decimal, `Show` is to_string), GdaFlags accessors
test "issue 754: sampled matrix against decNumber 3.68" {
  let (calls, bad) = i754_run(i754_matrix)
  assert_eq(bad, [])
  assert_eq(calls, 2678)
}

///|
let i754_pool : Array[String] = [
  "0", "-0", "0E+2", "-0E+2", "0E+5", "1", "-1", "12", "1200", "1.2E+3", "12E+2",
  "1E+2", "-1.4E+3", "5E+2", "7", "0.5", "1.5", "25E+1", "123456789123", "1.23456789123E+11",
  "9E+7", "1E-5", "12E-3", "1E-99", "1.1E-99", "1.01E-98", "9.99999999E+99", "1E+99",
  "-1E-99",
]

///|
let i754_ops : Array[String] = [
  "abs", "minus", "plus", "apply", "exp", "ln", "log10", "squareroot", "reduce",
  "tointegral", "tointegralx", "nextminus", "nextplus", "add", "subtract", "multiply",
  "divide", "divideint", "remainder", "remaindernear", "power", "max", "min", "maxmag",
  "minmag", "quantize", "rescale", "nexttoward", "scaleb", "shift", "rotate",
]

///|
/// The three rules on a delivered value; returns the rule it breaks, or "".
fn i754_rule_broken(op : String, value : Decimal, ctx : GdaContext) -> String {
  guard value.class == FpClass::Finite else { return "" }
  let keeps_exponent = op == "quantize" || op == "rescale"
  if value.coefficient.is_zero() {
    if value.negative {
      return "Z: a zero of sign 1"
    }
    if value.exponent10 != 0 && !keeps_exponent {
      return "Z: a zero with a non-zero exponent"
    }
    return ""
  }
  let digits = value.coefficient.digits10()
  if value.exponent10 + digits - 1 < ctx.e_min() {
    return "S: a subnormal result"
  }
  if !keeps_exponent &&
    value.exponent10 > 0 &&
    digits + value.exponent10 <= ctx.precision() {
    return "P: a positive exponent that fits"
  }
  ""
}

///|
// oracle: A
// source: the three result rules of GDA 1.70, page 55 (Appendix A, The X3.274 subset), written as predicates on the delivered value (Z: a zero has sign 0 and exponent 0, unless the operation is quantize or rescale; S: adjusted exponent at least Emin; P: no positive exponent whose coefficient fits in the precision, unless quantize or rescale); applied to every operation of the matrix, over 29 operands (signed zeros with exponents, operands longer than the precision, both ends of the exponent range, positive exponents that fit and do not fit), precision 1, 3 and 9, half-up and ceiling rounding
// shares: Decimal::from_string, Decimal::coefficient, exponent10, negative and the Decimal digit count (the fields the rules are about), GdaContext::e_min and precision
test "issue 754: every operation obeys rules Z, S and P of page 55 in a subset context" {
  let broken = []
  let mut calls = 0
  for op in i754_ops {
    for p in [1, 3, 9] {
      for mode in [GdaRoundingMode::HalfUp, GdaRoundingMode::Ceiling] {
        let ctx = GdaContext::new(
          precision=p,
          rounding=mode,
          e_min=-99,
          e_max=99,
          extended=false,
        )
        for sa in i754_pool {
          let a = Decimal::from_string(sa, precision=60).unwrap()
          for sb in i754_pool {
            let b = Decimal::from_string(sb, precision=60).unwrap()
            let out = i754_call(op, a, b, ctx)
            calls += 1
            let rule = i754_rule_broken(op, out.value(), ctx)
            if rule != "" && broken.length() < 20 {
              broken.push(
                op +
                "(" +
                sa +
                ", " +
                sb +
                ") at precision \{p}: " +
                out.value().to_sci_string() +
                " breaks " +
                rule,
              )
            }
          }
        }
      }
    }
  }
  assert_eq(broken, [])
  assert_eq(calls, 31 * 3 * 2 * 29 * 29)
}

///|
// oracle: A
// source: GDA 1.70, page 55 (Appendix A, The X3.274 subset), to-number conversion: a zero has sign and exponent 0; the rule for a positive exponent is stated for operations, not for the conversion, so `1.2E+3` is kept
// shares: Decimal::to_sci_string (the printing of a Decimal, `Show` is to_string)
test "issue 754: to_number in a subset context sets a zero to +0 and keeps a positive exponent" {
  let ctx = GdaContext::new(precision=9, extended=false)
  assert_eq(to_number("-0E+2", ctx).value().to_sci_string(), "0")
  assert_eq(to_number("0E+5", ctx).value().to_sci_string(), "0")
  assert_eq(to_number("-0", ctx).value().to_sci_string(), "0")
  assert_eq(to_number("1.2E+3", ctx).value().to_sci_string(), "1.2E+3")
}
