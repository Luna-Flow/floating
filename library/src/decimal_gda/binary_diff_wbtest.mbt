///|
// `Decimal::from_binary_raw`: the binary value converted to a decimal of a given precision
// in a given rounding mode. The expected results are the rows of
// `from_binary_rows_wbtest.mbt`, generated by `tools/generate_decimal_gda_from_binary_rows.py`
// with CPython integers and `decimal` (libmpdec); they replace a comparison with a
// previous big-integer implementation that called the code under test for the bounded rows.

///|
fn from_binary_hex_bytes(text : String) -> Bytes {
  let digits = text.to_array()
  let out : Array[Byte] = []
  let mut i = 0
  while i < digits.length() {
    let hi = from_binary_hex_value(digits[i])
    let lo = from_binary_hex_value(digits[i + 1])
    out.push((hi * 16 + lo).to_byte())
    i += 2
  }
  Bytes::from_array(out)
}

///|
fn from_binary_hex_value(c : Char) -> Int32 {
  let code = c.to_int()
  if code >= '0'.to_int() && code <= '9'.to_int() {
    code - '0'.to_int()
  } else {
    code - 'a'.to_int() + 10
  }
}

///|
fn from_binary_mode(name : String) -> DecimalRoundingMode {
  match name {
    "HalfEven" => DecimalRoundingMode::HalfEven
    "HalfUp" => HalfUp
    "HalfDown" => HalfDown
    "Down" => Down
    "Ceiling" => Ceiling
    "Floor" => Floor
    "Up" => Up
    "ZeroFiveUp" => ZeroFiveUp
    _ => abort("unknown rounding mode " + name)
  }
}

///|
// oracle: A
// source: the rows of from_binary_rows_wbtest.mbt (see the header of that file): CPython integers and `decimal` (libmpdec) round the exact value of coefficient * 2^exponent2 to the precision in each of the eight rules; the rows cover the powers of two and of ten and their neighbours at exponent2 0, 1, -1, +-shift and +-2000 and random coefficients of 1 to 300 bytes, precision 1 to 1000
// shares: Decimal::to_string (prints the result) ; (the coefficient bytes and the mode name are decoded by test-local helpers)
test "from_binary_raw equals the table of CPython decimal roundings" {
  let mut bad = 0
  for row in from_binary_rows {
    let (negative, hex, exponent2, precision, mode, text, exponent10) = row
    let coefficient = @binary.BinCoeff::from_bytes_be(
      from_binary_hex_bytes(hex)[:],
    )
    let value = @binary.Binary::make(
      coefficient,
      exponent2,
      coefficient.bit_length(),
      negative~,
    )
    let actual = Decimal::from_binary_raw(
      value,
      precision~,
      mode=from_binary_mode(mode),
    )
    if actual.to_string() != text ||
      actual.exponent10 != exponent10 ||
      actual.precision() != precision ||
      actual.negative != negative {
      bad += 1
      if bad <= 10 {
        println(
          "row \{hex} e2=\{exponent2} p=\{precision} \{mode} neg=\{negative}: got \{actual.to_string()}, expected \{text}",
        )
      }
    }
  }
  assert_eq(bad, 0)
}

///|
// oracle: A
// source: written out. A binary zero converts to a zero of the requested precision (the digit count of a zero coefficient is 1, exponent 0, no sign for +0); an infinity keeps its class and sign; a binary NaN converts to a NaN (GDA 1.70 page 11 and IEEE 754-2019 5.4.2 conversions keep the class)
// shares: Decimal::to_string (prints the result)
test "from_binary_raw of zero, infinity and nan" {
  for precision in [1, 16, 34] {
    let zero = Decimal::from_binary_raw(
      @binary.Binary::zero(precision=53),
      precision~,
      mode=HalfEven,
    )
    assert_eq(zero.to_string(), "0")
    assert_eq(zero.precision(), precision)
    assert_false(zero.negative)
    assert_eq(zero.exponent10, 0)
  }
  let infinity = Decimal::from_binary_raw(
    @binary.Binary::inf(negative=true, precision=53),
    precision=16,
  )
  assert_true(infinity.is_infinite())
  assert_true(infinity.negative)
  assert_true(
    Decimal::from_binary_raw(@binary.Binary::nan(precision=53), precision=16).is_nan(),
  )
}

///|
// oracle: A
// source: written out: value = c * 2^e2 with c odd; the exact decimal has exponent 0 for e2 >= 0 (the cohort is not reduced) and exponent e2 for e2 < 0 (c * 5^k has no trailing zero), never above 0; the digits are checked by hand (2^10 = 1024, 2^-10 = 0.0009765625, 125 * 2^-3 = 15.625), precision 34 holds them exactly
// shares: Decimal::to_string (prints the result)
test "from_binary_raw keeps the exponent at 0, 1 and -1 by name" {
  let cases : Array[(UInt64, Int32, String, Int32)] = [
    (1UL, 0, "1", 0),
    (1UL, 1, "2", 0),
    (5UL, 1, "10", 0),
    (3UL, 2, "12", 0),
    (1UL, -1, "0.5", -1),
    (3UL, -1, "1.5", -1),
    (5UL, -1, "2.5", -1),
    (1UL, -2, "0.25", -2),
    (125UL, -3, "15.625", -3),
    (1UL, 10, "1024", 0),
    (1UL, -10, "0.0009765625", -10),
  ]
  for mode in [DecimalRoundingMode::HalfEven, Up, Down] {
    for negative in [false, true] {
      for item in cases {
        let (c, e2, text, exponent) = item
        let x = @binary.Binary::make(
          @binary.BinCoeff::from_uint64(c),
          e2,
          53,
          negative~,
        )
        let actual = Decimal::from_binary_raw(x, precision=34, mode~)
        assert_eq(actual.exponent10, exponent)
        assert_eq(actual.to_string(), (if negative { "-" } else { "" }) + text)
      }
    }
  }
}
