    ("7.5", "1E+4100", Ceiling, "inf", "xr..o..."),
    ("7.5", "1E+4100", Up, "inf", "xr..o..."),
    ("7.5", "1E+4100", Down, "9.999999999999999E+384", "xr..o..."),
    ("7.5", "1E+400000", HalfEven, "inf", "xr..o..."),
    ("7.5", "1E+400000", Floor, "9.999999999999999E+384", "xr..o..."),
    ("7.5", "1E+400000", Ceiling, "inf", "xr..o..."),
    ("7.5", "1E+400000", Up, "inf", "xr..o..."),
    ("7.5", "1E+400000", Down, "9.999999999999999E+384", "xr..o..."),
    ("7.5", "-1E+4100", HalfEven, "0E-398", "xr...usc"),
    ("7.5", "-1E+4100", Floor, "0E-398", "xr...usc"),
    ("7.5", "-1E+4100", Ceiling, "1E-398", "xr...us."),
    ("7.5", "-1E+4100", Up, "1E-398", "xr...us."),
    ("7.5", "-1E+4100", Down, "0E-398", "xr...usc"),
    ("7.5", "-1E+400000", HalfEven, "0E-398", "xr...usc"),
    ("7.5", "-1E+400000", Floor, "0E-398", "xr...usc"),
    ("7.5", "-1E+400000", Ceiling, "1E-398", "xr...us."),
    ("7.5", "-1E+400000", Up, "1E-398", "xr...us."),
    ("7.5", "-1E+400000", Down, "0E-398", "xr...usc"),
    ("7.5", "1" + "0".repeat(4100), HalfEven, "inf", "xr..o..."),
    ("7.5", "1" + "0".repeat(4100), Floor, "9.999999999999999E+384", "xr..o..."),
    ("7.5", "1" + "0".repeat(4100), Ceiling, "inf", "xr..o..."),
    ("7.5", "1" + "0".repeat(4100), Up, "inf", "xr..o..."),
    ("7.5", "1" + "0".repeat(4100), Down, "9.999999999999999E+384", "xr..o..."),
    ("7.5", "3E+100000", HalfEven, "inf", "xr..o..."),
    ("7.5", "3E+100000", Floor, "9.999999999999999E+384", "xr..o..."),
    ("7.5", "3E+100000", Ceiling, "inf", "xr..o..."),
    ("7.5", "3E+100000", Up, "inf", "xr..o..."),
    ("7.5", "3E+100000", Down, "9.999999999999999E+384", "xr..o..."),
    ("7.5", "-7E+99999", HalfEven, "0E-398", "xr...usc"),
    ("7.5", "-7E+99999", Floor, "0E-398", "xr...usc"),
    ("7.5", "-7E+99999", Ceiling, "1E-398", "xr...us."),
    ("7.5", "-7E+99999", Up, "1E-398", "xr...us."),
    ("7.5", "-7E+99999", Down, "0E-398", "xr...usc"),
  ]
  for row in rows {
    let (base, exponent, mode, expected, expected_flags) = row
    let ctx = { ..context, decimal_rounding: mode, rounding: context.rounding, }
    let (value, flags) = Decimal::from_string(base)
      .unwrap()
      .power_ctx(Decimal::from_string(exponent).unwrap(), ctx)
    assert_eq(
      (base, exponent.length(), value.to_string(), issue196_flags(flags)),
      (base, exponent.length(), expected, expected_flags),
    )
  }
}
