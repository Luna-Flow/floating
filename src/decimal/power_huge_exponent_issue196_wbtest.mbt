///|
fn issue196_flags(flags : DecimalFlags) -> String {
  (if flags.inexact { "x" } else { "." }) +
  (if flags.rounded { "r" } else { "." }) +
  (if flags.invalid_operation { "i" } else { "." }) +
  (if flags.division_by_zero { "z" } else { "." }) +
  (if flags.overflow { "o" } else { "." }) +
  (if flags.underflow { "u" } else { "." }) +
  (if flags.subnormal { "s" } else { "." }) +
  (if flags.clamped { "c" } else { "." })
}

///|
/// IEEE 754-2019 §9.2: `pow(x, n)` for `|x| != 1` and an integral exponent with
/// more than 4,096 digits overflows or underflows (the sign follows the
/// parity, here always even), it is not an `invalid_context`. Decided from
/// `|n ln|x||` without exponent-sized work. Expected values: Python `decimal`
/// with Emax/Emin of decimal64 and traps off (cross-check only), in every
/// directed rounding mode that distinguishes the results.
test "integral exponents beyond 4096 digits overflow or underflow (#196)" {
  let context = DecimalContext::decimal64()
  let rows : Array[(String, String, DecimalRoundingMode, String, String)] = [
