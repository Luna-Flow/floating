    ),
    (
      113,
      RoundTiesToEven,
      "-1099511627776",
      "-0x20000000000000000000000000000p-113",
    ),
    (
      113,
      RoundTiesToAway,
      "-1099511627776",
      "-0x20000000000000000000000000000p-113",
    ),
    (
      113,
      RoundTowardZero,
      "-1099511627776",
      "-0x1ffffffffffffffffffffffffffffp-113",
    ),
    (
      113,
      RoundTowardPositive,
      "-1099511627776",
      "-0x1ffffffffffffffffffffffffffffp-113",
    ),
    (
      113,
      RoundTowardNegative,
      "-1099511627776",
      "-0x20000000000000000000000000000p-113",
    ),
    (
      113,
      RoundAwayFromZero,
      "-1099511627776",
      "-0x20000000000000000000000000000p-113",
    ),
  ]
  for row in rows {
    let (precision, mode, text, expected) = row
    let context = BinaryContext::unbounded(precision, rounding=mode)
    let x = BinFloat::from_string(text, precision=60).unwrap()
    let (value, flags) = x.try_tanh_ctx(context).unwrap()
    let want = BinFloat::from_hex(expected, precision).unwrap()
    assert_eq(
      (
        precision,
        text,
        value.compare(want),
        value.is_negative(),
        flags.inexact(),
      ),
      (precision, text, 0, expected.has_prefix("-"), true),
    )
  }
}
