///|
/// `tanh` of a finite argument beyond the saturation bound is `+-1` or the
/// adjacent value `+-(1 - 2^-p)` by the rounding direction, never NaN
/// (`try_tanh_ctx` used to return `Err` from about `2^30`). Expected values:
/// exact rational arithmetic in Python (`tanh x = (e^2x - 1) / (e^2x + 1)` with
/// 400-digit `exp`, correctly rounded to `p` bits by hand; for `|x| >= 300` the
/// value is `1 - tiny` and only the direction matters). Every row is inexact,
/// since `tanh` of a nonzero finite number is never representable. Arguments
/// are dyadic, so the decimal literals are exact.
test "tanh saturates to the correctly rounded value for large arguments (#185)" {
  let rows : Array[(Int32, BinaryRoundingMode, String, String)] = [
    (24, RoundTiesToEven, "19", "0x1000000p-24"),
    (24, RoundTiesToAway, "19", "0x1000000p-24"),
    (24, RoundTowardZero, "19", "0xffffffp-24"),
    (24, RoundTowardPositive, "19", "0x1000000p-24"),
    (24, RoundTowardNegative, "19", "0xffffffp-24"),
    (24, RoundAwayFromZero, "19", "0x1000000p-24"),
