// The rows of `interchange_rows_wbtest.mbt` (generated by
// tools/generate_interchange_rows.py, level A) run against the two entry points
// of the encoder: `Decimal::to_interchange_hex` and
// `DecimalInterchange::from_decimal`. Failures are returned as text, so that a
// test block states the table as its oracle and asserts that none is left.

///|
fn interchange_row_format(name : String) -> @decimal.DecimalInterchangeFormat {
  match name {
    "decimal32" => @decimal.DecimalInterchangeFormat::Decimal32
    "decimal64" => @decimal.DecimalInterchangeFormat::Decimal64
    "decimal128" => @decimal.DecimalInterchangeFormat::Decimal128
    _ => abort("unknown format " + name)
  }
}

///|
fn interchange_row_is_special(text : String) -> Bool {
  text.contains("NaN") || text.contains("Infinity")
}

///|
/// The rows of `special` (NaN, infinity) or of the finite values that the two
/// encoder entry points do not agree with the table on.
fn interchange_row_failures(special : Bool) -> Array[String] raise {
  let failures : Array[String] = []
  let mut rows = 0
  for row in interchange_rows() {
    let (text, name, expected, inexact, overflow, underflow) = row
    if interchange_row_is_special(text) != special {
      continue
    }
    rows += 1
    let format = interchange_row_format(name)
    let value = @decimal.Decimal::from_string(text, precision=100).unwrap()
    let (hex, flags) = value.to_interchange_hex(format)
    let (wrapped, wrapped_flags) = @decimal.DecimalInterchange::from_decimal(
      value, format,
    )
    let same_flags = fn(f : @decimal.DecimalFlags) {
      f.inexact() == inexact &&
      f.overflow() == overflow &&
      f.underflow() == underflow &&
      !f.invalid_operation()
    }
    if hex != expected ||
      wrapped.to_hex() != expected ||
      !(wrapped.format() == format) ||
      !same_flags(flags) ||
      !same_flags(wrapped_flags) {
      failures.push(
        "\{text} \{name}: expected \{expected} \{inexact} \{overflow} \{underflow}, got \{hex} \{wrapped.to_hex()} \{flags.inexact()} \{flags.overflow()} \{flags.underflow()}",
      )
    }
  }
  assert_true(rows > 0)
  failures
}
