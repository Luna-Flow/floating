///|
/// `decimal` and `decimal_gda`
/// agree on a zero `quantize` result under `clamp`: the exponent
/// asked for is folded down to `e_max - precision + 1` with `clamped` when it is
/// above it, and kept otherwise, and a target above `e_max` is invalid in both
/// (issue 234; `decimal_gda` folds since issue 419).

///|
let clamp_fold_contexts : Array[(String, Int32, Int32, Int32)] = [
  ("decimal32", 7, -95, 96),
  ("decimal64", 16, -383, 384),
  ("decimal128", 34, -6143, 6144),
  ("small", 5, -2, 3),
]

///|
fn clamp_fold_flags(f : @decimal.DecimalFlags) -> String {
  (if f.inexact() { "x" } else { "." }) +
  (if f.invalid_operation() { "i" } else { "." }) +
  (if f.overflow() { "o" } else { "." }) +
  (if f.underflow() { "u" } else { "." })
}

///|
fn clamp_fold_gda_flags(f : @decimal_gda.GdaFlags) -> String {
  (if f.inexact() { "x" } else { "." }) +
  (if f.invalid_operation() { "i" } else { "." }) +
  (if f.overflow() { "o" } else { "." }) +
  (if f.underflow() { "u" } else { "." })
}

///|
fn clamp_fold_text(is_nan : Bool, text : String) -> String {
  if is_nan {
    "NaN"
  } else {
    text
  }
}

///|
// oracle: A, S
// source: tooling/src/consistency/clamp_fold_rows_wbtest.mbt, generated by tools/generate_clamp_fold_rows.py
//   from CPython `decimal` (libmpdec, Context(prec, Emax, Emin, clamp=1).quantize): the expected text and the
//   signals x i o u c of each row, for both packages; the library does not run
// shares: Decimal::from_string for the operand and the quantum (input only)
test "decimal and decimal_gda agree on a zero quantize" {
  let mut count = 0
  for row in clamp_fold_rows {
    let (name, zero, target, expected, signals) = row
    let mut found = false
    for entry in clamp_fold_contexts {
      let (context_name, precision, e_min, e_max) = entry
      if context_name != name {
        continue
      }
      found = true
      let ieee = @decimal.DecimalContext::new(precision~, e_max~)
      let gda = @decimal_gda.GdaContext::new(
        precision~,
        e_min~,
        e_max~,
        clamp=true,
      )
      let quantum = "1E" +
        (if target < 0 { "" } else { "+" }) +
        target.to_string()
      let a = @decimal.Decimal::from_string(zero)
        .unwrap()
        .quantize_ctx(@decimal.Decimal::from_string(quantum).unwrap(), ieee)
      let b = @decimal_gda.quantize(
        @decimal_gda.Decimal::from_string(zero).unwrap(),
        @decimal_gda.Decimal::from_string(quantum).unwrap(),
        gda,
      )
      // the IEEE tier has no Clamped signal: its signals are compared without the fifth
      let a_text = clamp_fold_text(a.0.is_nan(), a.0.to_string())
      let a_flags = clamp_fold_flags(a.1)
      let b_text = clamp_fold_text(b.value().is_nan(), b.value().to_string())
      let b_flags = clamp_fold_gda_flags(b.raised()) +
        (if b.raised().clamped() { "c" } else { "." })
      if a_text != expected ||
        a_flags != signals[0:4].to_owned() ||
        b_text != expected ||
        b_flags != signals {
        count += 1
        if count <= 10 {
          println(
            "\{name} quantize \{zero} to \{target}: decimal \{a_text} \{a_flags}, decimal_gda \{b_text} \{b_flags}, expected \{expected} \{signals}",
          )
        }
      }
    }
    assert_true(found)
  }
  assert_eq(count, 0)
}
