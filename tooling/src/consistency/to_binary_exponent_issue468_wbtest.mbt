// Issue 468: `decimal_gda`'s `Decimal::to_binary` allocated gigabytes for an
// exponent of 10^7 or more. Its results, and those of `decimal`, at large
// exponents are checked against a table of `tools/generate_to_binary_large_rows.py`:
// rows at 10^6, 10^7, 3 x 10^7, 3 x 10^8 and at the overflow and underflow
// thresholds of the binary range, both signs, every rounding direction.

///|
fn large_rows_mode(name : String) -> @binary.BinaryRoundingMode {
  match name {
    "ToNearestEven" => @binary.BinaryRoundingMode::RoundTiesToEven
    "ToNearestAway" => @binary.BinaryRoundingMode::RoundTiesToAway
    "TowardZero" => @binary.BinaryRoundingMode::RoundTowardZero
    "TowardPositive" => @binary.BinaryRoundingMode::RoundTowardPositive
    "TowardNegative" => @binary.BinaryRoundingMode::RoundTowardNegative
    _ => abort("unknown rounding direction " + name)
  }
}

///|
/// The text of a result: `inf`, `-inf`, `0`, `-0` or `<signed odd C>p<k>`.
fn large_rows_text(value : @binary.Binary) -> String {
  let sign = if value.is_sign_minus() { "-" } else { "" }
  if value.is_infinite() {
    sign + "inf"
  } else if value.is_zero() {
    sign + "0"
  } else {
    sign + value.coefficient().to_string() + "p" + value.exponent2().to_string()
  }
}

///|
// oracle: A
// source: tooling/src/consistency/to_binary_large_rows_wbtest.mbt, generated by
//   tools/generate_to_binary_large_rows.py from Python integers (5^|e| enclosed
//   by two 640-bit integers, the IEEE 754-2019 rounding of the enclosure; the
//   library does not run); decimal and decimal_gda both against the table
// shares: Decimal::make and the Binary accessors (class, sign, coefficient, exponent2) that print the result
test "issue 468: decimal_gda to_binary agrees with decimal at large exponents" {
  let mut count = 0
  for row in to_binary_large_rows() {
    let (text, precision, mode, expected) = row
    let negative = text.has_prefix("-")
    let body = if negative { text[1:] } else { text[:] }
    let parts = body.split("E").to_array()
    let c = bigint_from_text(parts[0])
    let e = @string.parse_int(parts[1]) catch { _ => abort("bad exponent") }
    let signed = if negative { -c } else { c }
    let ieee = @decimal.Decimal::make(signed, e, 34)
    let gda = @decimal_gda.Decimal::make(signed, e, 34)
    let m = large_rows_mode(mode)
    let a = large_rows_text(ieee.to_binary(precision~, mode=m))
    let b = large_rows_text(gda.to_binary(precision~, mode=m))
    if a != expected || b != expected {
      count += 1
      if count <= 10 {
        println(
          "row \{text} p=\{precision} \{mode}: decimal \{a}, decimal_gda \{b}, expected \{expected}",
        )
      }
    }
  }
  assert_eq(count, 0)
}
