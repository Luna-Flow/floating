import {
  "Luna-Flow/floating-tools/bench" @benchkit,
  "Luna-Flow/floating/binary",
  "Luna-Flow/floating/decimal_gda" @gda,
  "Luna-Flow/mare_mark/env_detect",
  "Luna-Flow/mare_mark/event",
  "Luna-Flow/mare_mark/model",
  "Luna-Flow/mare_mark/runner",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x/fs",
} for "test"

// The async test reads the files and the environment variables of the
// external-baseline runner (tools/external_baseline.py). It builds and runs on
// native, wasm (under `moonrun`) and js (under node), which is how the runner
// measures the floating side on those runtimes (`--target`). It is not built for
// wasm-gc: the module initialiser of the `moonbitlang/async` dependency casts
// between two struct types and is rejected by the runtime at validation, which
// would fail the wasm-gc test stage.

warnings = "-unused_package"

options(
  targets: { "external_async_test.mbt": [ "native", "wasm", "js" ] },
)
