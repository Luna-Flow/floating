-- Regression rows for decimal disagreements found by the random differential
-- campaign. Expected results and conditions: Python decimal (libmpdec); each
-- row is annotated with the finding it reproduces (`xfail #<issue>`).
-- The smoke run requires exactly the xfail rows to fail.
version: 2.62
extended: 1
-- regression #264 F1 (fixed)
precision: 1
rounding: half_even
maxexponent: 0
minexponent: 0
clamp: 0
reg.add.overflow-operand-rounds add 9.5 -0.5 -> 9 Rounded
-- regression #264 F1 (fixed)
precision: 1
rounding: half_even
maxexponent: 0
minexponent: 0
clamp: 0
reg.subtract.overflow-operand-rounds subtract -9.5 -0.5 -> -9 Rounded
-- regression #264 F1 (fixed)
precision: 2
rounding: half_even
maxexponent: 0
minexponent: 0
clamp: 0
reg.add.overflow-operand-rounds-p2 add 9.99 -0.07 -> 9.9 Inexact Rounded
-- regression #264 F1 (fixed)
precision: 1
rounding: up
maxexponent: 0
minexponent: 0
clamp: 0
reg.add.overflow-operand-rounds-up add 0.1 -9.1 -> -9 Rounded
-- regression #264 F1 (fixed)
precision: 5
rounding: up
maxexponent: 18
minexponent: -18
clamp: 0
