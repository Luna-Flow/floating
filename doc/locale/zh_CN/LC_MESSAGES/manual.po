msgstr "NaN 操作数：安静 NaN，信号 NaN 则 `invalid`；最先调用"

#: manual/design/bin_float.md:514
msgid "$\\pm\\infty$ with `divideByZero`"
msgstr "带 `divideByZero` 的 $\\pm\\infty$"

#: manual/design/bin_float.md:515
msgid "an integer result rounded as a dyadic"
msgstr "作为二进有理数舍入的整数结果"

