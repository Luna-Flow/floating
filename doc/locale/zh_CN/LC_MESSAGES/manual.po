msgstr "`external/decimal_gda/OP`，OP 为 `add`、`mul`、`div`、`sqrt`、`exp`、`ln`"

#: manual/api/bench/external.md:42
msgid "16, 34, 100, 1000 digits"
msgstr "16、34、100、1000 位十进制数字"

