msgstr "变量"

#: manual/api/bench/external.md:60
msgid "operand file (required)"
msgstr "操作数文件（必需）"

#: manual/api/bench/external.md:61
msgid "MPFR/libmpdec reference results, the oracle"
msgstr "MPFR/libmpdec 的参考结果，即预言机"

#: manual/api/bench/external.md:62
msgid "comma-separated `kind/op/size`, in measurement order"
msgstr "以逗号分隔的 `kind/op/size`，按测量顺序排列"

#: manual/api/bench/external.md:63
msgid "Maremark seed and the round number copied to the log"
msgstr "Maremark 种子，以及复制到日志中的轮次编号"

#: manual/api/bench/external.md:64
