msgstr "无效（`invalid_operation`）"

#: manual/api/decimal.md:1490
msgid "Pole (`division_by_zero`)"
msgstr "极点（`division_by_zero`）"

#: manual/api/decimal.md:1490
msgid "Exact cases"
msgstr "精确情形"

#: manual/api/decimal.md:1492
#: manual/api/decimal.md:1493
#: manual/api/decimal.md:1496
#: manual/api/decimal.md:1498
#: manual/api/decimal.md:1499
