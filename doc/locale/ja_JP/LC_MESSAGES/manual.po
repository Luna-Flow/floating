msgid "`mul_ctx(0, inf)`, `mul_ctx(inf, 0)`, signs arbitrary"
msgstr "`mul_ctx(0, inf)`、`mul_ctx(inf, 0)`、符号は任意"

#: manual/design/bin_float_checked.md:180
msgid "7.2 b)"
msgstr "7.2 b)"

#: manual/design/bin_float_checked.md:181
#: manual/design/bin_float_checked.md:182
