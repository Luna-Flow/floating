#: manual/api/frontend/itl_expr.md:118
msgid "overlap"
msgstr "重なり"

#: manual/api/frontend/itl_expr.md:118
msgid "an overlap state name (`before`, `meets`, `overlaps`, `starts`, `containedBy`, `finishes`, `equals`, `after`, `metBy`, `overlappedBy`, `startedBy`, `contains`, `finishedBy`, `bothEmpty`, `firstEmpty`, `secondEmpty`, `undefined`)"
msgstr "重なり状態の名前（`before`、`meets`、`overlaps`、`starts`、`containedBy`、`finishes`、`equals`、`after`、`metBy`、`overlappedBy`、`startedBy`、`contains`、`finishedBy`、`bothEmpty`、`firstEmpty`、`secondEmpty`、`undefined`）"

#: manual/api/frontend/itl_expr.md:118
msgid "equal names"
msgstr "名前が等しい"

#: manual/api/frontend/itl_expr.md:119
msgid "numeric"
msgstr "数値"

#: manual/api/frontend/itl_expr.md:119
msgid "a bound"
msgstr "端点"

#: manual/api/frontend/itl_expr.md:119
msgid "equal numbers"
msgstr "数が等しい"

#: manual/api/frontend/itl_expr.md:120
msgid "unary"
msgstr "単項"

#: manual/api/frontend/itl_expr.md:120
#: manual/api/frontend/itl_expr.md:121
#: manual/api/frontend/itl_expr.md:122
#: manual/api/frontend/itl_expr.md:123
