msgstr ""

#: manual/api/bin_float_checked.md:460
msgid "Errors: a `DomainError` below $-1$; $\\operatorname{log1p}(-1) = -\\infty$."
msgstr ""

#: manual/api/bin_float_checked.md:464
msgid "$\\log_2 x$, delegated to [`BinFloat::try_log2_ctx`](bin_float.md#binfloatlog2-binfloatlog2_ctx-binfloattry_log2_ctx)."
msgstr ""

#: manual/api/bin_float_checked.md:471
msgid "Errors: a `DomainError` for a negative finite argument; $\\log_2 0 = -\\infty$."
msgstr ""

#: manual/api/bin_float_checked.md:475
msgid "$\\log_{10} x$, delegated to [`BinFloat::try_log10_ctx`](bin_float.md#binfloatlog10-binfloatlog10_ctx-binfloattry_log10_ctx)."
msgstr ""

#: manual/api/bin_float_checked.md:482
msgid "Errors: a `DomainError` for a negative finite argument; $\\log_{10} 0 = -\\infty$."
msgstr ""

#: manual/api/bin_float_checked.md:486
