msgid "4 (the coefficient product of a finite pair is shared by both directions)"
msgstr ""

#: manual/design/interval.md:365
msgid "`pown`, even exponent, negative or zero-containing interval"
msgstr ""

#: manual/design/interval.md:365
msgid "4 or 3 `pown_ctx`"
msgstr ""

