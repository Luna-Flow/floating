msgid "The format is chosen from the file content:"
msgstr ""

#: manual/api/cli/mpfr_expr_cli.md:46
msgid "Content contains"
msgstr ""

#: manual/api/cli/mpfr_expr_cli.md:46
msgid "Parser and executor"
msgstr ""

#: manual/api/cli/mpfr_expr_cli.md:46
